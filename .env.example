# WhatsApp contact number (digits only, with country code)
# Example: 34680265190 for Spain (+34 680 265 190)
PUBLIC_WHATSAPP_NUMBER=34680265190

# Site URL (used for SEO / sitemap)
PUBLIC_SITE_URL=https://restorelab.io

# Tracking IDs
PUBLIC_GTM_ID=GTM-W34GRX86
PUBLIC_CLARITY_ID=vmc619bvp9
PUBLIC_META_PIXEL_ID=1556029059322810

# ── WhatsApp ref-code attribution (RL-301) — server-side only ────────────────
# These are NOT build-time vars: configure them in the Cloudflare Pages
# dashboard, not in .env. Setup steps: docs/ads-measurement.md.
#
# REF_LOG — KV namespace BINDING (not an env var): create a KV namespace and
#   bind it as "REF_LOG" under Pages → Settings → Functions → KV bindings.
#   Without it, POST /api/ref is a harmless no-op.
#
# REF_ADMIN_TOKEN — long random secret guarding GET /api/ref lookups
#   (wrong/missing token → 404). Generate with: openssl rand -hex 32
# REF_ADMIN_TOKEN=

# ── Orders OS (RL-410) — server-side only ────────────────────────────────────
# Configure in the Cloudflare Pages dashboard, not in .env.
# Full setup steps: docs/setup-cloudflare-bindings.md.
#
# ORDERS_DB — D1 database BINDING (not an env var): create with
#   `wrangler d1 create restorelab-orders`, bind as "ORDERS_DB" under
#   Pages → Settings → Functions → D1 database bindings.
#   Without it every /api/orders endpoint is a harmless no-op.
#
# PHOTOS — R2 bucket BINDING: create bucket "restorelab-photos", bind as
#   "PHOTOS" under Pages → Settings → Functions → R2 bucket bindings.
#
# ADMIN_TOKEN — long random secret guarding the admin API (orders list/detail/
#   PATCH, /api/admin/migrate). Wrong/missing token → 404.
#   Generate with: openssl rand -hex 32
# ADMIN_TOKEN=
