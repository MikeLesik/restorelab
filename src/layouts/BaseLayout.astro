---
import '@/styles/global.css';
// Hashed URLs of the two above-the-fold font files (same assets the CSS
// references) — preloaded so text paints in the right font without waiting
// for the render-blocking CSS to be parsed first.
import dmSansWoff2 from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import spaceGroteskWoff2 from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import StickyCTA from '@/components/StickyCTA.astro';
import PreFooterCTA from '@/components/PreFooterCTA.astro';
import { WHATSAPP_NUMBER, SITE_URL } from '@/lib/constants';

export interface Props {
  title: string;
  description: string;
  lang: string;
  ogImage?: string;
  canonicalURL?: string;
  t: Record<string, any>;
  currentPath?: string;
  /** Languages this page actually exists in — controls hreflang + language switcher. */
  availableLangs?: string[];
}

const {
  title,
  description,
  lang,
  ogImage = '/images/og-home.jpg',
  canonicalURL,
  t,
  currentPath = '',
  availableLangs = ['en', 'es', 'ca'],
} = Astro.props;

const siteUrl = SITE_URL;
// With build.format:'file', Astro.url.pathname ends in ".html" (or "/index.html"
// for the root) — strip it so canonical/OG URLs stay extensionless.
const cleanPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = canonicalURL || `${siteUrl}${cleanPath}`;

// Fallbacks mirror constants.ts: these IDs are public (embedded in client HTML
// by design), and the Cloudflare Pages build has no .env — without defaults the
// consent-gated loaders silently no-op in production for every visitor.
const gtmId = import.meta.env.PUBLIC_GTM_ID || 'GTM-W34GRX86';
const clarityId = import.meta.env.PUBLIC_CLARITY_ID || 'vmc619bvp9';
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID || '1556029059322810';

// CookieConsent copy per language. Lives in frontmatter (server-only) so only the
// active language is inlined into the page via define:vars — not all three.
const ccI18n = {
              en: {
                consentModal: {
                  footer: '<a href="/en/cookies">Cookie Policy</a> · <a href="/en/legal">Legal notice</a>',
                  title: 'We use cookies',
                  description: 'We use cookies to improve your experience, analyse traffic and show relevant ads. Choose which categories to allow.',
                  acceptAllBtn: 'Accept all',
                  acceptNecessaryBtn: 'Necessary only',
                  showPreferencesBtn: 'Manage preferences'
                },
                preferencesModal: {
                  title: 'Cookie preferences',
                  acceptAllBtn: 'Accept all',
                  acceptNecessaryBtn: 'Necessary only',
                  savePreferencesBtn: 'Save preferences',
                  closeIconLabel: 'Close',
                  sections: [
                    { title: 'Strictly necessary', description: 'Required for the website to function correctly. Cannot be disabled.', linkedCategory: 'necessary' },
                    { title: 'Analytics', description: 'Help us understand how visitors interact with the site (Google Tag Manager, Microsoft Clarity).', linkedCategory: 'analytics' },
                    { title: 'Marketing', description: 'Used to show you personalised ads based on your interests (Meta Pixel / Facebook).', linkedCategory: 'marketing' }
                  ]
                }
              },
              es: {
                consentModal: {
                  footer: '<a href="/es/cookies">Política de cookies</a> · <a href="/es/legal">Aviso legal</a>',
                  title: 'Usamos cookies',
                  description: 'Usamos cookies para mejorar tu experiencia, analizar el tráfico y mostrarte anuncios relevantes.',
                  acceptAllBtn: 'Aceptar todo',
                  acceptNecessaryBtn: 'Solo necesarias',
                  showPreferencesBtn: 'Gestionar preferencias'
                },
                preferencesModal: {
                  title: 'Preferencias de cookies',
                  acceptAllBtn: 'Aceptar todo',
                  acceptNecessaryBtn: 'Solo necesarias',
                  savePreferencesBtn: 'Guardar preferencias',
                  closeIconLabel: 'Cerrar',
                  sections: [
                    { title: 'Estrictamente necesarias', description: 'Necesarias para el funcionamiento del sitio. No pueden desactivarse.', linkedCategory: 'necessary' },
                    { title: 'Analíticas', description: 'Nos ayudan a entender cómo interactúan los visitantes con el sitio (Google Tag Manager, Microsoft Clarity).', linkedCategory: 'analytics' },
                    { title: 'Marketing', description: 'Se usan para mostrarte anuncios personalizados según tus intereses (Meta Pixel / Facebook).', linkedCategory: 'marketing' }
                  ]
                }
              },
              ca: {
                consentModal: {
                  footer: '<a href="/ca/cookies">Política de cookies</a> · <a href="/ca/legal">Avís legal</a>',
                  title: 'Utilitzem galetes',
                  description: 'Utilitzem galetes per millorar la teva experiència, analitzar el trànsit i mostrar-te anuncis rellevants.',
                  acceptAllBtn: 'Acceptar tot',
                  acceptNecessaryBtn: 'Només necessàries',
                  showPreferencesBtn: 'Gestionar preferències'
                },
                preferencesModal: {
                  title: 'Preferències de galetes',
                  acceptAllBtn: 'Acceptar tot',
                  acceptNecessaryBtn: 'Només necessàries',
                  savePreferencesBtn: 'Desar preferències',
                  closeIconLabel: 'Tancar',
                  sections: [
                    { title: 'Estrictament necessàries', description: 'Necessàries per al funcionament del lloc. No es poden desactivar.', linkedCategory: 'necessary' },
                    { title: 'Analítiques', description: 'Ens ajuden a entendre com interactuen els visitants amb el lloc (Google Tag Manager, Microsoft Clarity).', linkedCategory: 'analytics' },
                    { title: 'Màrqueting', description: "S'utilitzen per mostrar-te anuncis personalitzats segons els teus interessos (Meta Pixel / Facebook).", linkedCategory: 'marketing' }
                  ]
                }
              },
};
const ccTranslation = ccI18n[lang as keyof typeof ccI18n] || ccI18n.es;
---

<!doctype html>
<html lang={lang} class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0A0A0A" />

    <!-- Theme init: prevent FOUC by applying stored preference before render -->
    <script is:inline>
      (function(){
        function applyTheme(isDark) {
          document.documentElement.classList.toggle('dark', isDark);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', isDark ? '#0A0A0A' : '#FFFFFF');
        }

        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        applyTheme(stored ? stored === 'dark' : prefersDark);

        // React to OS theme changes in real-time (when no manual override)
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
          if (!localStorage.getItem('theme')) {
            applyTheme(e.matches);
            // Sync CookieConsent
            document.documentElement.classList.toggle('cc--darkmode', e.matches);
            // Sync toggle icons
            document.querySelectorAll('.theme-icon-sun').forEach(function(el) { el.classList.toggle('hidden', !e.matches); });
            document.querySelectorAll('.theme-icon-moon').forEach(function(el) { el.classList.toggle('hidden', e.matches); });
          }
        });
      })();
    </script>

    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content="0fYdZyt-ipgrVVu6-tcvbXLN4BXYnWayt_5LsOfD8T0" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : lang === 'ca' ? 'ca_ES' : 'es_ES'} />
    <meta property="og:site_name" content="restoreLab" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- hreflang — only for languages this page actually exists in -->
    {availableLangs.map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={`${siteUrl}/${l}${currentPath}`}
      />
    ))}
    {availableLangs.includes('es') && (
      <link rel="alternate" hreflang="x-default" href={`${siteUrl}/es${currentPath}`} />
    )}

    <!-- Preconnect hints for external domains -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <link rel="dns-prefetch" href="https://connect.facebook.net" />

    <!-- CookieConsent v3 CSS — self-hosted (non-render-blocking) -->
    <link
      rel="stylesheet"
      href="/vendor/cookieconsent.css"
      media="print"
      onload="this.media='all'"
    />

    <!-- dataLayer init (must be before GTM) -->
    <script>(window as any).dataLayer = (window as any).dataLayer || [];</script>

    <!-- Font preload (LCP text paints without FOUT) -->
    <link rel="preload" as="font" type="font/woff2" href={dmSansWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={spaceGroteskWoff2} crossorigin />

    <!-- Favicon & PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    {/* Chrome's omnibox and history, bookmark bars, link-preview scrapers and a
        long tail of readers request /favicon.ico at the root by convention and
        ignore these tags entirely. It used to 404, so those surfaces drew the
        generic page glyph. Declared as well as shipped, so the size hint is
        explicit; SVG still wins where it is supported. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- AutomotiveBusiness Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AutomotiveBusiness",
      "name": "restoreLab",
      "legalName": "Mikhail Lesik",
      "description": "Premium mobile surface restoration — car paint correction, ceramic coating, glass polishing and acrylic restoration in Barcelona metro area.",
      "url": siteUrl,
      "image": `${siteUrl}/images/og-home.jpg`,
      "telephone": `+${WHATSAPP_NUMBER}`,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Sant Cugat del Vallès",
        "addressRegion": "Catalonia",
        "postalCode": "08195",
        "addressCountry": "ES"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 41.4736,
        "longitude": 2.0868
      },
      "areaServed": [
        "Sant Cugat del Vallès", "Barcelona", "Terrassa", "Sabadell",
        "Rubí", "Cerdanyola del Vallès", "Matadepera", "Sant Just Desvern", "Castelldefels",
        "Sant Boi de Llobregat"
      ],
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
        "opens": "08:00",
        "closes": "19:00"
      },
      "priceRange": "€€€",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "restoreLab Services",
        "itemListElement": (t.pricing?.categories || []).map((category: any) => ({
          "@type": "OfferCatalog",
          "name": category.title,
          "itemListElement": category.packages
            .map((pkg: any) => {
              const priceMatch = String(pkg.price || '').replace(/\s/g, '').match(/(\d+)/);
              return priceMatch ? {
                "@type": "Offer",
                "itemOffered": { "@type": "Service", "name": pkg.name },
                "price": priceMatch[1],
                "priceCurrency": "EUR"
              } : null;
            })
            .filter(Boolean)
        }))
      }
    })} />

    <!-- Organization Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "restoreLab",
      "legalName": "Mikhail Lesik",
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/icon-512.png`,
        "width": 512,
        "height": 512
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": `+${WHATSAPP_NUMBER}`,
        "contactType": "customer service",
        "availableLanguage": ["Spanish", "English", "Catalan"]
      }
    })} />
  </head>
  <body class="bg-brand-dark">
    <!-- Shared WhatsApp glyph — referenced via <use href="#icon-whatsapp"> -->
    <svg width="0" height="0" class="hidden" aria-hidden="true"><symbol id="icon-whatsapp" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></symbol></svg>
    <Header t={t} lang={lang} currentPath={currentPath} availableLangs={availableLangs} />
    <main class="pb-24 md:pb-0">
      <slot />
    </main>
    {/* Suppressed where the page already ends with its own closing CTA. /contact
        is the form. The four verticals each close with a bespoke, vertical-
        specific CTA section (EV / fleet / plans / commercial glass) that is more
        relevant than this generic ask and carries an email option — stacking the
        generic block after it, then StickyCTA on mobile, was three asks in two
        screens. */}
    {!['/contact', '/ev', '/plans', '/business', '/commercial-glass'].includes(currentPath) && <PreFooterCTA t={t} lang={lang} />}
    <Footer t={t} lang={lang} />
    {/* Suppressed where the page already puts a full-width green WhatsApp button
        in the same viewport — two identical CTAs a thumb's width apart is the
        highest-cost mis-tap on the site. The homepage keeps it: the estimator is
        one of ten sections there and is usually off-screen. */}
    {!['/contact', '/pricing'].includes(currentPath) && <StickyCTA label={t.hero.sticky_cta} t={t} />}

    <!-- ── Brand name styling: "Lab" in accent color ── -->
    <script is:inline>
      (function(){
        // Never touch text inside these elements — rewriting a JSON-LD script's
        // text node corrupts structured data for Google's renderer.
        var SKIP = { SCRIPT: 1, STYLE: 1, NOSCRIPT: 1, TEXTAREA: 1 };
        var nodes = [];
        function collect(root) {
          if (!root) return;
          var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
            acceptNode: function(n) {
              return n.parentNode && SKIP[n.parentNode.nodeName]
                ? NodeFilter.FILTER_REJECT
                : NodeFilter.FILTER_ACCEPT;
            }
          });
          while (walker.nextNode()) {
            if (walker.currentNode.nodeValue && walker.currentNode.nodeValue.indexOf('restoreLab') !== -1) {
              nodes.push(walker.currentNode);
            }
          }
        }
        collect(document.querySelector('main') || document.body);
        collect(document.querySelector('footer'));
        nodes.forEach(function(node) {
          var span = document.createElement('span');
          var esc = node.nodeValue.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          span.innerHTML = esc.replace(/restoreLab/g, 'restore<span class="text-brand-accent font-semibold">Lab</span>');
          node.parentNode.replaceChild(span, node);
        });
      })();
    </script>

    <!-- ── Tracking: GTM + Clarity + Meta Pixel + Cookie Consent ── -->
    <script define:vars={{ pageLang: lang, gtmId, clarityId, metaPixelId, ccTranslation, internalCopy: { off: t.ui.analytics_off, on: t.ui.analytics_on } }}>
      // ── Internal-traffic opt-out ────────────────────────────────────────────
      // Owner/staff devices skip tracking entirely. Flagged per DEVICE, not per
      // IP: the phone browses over cellular, where IP filters never match.
      // Visit any page with ?internal=1 to flag this device, ?internal=0 to undo.

      function isInternalDevice() {
        try { return localStorage.getItem('rl_internal') === '1'; } catch (e) { return false; }
      }

      (function applyInternalFlag() {
        var flag;
        try { flag = new URLSearchParams(window.location.search).get('internal'); } catch (e) { return; }
        if (flag !== '1' && flag !== '0') return;
        try {
          if (flag === '1') localStorage.setItem('rl_internal', '1');
          else localStorage.removeItem('rl_internal');
        } catch (e) { return; }

        // Confirm visually — the phone has no console to check.
        window.addEventListener('DOMContentLoaded', function() {
          var toast = document.createElement('div');
          toast.textContent = flag === '1' ? internalCopy.off : internalCopy.on;
          toast.setAttribute('role', 'status');
          toast.className = 'fixed bottom-28 left-1/2 -translate-x-1/2 z-[9999] max-w-[90vw] text-center rounded-full px-4 py-2 text-sm font-medium bg-brand-navy text-brand-white shadow-lg';
          document.body.appendChild(toast);
          setTimeout(function() { toast.remove(); }, 6000);
        });
      })();

      // ── Attribution: first touch + visitor ref code (RL-301) ───────────────
      // Schema + rationale documented in src/lib/attribution.ts. The ref is a
      // first-party functional identifier, so it exists pre-consent; ad click
      // ids (gclid/fbclid/msclkid) are held in memory and only persisted once
      // marketing consent is granted — same split the Pixel/CAPI loaders use.

      var RL_UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
      var RL_CLICK_ID_KEYS = ['gclid', 'fbclid', 'msclkid'];
      var rlPendingClickIds = {};
      var rlThisLoadIsFirstTouch = false;

      function rlReadAttr() {
        try { return JSON.parse(localStorage.getItem('rl_attr')) || {}; } catch (e) { return {}; }
      }
      function rlWriteAttr(a) {
        try { localStorage.setItem('rl_attr', JSON.stringify(a)); } catch (e) {}
      }
      function rlMakeRef() {
        // [A-HJ-NP-Z2-9]: no I/O/0/1, so the code survives handwriting and
        // WhatsApp font ambiguity.
        var alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
        var code = '';
        var rnd = new Uint8Array(4);
        if (window.crypto && crypto.getRandomValues) crypto.getRandomValues(rnd);
        else for (var i = 0; i < 4; i++) rnd[i] = Math.floor(Math.random() * 256);
        for (var j = 0; j < 4; j++) code += alphabet[rnd[j] % alphabet.length];
        return 'RL-' + code;
      }
      function rlMarketingConsent() {
        var cc = window.CookieConsent;
        return !!(cc && typeof cc.acceptedCategory === 'function' && cc.acceptedCategory('marketing'));
      }
      // Called from the CookieConsent callbacks: click ids captured on this
      // page load land in storage only after marketing consent.
      function rlPersistClickIds() {
        if (!rlMarketingConsent()) return;
        var keys = Object.keys(rlPendingClickIds);
        if (!keys.length) return;
        var a = rlReadAttr();
        keys.forEach(function (k) {
          if (a.last) a.last[k] = rlPendingClickIds[k];
          if (rlThisLoadIsFirstTouch && a.first) a.first[k] = rlPendingClickIds[k];
        });
        rlPendingClickIds = {};
        rlWriteAttr(a);
      }

      (function initAttribution() {
        var params = null;
        try { params = new URLSearchParams(location.search); } catch (e) {}
        var touch = { landing: location.pathname, ts: new Date().toISOString() };
        var tagged = false;
        RL_UTM_KEYS.forEach(function (k) {
          var v = params && params.get(k);
          if (v) { touch[k] = v.slice(0, 200); tagged = true; }
        });
        RL_CLICK_ID_KEYS.forEach(function (k) {
          var v = params && params.get(k);
          if (v) { rlPendingClickIds[k] = v.slice(0, 200); tagged = true; }
        });
        var a = rlReadAttr();
        if (!a.ref) a.ref = rlMakeRef();
        if (!a.first) { a.first = touch; rlThisLoadIsFirstTouch = true; }
        if (tagged) a.last = touch;
        rlWriteAttr(a);
      })();

      // Fields stamped onto contact-intent events by __rl_push.
      function rlAttrFields() {
        var a = rlReadAttr();
        var f = a.first || {};
        return {
          ref: a.ref || '',
          attr_source: f.utm_source || '(direct)',
          attr_campaign: f.utm_campaign || '',
          attr_landing: f.landing || '',
        };
      }

      // Append "#ref RL-XXXX" to a wa.me prefill so the WhatsApp conversation
      // carries the visitor's attribution code. Idempotent; all site wa.me
      // links are `…?text=<encoded>` with text as the last param.
      function rlWithRef(href) {
        var a = rlReadAttr();
        if (!a.ref || !href || href.indexOf('wa.me') === -1) return href;
        var tag = encodeURIComponent('#ref ' + a.ref);
        if (href.indexOf(tag) !== -1) return href;
        if (/[?&]text=/.test(href)) {
          return href.replace(/([?&]text=[^&#]*)/, '$1' + encodeURIComponent('\n\n') + tag);
        }
        return href + (href.indexOf('?') === -1 ? '?' : '&') + 'text=' + tag;
      }

      // ── Loaders (called after consent) ──────────────────────────────────────

      function loadGTM() {
        if (!gtmId || window.__gtmLoaded || isInternalDevice()) return;
        window.__gtmLoaded = true;
        (function(w,d,s,l,i){
          w[l]=w[l]||[];
          w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
          var f=d.getElementsByTagName(s)[0],
              j=d.createElement(s),
              dl=l!='dataLayer'?'&l='+l:'';
          j.async=true;
          j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
          f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
        // GTM noscript fallback
        var ns=document.createElement('noscript');
        var iframe=document.createElement('iframe');
        iframe.src='https://www.googletagmanager.com/ns.html?id='+gtmId;
        iframe.height='0'; iframe.width='0';
        iframe.style.cssText='display:none;visibility:hidden';
        ns.appendChild(iframe);
        document.body.insertAdjacentElement('afterbegin',ns);
      }

      function loadClarity() {
        if (!clarityId || window.__clarityLoaded || isInternalDevice()) return;
        window.__clarityLoaded = true;
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r); t.async=1;
          t.src='https://www.clarity.ms/tag/'+i;
          y=l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t,y);
        })(window,document,'clarity','script',clarityId);
      }

      function loadMetaPixel() {
        if (!metaPixelId || window.__pixelLoaded || isInternalDevice()) return;
        window.__pixelLoaded = true;
        !function(f,b,e,v,n,t,s){
          if(f.fbq)return;
          n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n; n.push=n; n.loaded=!0; n.version='2.0';
          n.queue=[]; t=b.createElement(e); t.async=!0; t.src=v;
          s=b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t,s);
        }(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init',metaPixelId);
        fbq('track','PageView');
      }

      // ── Conversion event delegation ──────────────────────────────────────────
      // Unified pushEvent: GTM dataLayer + Clarity custom event + Meta Pixel
      // See src/lib/analytics.ts for TypeScript types

      window.__rl_push = function(payload) {
        if (isInternalDevice()) return;

        // Consent, split by destination: the analytics category gates GA/GTM +
        // Clarity; the marketing category gates the Meta Pixel + Conversions API
        // (advertising data). They are independent — granting one must not leak
        // into the other.
        var cc = window.CookieConsent;
        var hasCat = cc && typeof cc.acceptedCategory === 'function';
        var analyticsOk = !cc || (hasCat && cc.acceptedCategory('analytics'));
        var marketingOk = hasCat && cc.acceptedCategory('marketing');
        if (!analyticsOk && !marketingOk) return;

        // ── Attribution enrichment (RL-301) ──
        // Contact-intent events carry the visitor ref + first-touch source so
        // GTM/Ads can attribute the WhatsApp conversation to the click. Like
        // the Lead mapping below, contact intent is derived from the link's
        // href too — descriptive data-event slugs (estimator_wa, b2b_hero_wa…)
        // must not fall through the name-based net.
        var rlClickUrl = (payload.click_url || '').toLowerCase();
        var rlIsContactClick = rlClickUrl.indexOf('wa.me') !== -1
          || rlClickUrl.indexOf('whatsapp.com') !== -1
          || rlClickUrl.indexOf('tel:') === 0;
        var RL_ENRICH = { wa_click: 1, phone_click: 1, lead_submitted: 1, b2b_inquiry: 1, commercial_glass_inquiry: 1, estimator_result: 1 };
        if (RL_ENRICH[payload.event] || rlIsContactClick) {
          var af = rlAttrFields();
          payload.ref = af.ref;
          payload.attr_source = af.attr_source;
          payload.attr_campaign = af.attr_campaign;
          payload.attr_landing = af.attr_landing;
        }

        // ── Server-side ref log (RL-301) ──
        // Fire-and-forget copy of the contact moment into Cloudflare KV, so
        // `#ref RL-XXXX` seen in WhatsApp can be looked up via /api/ref even
        // weeks later. No-op server-side until the REF_LOG binding exists.
        var RL_REF_LOG = { wa_click: 1, phone_click: 1, lead_submitted: 1 };
        if ((RL_REF_LOG[payload.event] || rlIsContactClick) && payload.ref) {
          try {
            fetch('/api/ref', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              keepalive: true,
              body: JSON.stringify({
                ref: payload.ref,
                attr: rlReadAttr(),
                page: location.pathname,
                event: payload.event,
                ts: new Date().toISOString(),
              }),
            }).catch(function () {});
          } catch (e) {}
        }

        // Shared event id so the server-side Conversions API (CAPI) copy is
        // de-duplicated against this browser Pixel event — Meta matches on eventID.
        var eventID = (window.crypto && crypto.randomUUID)
          ? crypto.randomUUID()
          : (Date.now() + '-' + Math.random().toString(16).slice(2));
        payload.event_id = eventID;

        // ── Analytics destinations (analytics consent) ──
        if (analyticsOk) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(payload);
          if (typeof window.clarity === 'function') window.clarity('event', payload.event);
        }

        // ── Map to a Meta standard event ──
        // A "lead" is any tap-to-contact: WhatsApp, phone or email. It is derived
        // from the link's href so EVERY contact CTA counts as a Lead regardless of
        // its descriptive data-event slug (estimator_wa, ev_cta_wa, contact_phone,
        // plans_cta_wa, b2b_hero_wa, comglass_cta_wa …). Non-link events fall back
        // to event-name mapping. This is the single place a Lead is defined.
        var eid = { eventID: eventID };
        var url = (payload.click_url || '').toLowerCase();
        var metaEvent = null, metaParams = null, capiCat = null;
        if (url.indexOf('wa.me') !== -1 || url.indexOf('whatsapp.com') !== -1) {
          metaEvent = 'Lead'; capiCat = 'whatsapp';
          metaParams = { content_name: payload.click_text || payload.event, content_category: 'whatsapp', currency: 'EUR' };
        } else if (url.indexOf('tel:') === 0) {
          metaEvent = 'Lead'; capiCat = 'phone';
          metaParams = { content_name: payload.click_text || payload.event, content_category: 'phone', currency: 'EUR' };
        } else if (url.indexOf('mailto:') === 0) {
          metaEvent = 'Lead'; capiCat = 'email';
          metaParams = { content_name: payload.click_text || payload.event, content_category: 'email', currency: 'EUR' };
        } else if (payload.event === 'wa_click' || payload.event === 'phone_click') {
          metaEvent = 'Lead'; capiCat = 'contact';
          metaParams = { content_name: payload.click_text || payload.event, content_category: 'contact', currency: 'EUR' };
        } else if (payload.event === 'estimate_submit' || payload.event === 'lead_submitted') {
          metaEvent = 'Lead'; capiCat = 'form';
          metaParams = { content_category: payload.event };
        } else if (payload.event === 'estimator_result' || payload.event === 'estimator_completed') {
          metaEvent = 'ViewContent'; metaParams = { content_name: payload.tier || payload.slug || 'estimator', currency: 'EUR' };
        } else if (payload.event === 'pricing_tier_clicked') {
          metaEvent = 'ViewContent'; metaParams = { content_name: payload.tier };
        }

        // ── Marketing destinations (marketing consent) ──
        if (marketingOk) {
          // Browser Pixel — only when fbevents.js actually loaded.
          if (typeof window.fbq === 'function' && metaEvent) {
            fbq('track', metaEvent, metaParams, eid);
          }
          // Conversions API mirror — fires for every LEAD independently of the
          // Pixel, so it still lands when an ad-blocker prevents fbevents.js from
          // loading (exactly the loss CAPI exists to recover). /api/capi is a
          // no-op until META_CAPI_TOKEN is set; fire-and-forget.
          if (capiCat) {
            try {
              var readCookie = function(n){ var m = document.cookie.match('(^|;)\\s*' + n + '\\s*=\\s*([^;]+)'); return m ? m.pop() : ''; };
              var fbclid = '';
              try { fbclid = new URLSearchParams(location.search).get('fbclid') || ''; } catch (e) {}
              fetch('/api/capi', { method: 'POST', headers: { 'Content-Type': 'application/json' }, keepalive: true,
                body: JSON.stringify({ event_name: 'Lead', event_id: eventID, url: location.href, ua: navigator.userAgent, fbp: readCookie('_fbp'), fbc: readCookie('_fbc'), fbclid: fbclid, category: capiCat }) }).catch(function(){});
            } catch (e) {}
          }
        }
      };

      // ── AI Referral detection ────────────────────────────────────
      // On page load, check document.referrer against known AI search
      // referrers and push an `ai_referral` event to the unified pipeline.
      (function detectAIReferral() {
        try {
          var ref = document.referrer || '';
          if (!ref) return;
          var aiHosts = [
            { host: 'chat.openai.com', source: 'chatgpt' },
            { host: 'chatgpt.com', source: 'chatgpt' },
            { host: 'perplexity.ai', source: 'perplexity' },
            { host: 'www.perplexity.ai', source: 'perplexity' },
            { host: 'claude.ai', source: 'claude' },
            { host: 'copilot.microsoft.com', source: 'bing_copilot' },
            { host: 'bing.com', source: 'bing' },
            { host: 'gemini.google.com', source: 'gemini' },
          ];
          var url = new URL(ref);
          var match = aiHosts.find(function(item) {
            return url.hostname === item.host || url.hostname.endsWith('.' + item.host);
          });
          if (!match) return;
          if (typeof window.__rl_push === 'function') {
            window.__rl_push({
              event: 'ai_referral',
              ai_source: match.source,
              ai_referrer_url: ref,
              landing_path: location.pathname,
              page_lang: pageLang,
            });
          }
        } catch (e) {
          // referrer parse failure — silent fail
        }
      })();

      document.addEventListener('click', function(e) {
        var el = e.target.closest('[data-event]');
        if (!el) return;
        // Re-stamp the ref at click time: dynamically assembled links (the
        // Estimator rewrites its href on every render) would otherwise lose
        // the DOM-ready injection. rlWithRef is idempotent.
        if (el.href && el.href.indexOf('wa.me') !== -1) el.href = rlWithRef(el.href);
        var ev = el.getAttribute('data-event');
        window.__rl_push({
          event: ev,
          click_url: el.href || '',
          click_text: (el.innerText || '').trim().substring(0, 100)
        });
      });

      document.addEventListener('submit', function(e) {
        if (!e.target.closest('[data-form="estimate"]')) return;
        window.__rl_push({ event: 'estimate_submit' });
      });

      // Auto-tag any wa.me / tel: links that don't already have data-event,
      // and stamp the visitor ref into every static wa.me prefill (RL-301) —
      // covers long-press "copy link" and middle-click, not just left clicks.
      document.querySelectorAll('a[href*="wa.me"]:not([data-event])').forEach(function(el){
        el.setAttribute('data-event','wa_click');
      });
      document.querySelectorAll('a[href*="wa.me"]').forEach(function(el){
        el.href = rlWithRef(el.href);
      });
      document.querySelectorAll('a[href^="tel:"]:not([data-event])').forEach(function(el){
        el.setAttribute('data-event','phone_click');
      });

      // ── CookieConsent v3 ─────────────────────────────────────────────────────

      // Sync CookieConsent dark mode with site theme
      if (document.documentElement.classList.contains('dark')) {
        document.documentElement.classList.add('cc--darkmode');
      } else {
        document.documentElement.classList.remove('cc--darkmode');
      }

      var ccScript = document.createElement('script');
      ccScript.src = '/vendor/cookieconsent.umd.js';
      ccScript.onload = function() {
        CookieConsent.run({
          guiOptions: {
            consentModal: { layout: 'bar', position: 'bottom', equalWeightButtons: true }
          },
          categories: {
            necessary: { enabled: true, readOnly: true },
            analytics: {},
            marketing: {}
          },
          onConsent: function() {
            if (CookieConsent.acceptedCategory('analytics')) { loadGTM(); loadClarity(); }
            if (CookieConsent.acceptedCategory('marketing')) { loadMetaPixel(); rlPersistClickIds(); }
          },
          onChange: function() {
            if (CookieConsent.acceptedCategory('analytics')) { loadGTM(); loadClarity(); }
            if (CookieConsent.acceptedCategory('marketing')) { loadMetaPixel(); rlPersistClickIds(); }
          },
          language: {
            default: pageLang,
            translations: {
              [pageLang]: ccTranslation
            }
          }
        });
      };
      document.head.appendChild(ccScript);
    </script>
  </body>
</html>
