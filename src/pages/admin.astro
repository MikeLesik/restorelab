---
// Admin pipeline + quote composer (RL-420, UX rework per the 6-lens audit).
// ES-only by design (see CLAUDE.md), noindex, standalone shell — no
// BaseLayout/GTM/consent on an internal tool. Token prompt once →
// localStorage → x-admin-token on every call (collection 404 = wrong token).
//
// North star: opens on a phone between jobs and answers "what needs me RIGHT
// NOW" in two seconds, then quote-and-send-to-WhatsApp in one tap.
import '@/styles/global.css';
import { TRANSITIONS, STATUSES } from '@/lib/orderPipeline';
import { areaProfiles } from '@/lib/areaProfiles';
import { WHATSAPP_NUMBER, SITE_URL } from '@/lib/constants';
import { DEPOSIT_MIN_QUOTE_EUR, ADDON_PARTNER_PCT } from '@/lib/unitEconomics';
import PhoneField from '@/components/PhoneField.astro';

import en from '@/content/en.json';
import es from '@/content/es.json';
import ca from '@/content/ca.json';

// Per-lang pricing + quote templates: the composer computes every number from
// the SAME structured pricing data the public site renders (RL-401 guardrails)
// and renders the message in the ORDER's language.
const CONTENT: Record<string, any> = { es, en, ca };
const PRICING: Record<string, any> = {};
for (const [lang, t] of Object.entries(CONTENT)) {
  PRICING[lang] = {
    packages: Object.fromEntries(
      t.pricing.categories.flatMap((c: any) => c.packages).map((p: any) => [
        p.slug,
        { name: p.name, price: p.price, price_eur: p.price_eur, size_pricing: p.size_pricing || null },
      ])
    ),
    sizes: Object.fromEntries((t.pricing.ui.size_categories || []).map((s: any) => [s.id, s.name])),
    quote: Object.fromEntries(
      Object.entries(t.wa_messages).filter(([k]) => k.startsWith('quote_'))
    ),
    // Lifecycle copy-buttons (booking confirmation, reminders, follow-ups…) —
    // rendered in the ORDER's language, same rule as the quote.
    lifecycle: Object.fromEntries(
      Object.entries(t.wa_messages).filter(([k]) => k.startsWith('lc_'))
    ),
    payment_link: t.wa_messages.payment_link,
  };
}
const AREAS = Object.fromEntries(
  Object.entries(areaProfiles).map(([slug, a]: [string, any]) => [slug, { name: a.name, fee: a.travelFee }])
);
const SERVICE_OPTIONS = es.pricing.categories.map((c: any) => ({
  title: c.title,
  options: c.packages.map((p: any) => ({ slug: p.slug, name: p.name })),
}));
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>restoreLab — Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <!-- Installable as a standalone home-screen app (PWA) -->
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="RL Admin" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/admin.webmanifest" />
    <script>
      if ('serviceWorker' in navigator) {
        // updateViaCache:'none' — always fetch a fresh SW, never from HTTP cache.
        navigator.serviceWorker.register('/rl-app-sw.js', { updateViaCache: 'none' }).catch(() => {});
      }
    </script>
  </head>
  <body class="bg-brand-dark min-h-screen text-th-body">
    <div class="adm-shell max-w-6xl mx-auto px-4 py-4 sm:py-6 pb-24">

      <!-- Header: brand + refresh; tabs on their own row (thumb-sized) -->
      <header class="mb-4">
        <div class="flex items-center justify-between gap-3 mb-3">
          <p class="font-display font-bold text-th-heading text-xl">
            restore<span class="text-brand-accent">Lab</span>
          </p>
          <button id="btn-refresh" class="btn-secondary text-sm px-4 min-h-[44px]">↻ Actualizar</button>
        </div>
        <div class="flex rounded-xl border border-th-border/15 overflow-hidden text-sm">
          <button id="tab-pipeline" class="flex-1 text-center py-2.5 min-h-[44px] bg-brand-accent/15 text-brand-accent">Pedidos</button>
          <button id="tab-metrics" class="flex-1 text-center py-2.5 min-h-[44px] text-th-muted">Métricas</button>
          <button id="tab-partners" class="flex-1 text-center py-2.5 min-h-[44px] text-th-muted">Partners</button>
        </div>
      </header>

      <div id="view-pipeline">
        <!-- Action chips: what needs me right now (rendered from data) -->
        <div id="chips" class="flex flex-wrap gap-2 mb-3"></div>

        <!-- Always-visible search: the "client calls, find their order" path -->
        <input id="f-search" type="search" inputmode="search" autocomplete="off" enterkeyhint="search" placeholder="Buscar nombre, teléfono o código" aria-label="Buscar pedido" class="adm-input mb-3" />

        <!-- Filters: collapsed on mobile behind a toggle -->
        <div class="mb-1">
          <button id="filters-toggle" class="sm:hidden text-sm text-th-muted min-h-[44px] flex items-center gap-1.5">
            <span>Filtros</span><span id="filters-dot" class="hidden w-2 h-2 rounded-full bg-brand-accent"></span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div id="filters" class="hidden sm:flex flex-wrap gap-2 items-center pt-1">
            <select id="f-status" class="adm-input w-full sm:w-auto"><option value="">Estado: todos</option></select>
            <select id="f-channel" class="adm-input w-full sm:w-auto">
              <option value="">Canal: todos</option>
              <option value="form">Formulario</option>
              <option value="whatsapp">WhatsApp</option>
              <option value="phone">Teléfono</option>
              <option value="b2b">B2B</option>
            </select>
            <select id="f-partner" class="adm-input w-full sm:w-auto"><option value="">Partner: todos</option></select>
            <input id="f-month" type="month" class="adm-input w-full sm:w-auto" />
            <button id="f-clear" class="hidden text-sm text-brand-accent min-h-[44px]">Quitar filtros</button>
          </div>
        </div>
        <p class="text-th-faint text-xs mb-4"><span id="pipeline-count"></span> <span id="pipeline-updated"></span></p>

        <main id="pipeline" class="space-y-6"></main>
      </div>

      <!-- Métricas (RL-460) -->
      <div id="view-metrics" class="hidden">
        <div class="flex flex-wrap gap-2 mb-6 items-center">
          <input id="m-month" type="month" class="adm-input w-auto" />
          <button id="m-load" class="btn-secondary text-sm px-4 min-h-[44px]">Cargar</button>
          <button id="m-csv" class="btn-secondary text-sm px-4 min-h-[44px] ml-auto">Exportar CSV</button>
        </div>
        <div id="m-body" class="space-y-6"><p class="text-th-muted text-sm">Cargando…</p></div>
      </div>

      <!-- Partners: CRUD + payout ledger (RL-430) -->
      <div id="view-partners" class="hidden">
        <div class="flex flex-wrap gap-2 mb-6 items-center">
          <input id="pt-month" type="month" class="adm-input w-auto" />
          <button id="pt-load" class="btn-secondary text-sm px-4 min-h-[44px]">Cargar</button>
          <button id="btn-partner" class="btn-secondary text-sm px-4 min-h-[44px]">+ Partner</button>
          <button id="btn-invite" class="btn-primary text-sm px-4 min-h-[44px]">🔗 Enlace de registro</button>
          <button id="pt-csv" class="btn-secondary text-sm px-4 min-h-[44px] ml-auto">Liquidación CSV</button>
        </div>
        <div id="pt-body" class="space-y-6"><p class="text-th-muted text-sm">Cargando…</p></div>
      </div>

      <!-- Detail overlay -->
      <div id="detail" class="hidden fixed inset-0 z-50 overflow-y-auto bg-brand-dark">
        <div class="sticky top-0 z-10 bg-brand-dark/95 backdrop-blur border-b border-th-border/10 shadow-[0_12px_24px_-12px_rgba(0,0,0,0.6)]">
          <div class="max-w-3xl mx-auto px-4 py-2.5 flex items-center justify-between">
            <button id="d-back" class="btn-secondary text-sm px-4 min-h-[44px]">← Volver</button>
            <span id="d-status-chip" class="adm-badge text-sm"></span>
          </div>
        </div>
        <div class="max-w-3xl mx-auto px-4 py-4" id="detail-body"></div>
      </div>

      <!-- New order modal -->
      <div id="modal-new" class="hidden fixed inset-0 z-50 overflow-y-auto bg-brand-dark/80 backdrop-blur-md">
        <div class="max-w-lg mx-auto px-4 py-10" style="padding-top:max(2.5rem,calc(env(safe-area-inset-top) + 1rem))">
          <div class="card p-6 shadow-[0_24px_64px_-16px_rgba(0,0,0,0.7)]">
            <h2 class="font-display font-bold text-th-heading text-xl mb-1">Nuevo pedido manual</h2>
            <p class="text-th-faint text-xs mb-5">Disciplina: el 100% de los pedidos (también los que entran por WhatsApp) viven aquí — solo así las métricas serán reales.</p>
            <div class="space-y-3">
              <PhoneField id="n-phone" required placeholder="Teléfono * (600 000 000)" inputClass="adm-input" selectClass="adm-input" />
              <input id="n-name" type="text" placeholder="Nombre" class="adm-input" />
              <select id="n-service" class="adm-input">
                <option value="">Servicio…</option>
                {SERVICE_OPTIONS.map((g: any) => (
                  <optgroup label={g.title}>
                    {g.options.map((o: any) => <option value={o.slug}>{o.name}</option>)}
                  </optgroup>
                ))}
              </select>
              <select id="n-size" class="adm-input"><option value="">Tamaño…</option></select>
              <select id="n-area" class="adm-input"><option value="">Zona…</option></select>
              <div class="grid grid-cols-2 gap-3">
                <select id="n-channel" class="adm-input">
                  <option value="whatsapp" selected>WhatsApp</option>
                  <option value="phone">Teléfono</option>
                  <option value="b2b">B2B</option>
                  <option value="form">Formulario</option>
                </select>
                <select id="n-lang" class="adm-input">
                  <option value="es" selected>ES</option><option value="en">EN</option><option value="ca">CA</option>
                </select>
              </div>
              <input id="n-ref" type="text" maxlength="7" placeholder="Ref del mensaje (RL-XXXX)" class="adm-input" style="text-transform:uppercase" />
              <p class="text-th-faint text-xs -mt-1">Última línea «Ref: RL-…» del WhatsApp del cliente — sin ella el CAC no ve este pedido.</p>
              <textarea id="n-notes" rows="2" placeholder="Notas" class="adm-input"></textarea>
              <p id="n-error" class="hidden text-sm text-red-400"></p>
              <div class="flex gap-2">
                <button id="n-save" class="btn-primary flex-1 min-h-[48px] text-sm">Crear pedido</button>
                <button data-close class="btn-secondary min-h-[48px] px-5 text-sm">Cancelar</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- New partner modal -->
      <div id="modal-partner" class="hidden fixed inset-0 z-50 overflow-y-auto bg-brand-dark/80 backdrop-blur-md">
        <div class="max-w-lg mx-auto px-4 py-10" style="padding-top:max(2.5rem,calc(env(safe-area-inset-top) + 1rem))">
          <div class="card p-6 shadow-[0_24px_64px_-16px_rgba(0,0,0,0.7)]">
            <h2 class="font-display font-bold text-th-heading text-xl mb-4">Nuevo partner</h2>
            <div class="space-y-3">
              <input id="p-name" type="text" placeholder="Nombre *" class="adm-input" />
              <PhoneField id="p-phone" placeholder="Teléfono (600 000 000)" inputClass="adm-input" selectClass="adm-input" />
              <div class="grid grid-cols-2 gap-3">
                <input id="p-nif" type="text" maxlength="20" placeholder="NIF/NIE" class="adm-input" />
                <input id="p-email" type="email" maxlength="100" placeholder="Email (facturas)" class="adm-input" />
              </div>
              <div>
                <label for="p-rc" class="text-xs text-th-faint block mb-1">Póliza RC — fecha de vencimiento (gate de asignación)</label>
                <input id="p-rc" type="date" class="adm-input" />
              </div>
              <input id="p-zones" type="text" placeholder="Zonas (slugs, coma): sant-cugat, terrassa" class="adm-input" />
              <input id="p-skills" type="text" placeholder="Servicios (slugs, coma): single-stage, headlight-restoration" class="adm-input" />
              <input id="p-payout" type="number" inputmode="numeric" value="70" min="0" max="100" placeholder="% payout" class="adm-input" />
              <p id="p-error" class="hidden text-sm text-red-400"></p>
              <div class="flex gap-2">
                <button id="p-save" class="btn-primary flex-1 min-h-[48px] text-sm">Crear</button>
                <button data-close class="btn-secondary min-h-[48px] px-5 text-sm">Cancelar</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Toast -->
      <!-- Login gate — in-page (never window.prompt, which is dead in an
           installed standalone PWA on iOS). Shown when there is no valid token. -->
      <div id="login" class="hidden fixed inset-0 z-[70] bg-brand-dark flex items-center justify-center px-4" style="padding-top:max(1rem,env(safe-area-inset-top));padding-bottom:max(1rem,env(safe-area-inset-bottom))">
        <div class="card p-6 w-full max-w-xs text-center">
          <p class="font-display font-bold text-th-heading text-xl mb-1">restore<span class="text-brand-accent">Lab</span></p>
          <p class="text-th-muted text-sm mb-4">Introduce tu token de acceso</p>
          <form id="login-form">
            <input id="login-token" type="password" inputmode="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label="Admin token" placeholder="Admin token" class="adm-input text-center mb-3" />
            <p id="login-error" class="hidden text-sm text-red-400 mb-3"></p>
            <button type="submit" class="btn-primary w-full min-h-[48px] focus-visible:ring-2">Entrar</button>
          </form>
        </div>
      </div>

      <div id="toast" class="hidden fixed bottom-24 left-1/2 -translate-x-1/2 z-[60] max-w-[90vw] adm-toast"></div>
    </div>

    <!-- FAB: the one creation action, always thumb-reachable -->
    <button id="btn-new" class="fixed bottom-5 right-4 z-40 btn-primary rounded-full px-5 py-3.5 text-sm shadow-[0_8px_24px_-6px_rgba(42,127,255,0.45),0_4px_12px_rgba(0,0,0,0.6)]">+ Nuevo pedido</button>

    <style is:global>
      /* ── The craftsman's cockpit — design tokens (art-direction spec) ── */
      :root {
        --adm-ease: cubic-bezier(.22,.61,.36,1);
        /* 5-tone semantic status palette (AA on near-black) */
        --tone-action-bg: rgba(42,127,255,.13); --tone-action-tx: #7EB1FF; --tone-action-bd: rgba(42,127,255,.32);
        --tone-flight-bg: rgba(255,255,255,.05); --tone-flight-tx: rgba(255,255,255,.72); --tone-flight-bd: rgba(255,255,255,.14);
        --tone-due-bg: transparent; --tone-due-tx: #4ADE80; --tone-due-bd: rgba(74,222,128,.45);
        --tone-money-bg: rgba(74,222,128,.12); --tone-money-tx: #4ADE80; --tone-money-bd: rgba(74,222,128,.28);
        --tone-closed-bg: rgba(139,147,163,.10); --tone-closed-tx: #8B93A3; --tone-closed-bd: rgba(139,147,163,.22);
        --adm-red-breach: #DC2626; --adm-red-soft: #F87171; --adm-green: #4ADE80;
        --adm-shadow-float: 0 12px 32px -8px rgb(0 0 0/.7);
      }
      /* Atmosphere — activates the glass, paints once */
      body::before {
        content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none;
        background-image:
          radial-gradient(120% 65% at 50% -12%, rgb(13 27 42/.85) 0%, rgb(13 27 42/0) 60%),
          radial-gradient(90% 60% at 108% 104%, rgb(27 58 92/.22) 0%, rgb(27 58 92/0) 55%);
      }
      .card { box-shadow: inset 0 1px 0 rgb(255 255 255/.06), 0 8px 24px -16px rgb(0 0 0/.6); }
      #pipeline > div + div, #pipeline > details { border-top: 1px solid rgb(255 255 255/.06); padding-top: 1rem; }
      button, a, summary { -webkit-tap-highlight-color: transparent; }
      :where(button,a,summary):focus-visible { outline: 2px solid rgb(var(--brand-accent)); outline-offset: 2px; }
      :where(button,a,summary):focus:not(:focus-visible) { outline: none; }

      .adm-input {
        width: 100%; border-radius: .75rem;
        border: 1px solid rgb(255 255 255/.1);
        background: rgb(255 255 255/.05);
        box-shadow: inset 0 1px 2px rgb(0 0 0/.3);
        padding: .55rem .9rem;
        font-size: 16px; /* 16px kills the iOS focus zoom */
        min-height: 44px;
        color: rgb(var(--th-heading));
        transition: border-color .15s ease, box-shadow .15s ease;
      }
      .adm-input::placeholder { color: rgb(var(--th-faint)); }
      .adm-input:focus {
        outline: none; border-color: rgb(var(--brand-accent)/.7);
        box-shadow: inset 0 1px 2px rgb(0 0 0/.3), 0 0 0 3px rgb(var(--brand-accent)/.22);
      }
      /* Field eyebrow label for form grids (partner editor etc.) */
      .adm-flabel { display: block; font-size: 11px; line-height: 1.2; margin-bottom: .3rem;
        color: rgb(var(--th-faint)); text-transform: uppercase; letter-spacing: .05em; font-weight: 500; }

      .adm-badge {
        display: inline-flex; align-items: center; height: 1.5rem; gap: .35rem;
        padding: 0 .6rem; border-radius: .45rem; border: 1px solid transparent;
        font-size: .6875rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase;
        font-family: 'Space Grotesk Variable', sans-serif; font-variant-numeric: tabular-nums;
        transition: background-color .25s ease, color .25s ease, border-color .25s ease;
      }

      /* Action chips — count-first coins */
      .adm-chip {
        display: inline-flex; align-items: center; gap: .55rem; min-height: 44px;
        padding: .25rem 1rem .25rem .3rem; border-radius: 9999px;
        font-size: .8125rem; font-weight: 600; color: rgb(var(--th-heading));
        background: linear-gradient(180deg, rgb(255 255 255/.08), rgb(255 255 255/.03));
        border: 1px solid rgb(255 255 255/.12);
        box-shadow: inset 0 1px 0 rgb(255 255 255/.06);
        transition: transform .12s var(--adm-ease), border-color .15s ease;
      }
      .adm-chip:active { transform: scale(.96); }
      .adm-chip b {
        font-family: 'Space Grotesk Variable', sans-serif; font-size: 1.05rem; font-weight: 700;
        min-width: 36px; height: 36px; display: grid; place-items: center; border-radius: 9999px;
        background: rgb(var(--brand-accent)/.16); color: rgb(var(--brand-accent));
        font-variant-numeric: tabular-nums;
      }
      .adm-chip--danger { border-color: rgb(220 38 38/.4); }
      .adm-chip--danger b { background: rgb(220 38 38/.15); color: var(--adm-red-soft); }

      /* THE money bar */
      .adm-money {
        display: flex; align-items: center; justify-content: space-between;
        padding: 0 1.1rem; border-radius: .875rem; color: #04240F;
        background: linear-gradient(180deg, #2EE07A 0%, #25D366 100%);
        border: 1px solid rgb(255 255 255/.3);
        box-shadow: 0 8px 24px -8px rgb(37 211 102/.55), inset 0 1px 0 rgb(255 255 255/.4);
        transition: transform .1s, box-shadow .15s;
      }
      .adm-money:active { transform: translateY(1px); }
      .adm-money-total { font-weight: 700; font-size: 1.3rem; letter-spacing: -.01em; font-variant-numeric: tabular-nums; }
      .adm-money-label { font-size: .8125rem; font-weight: 700; }

      /* SLA pills — 3-tier red; solid fill exists in exactly one place */
      .adm-sla {
        display: inline-flex; align-items: center; gap: .3rem;
        padding: .15rem .6rem; border-radius: 9999px;
        font-size: .75rem; font-weight: 600; font-variant-numeric: tabular-nums;
        transition: background-color .25s ease, color .25s ease;
      }
      .adm-sla--ok { color: rgb(var(--th-faint)); }
      .adm-sla--warn { color: rgb(var(--brand-gold)); background: rgba(212,165,55,.12); border: 1px solid rgba(212,165,55,.25); }
      .adm-sla--late { color: #fff; background: var(--adm-red-breach); animation: adm-sla-pulse 2s ease-in-out infinite; }

      /* Detail status chip — the dot lives here only */
      .adm-status {
        display: inline-flex; align-items: center; gap: .45rem;
        padding: .3rem .8rem; border-radius: 9999px;
        font-size: .8125rem; font-weight: 600;
        background: rgb(255 255 255/.05);
        border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
      }
      .adm-status::before {
        content: ''; width: .5rem; height: .5rem; border-radius: 9999px;
        background: currentColor; box-shadow: 0 0 6px currentColor;
      }

      .adm-toast {
        display: flex; align-items: center; gap: .5rem;
        padding: .65rem 1.1rem; border-radius: .875rem;
        font-size: .875rem; font-weight: 500; color: rgb(var(--th-heading));
        background: rgb(13 27 42/.85);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgb(255 255 255/.12); border-left: 3px solid var(--adm-green);
        box-shadow: var(--adm-shadow-float);
      }
      .adm-toast--err { border-left-color: var(--adm-red-soft); }
      /* .adm-toast's display:flex ties with Tailwind's .hidden in specificity
         and wins by order — the id selector restores the hidden contract. */
      #toast.hidden { display: none; }

      .adm-shimmer {
        background-image: linear-gradient(100deg, rgb(255 255 255/.05) 40%, rgb(255 255 255/.13) 50%, rgb(255 255 255/.05) 60%);
        background-size: 200% 100%;
        animation: adm-shimmer 1.4s linear infinite;
      }

      .adm-timeline { position: relative; padding-left: 1.15rem; }
      .adm-timeline::before {
        content: ''; position: absolute; left: .3rem; top: .5rem; bottom: .5rem; width: 1px;
        background: linear-gradient(rgb(255 255 255/.2), rgb(255 255 255/.04));
      }
      .adm-timeline li { position: relative; padding: .35rem 0; }
      .adm-timeline li::before {
        content: ''; position: absolute; left: -1.02rem; top: .55rem;
        width: 7px; height: 7px; border-radius: 9999px; background: rgb(255 255 255/.25);
      }
      .adm-timeline li:first-child::before {
        background: rgb(var(--brand-accent)); box-shadow: 0 0 0 3px rgb(var(--brand-accent)/.15);
      }

      #detail {
        background-color: rgb(10 10 10);
        background-image: radial-gradient(120% 65% at 50% -12%, rgb(13 27 42/.85) 0%, rgb(13 27 42/0) 60%);
      }
      .card { transition: transform .15s var(--adm-ease); }
      .card:has(> [data-open]:active) { transform: scale(.985); }

      @media (pointer: coarse) {
        #detail-body .btn-primary, #detail-body .btn-secondary, #detail-body .btn-whatsapp { min-height: 44px; }
      }

      /* ── Motion system: entrance-only, one easing, 120–320ms ── */
      @keyframes adm-spin { to { transform: rotate(360deg); } }
      .adm-spinning { animation: adm-spin 1s linear infinite; display: inline-block; }
      @keyframes adm-rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
      @keyframes adm-sheet-in { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
      @keyframes adm-modal-in { from { opacity: 0; } to { opacity: 1; } }
      @keyframes adm-card-in { from { opacity: 0; transform: translateY(10px) scale(.97); } to { opacity: 1; transform: none; } }
      @keyframes adm-toast-in { from { opacity: 0; transform: translate(-50%, 10px) scale(.95); } to { opacity: 1; transform: translate(-50%, 0) scale(1); } }
      @keyframes adm-toast-out { to { opacity: 0; transform: translate(-50%, 6px); } }
      @keyframes adm-shimmer { from { background-position: -200% 0; } to { background-position: 200% 0; } }
      @keyframes adm-bar-in { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
      @keyframes adm-tick { 0% { transform: scale(1); } 40% { transform: scale(1.15); color: #fff; } 100% { transform: scale(1); } }
      @keyframes adm-sla-pulse { 50% { box-shadow: 0 0 0 5px rgb(220 38 38/.16); } }
      #detail:not(.hidden) { animation: adm-sheet-in .28s var(--adm-ease); }
      #modal-new:not(.hidden), #modal-partner:not(.hidden) { animation: adm-modal-in .2s ease-out; }
      #modal-new:not(.hidden) .card, #modal-partner:not(.hidden) .card { animation: adm-card-in .26s var(--adm-ease); }
      #toast:not(.hidden) { animation: adm-toast-in .22s var(--adm-ease); }
      #toast.adm-out { animation: adm-toast-out .18s ease-in forwards; }
      #q-bar { animation: adm-bar-in .3s var(--adm-ease) .1s both; }
      #q-total { display: inline-block; }
      #q-total.adm-tick { animation: adm-tick .28s var(--adm-ease); }
      #filters:not(.hidden) { animation: adm-rise .2s var(--adm-ease); }
      .adm-stagger > * { animation: adm-rise .3s var(--adm-ease) both; }
      .adm-stagger > *:nth-child(2) { animation-delay: 60ms; }
      .adm-stagger > *:nth-child(3) { animation-delay: 120ms; }
      .adm-stagger > *:nth-child(n+4) { animation-delay: 160ms; }
      .btn-primary, .btn-secondary, .btn-whatsapp, #btn-new { transition: transform .12s var(--adm-ease), background-color .15s ease; }
      .btn-primary:active, .btn-secondary:active, .btn-whatsapp:active, #btn-new:active { transform: scale(.97); }
      [data-stop]:active { transform: scale(.9); transition: transform .1s var(--adm-ease); }
      @media (prefers-reduced-motion: reduce) {
        #detail, #toast, #q-bar, #q-total, .adm-stagger > *, .adm-sla--late, .adm-shimmer { animation: none !important; }
      }

      /* ── Mobile: notch/home-indicator safe areas + horizontally-scrollable
            data tables so dense tables never crop off-screen ── */
      .adm-shell { padding-top: max(1rem, env(safe-area-inset-top)); }
      @media (min-width: 640px) { .adm-shell { padding-top: max(1.5rem, env(safe-area-inset-top)); } }
      #btn-new { bottom: max(1.25rem, calc(env(safe-area-inset-bottom) + .35rem)); }
      #toast { bottom: max(6rem, calc(env(safe-area-inset-bottom) + 5.5rem)); }
      .adm-tw { overflow-x: auto; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; }
      .adm-tw > table { white-space: nowrap; min-width: 100%; }
      .adm-tw th, .adm-tw td { padding-right: .85rem; }
      .adm-tw th:last-child, .adm-tw td:last-child { padding-right: 0; }
      /* Modal shells honour the notch too when they scroll to the top edge */
      #detail > .sticky { padding-top: env(safe-area-inset-top); }
      /* The sticky quote/pay money bar must clear the home indicator too */
      #q-bar { padding-bottom: max(0.75rem, calc(env(safe-area-inset-bottom) + 0.35rem)); }
    </style>

    <script define:vars={{ TRANSITIONS, STATUSES, PRICING, AREAS, WA: WHATSAPP_NUMBER, SITE_URL, DEPOSIT_MIN: DEPOSIT_MIN_QUOTE_EUR, ADDON_PCT: ADDON_PARTNER_PCT }}>
      // ── Vocabulary ────────────────────────────────────────────────────────
      const STATUS_ES = {
        new: 'Por presupuestar', quoted: 'Presupuesto enviado', booked: 'Confirmado',
        assigned: 'Asignado', in_progress: 'En curso', qc: 'Control calidad',
        awaiting_payment: 'Por cobrar', paid: 'Pagado', done: 'Cerrado', cancelled: 'Cancelado',
      };
      const ACTION_ES = { // verb for the happy-path transition button
        quoted: 'Marcar presupuesto enviado', booked: 'Confirmar reserva',
        assigned: 'Asignar a partner', in_progress: 'Empezar trabajo',
        qc: 'Enviar a control de calidad', awaiting_payment: 'Solicitar pago',
        paid: 'Marcar pagado', done: 'Cerrar pedido',
      };
      // 5-tone semantic palette: blue = needs me, neutral = in flight,
      // hollow green = money pending, filled green = money landed, slate = closed.
      const TONE = {
        action: { bg: 'var(--tone-action-bg)', tx: 'var(--tone-action-tx)', bd: 'var(--tone-action-bd)' },
        flight: { bg: 'var(--tone-flight-bg)', tx: 'var(--tone-flight-tx)', bd: 'var(--tone-flight-bd)' },
        duePay: { bg: 'var(--tone-due-bg)', tx: 'var(--tone-due-tx)', bd: 'var(--tone-due-bd)' },
        money: { bg: 'var(--tone-money-bg)', tx: 'var(--tone-money-tx)', bd: 'var(--tone-money-bd)' },
        closed: { bg: 'var(--tone-closed-bg)', tx: 'var(--tone-closed-tx)', bd: 'var(--tone-closed-bd)' },
      };
      const STATUS_TONE = {
        new: TONE.action, qc: TONE.action, awaiting_payment: TONE.duePay,
        quoted: TONE.flight, booked: TONE.flight, assigned: TONE.flight, in_progress: TONE.flight,
        paid: TONE.money, done: TONE.closed, cancelled: TONE.closed,
      };
      const toneBadge = (s) =>
        `background:${STATUS_TONE[s].bg};color:${STATUS_TONE[s].tx};border-color:${STATUS_TONE[s].bd}`;
      const CHANNEL_ES = { form: 'form', whatsapp: 'wa', phone: 'tel', b2b: 'b2b' };
      const EVENT_ES = {
        created: 'Pedido creado', status_changed: 'Cambio de estado', updated: 'Datos actualizados',
        photo_uploaded: 'Foto subida', payment_link_created: 'Enlace de pago creado',
        stripe_paid: 'Pago recibido (Stripe)', job_token_issued: 'Enlace de partner generado',
        wa_sent: 'WhatsApp automático enviado', wa_send_failed: 'WhatsApp automático FALLÓ',
        partner_note: 'Nota del partner',
      };
      const BANDS = [
        { id: 'accion', title: 'Requiere acción', color: 'rgb(var(--brand-gold))', statuses: ['new', 'qc', 'awaiting_payment'] },
        { id: 'marcha', title: 'En marcha', color: 'rgb(var(--brand-accent))', statuses: ['quoted', 'booked', 'assigned', 'in_progress'] },
      ];
      const CLOSED = ['paid', 'done', 'cancelled'];

      const $ = (id) => document.getElementById(id);
      const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      const digitsOf = (p) => String(p || '').replace(/\D/g, '');
      const svcName = (slug) => PRICING.es.packages[slug]?.name || slug || '';
      const sizeName = (id) => PRICING.es.sizes[id] || id || '';
      const fmtDate = (iso, withTime = true) => {
        if (!iso) return '';
        try {
          return new Intl.DateTimeFormat('es-ES', {
            weekday: 'short', day: 'numeric', month: 'short',
            ...(withTime ? { hour: '2-digit', minute: '2-digit' } : {}),
          }).format(new Date(iso));
        } catch (e) { return iso; }
      };

      // ── Feedback layer ────────────────────────────────────────────────────
      let toastTimer;
      function toast(msg, ok = true) {
        const el = $('toast');
        el.textContent = msg;
        el.classList.toggle('adm-toast--err', !ok);
        el.classList.remove('adm-out');
        el.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          el.classList.add('adm-out');
          setTimeout(() => { el.classList.add('hidden'); el.classList.remove('adm-out'); }, 180);
        }, 2600);
      }
      async function busy(btn, fn, label = 'Guardando…') {
        const old = btn.textContent;
        btn.disabled = true;
        btn.textContent = label;
        try { await fn(); } finally { btn.disabled = false; btn.textContent = old; }
      }

      // ── Token + API ───────────────────────────────────────────────────────
      function token() { return (localStorage.getItem('rl_admin_token') || '').trim(); }

      // In-page login gate. window.prompt() is unreliable inside an installed
      // standalone PWA on iOS (it can silently return null), so we never use it
      // — this overlay works the same in a browser tab and the home-screen app.
      function showLogin(msg) {
        const err = $('login-error');
        if (msg) { err.textContent = msg; err.classList.remove('hidden'); } else { err.classList.add('hidden'); }
        $('login').classList.remove('hidden');
        const inp = $('login-token'); inp.value = '';
        setTimeout(() => { try { inp.focus(); } catch (e) {} }, 60);
      }
      function hideLogin() { $('login').classList.add('hidden'); }
      function boot() { return loadPartners().then(() => loadOrders()).catch(() => {}); }
      $('login-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const t = $('login-token').value.trim();
        if (!t) return;
        localStorage.setItem('rl_admin_token', t);
        hideLogin();
        boot();
      });

      async function api(path, opts = {}) {
        const res = await fetch(path, {
          ...opts,
          headers: { 'Content-Type': 'application/json', 'x-admin-token': token(), ...(opts.headers || {}) },
        });
        if (res.status === 404 && !path.includes('/api/orders/')) {
          localStorage.removeItem('rl_admin_token');
          showLogin('Token incorrecto');
          throw new Error('unauthorized');
        }
        // A wrong-token 404 on /api/orders/* returns a plaintext body (not JSON);
        // never let res.json() throw an uncaught SyntaxError that dead-ends the UI.
        try { return await res.json(); }
        catch { return { ok: false, reason: res.ok ? 'bad_response' : 'unauthorized', status: res.status }; }
      }

      let partners = [];
      let orders = [];
      let lastLoaded = null;

      // ── Pipeline ──────────────────────────────────────────────────────────
      const minutesOld = (iso) => Math.floor((Date.now() - new Date(iso).getTime()) / 60000);
      const ageOf = (iso) => {
        const h = Math.floor((Date.now() - new Date(iso).getTime()) / 3600000);
        return h < 1 ? '<1h' : h < 48 ? h + 'h' : Math.floor(h / 24) + 'd';
      };

      async function loadPartners() {
        try {
          const d = await api('/api/partners');
          partners = d.partners || [];
          $('f-partner').innerHTML = '<option value="">Partner: todos</option>' +
            partners.map((p) => `<option value="${esc(p.id)}">${esc(p.name)}</option>`).join('');
        } catch (e) { /* surfaced by loadOrders */ }
      }

      function filtersActive() {
        return !!($('f-status').value || $('f-channel').value || $('f-partner').value || $('f-month').value || ($('f-search')?.value || '').trim());
      }

      function skeleton() {
        $('pipeline').innerHTML = [1, 2, 3].map(() =>
          '<div class="card p-4"><div class="h-4 adm-shimmer rounded w-1/3 mb-2"></div><div class="h-3 adm-shimmer rounded w-2/3 mb-2"></div><div class="h-3 adm-shimmer rounded w-1/2"></div></div>').join('');
      }

      async function loadOrders(silent) {
        if (!silent) { skeleton(); $('pipeline').classList.add('adm-stagger'); }
        else $('pipeline').classList.remove('adm-stagger');
        const icon = $('btn-refresh');
        icon.innerHTML = '<span class="adm-spinning">↻</span> Actualizar';
        const q = new URLSearchParams();
        if ($('f-status').value) q.set('status', $('f-status').value);
        if ($('f-channel').value) q.set('channel', $('f-channel').value);
        if ($('f-partner').value) q.set('partner_id', $('f-partner').value);
        if ($('f-month').value) q.set('month', $('f-month').value);
        q.set('limit', '200');
        let d;
        try {
          d = await api('/api/orders?' + q);
        } catch (e) {
          $('pipeline').innerHTML = `<p class="text-red-400 text-sm">${esc(e.message)}</p>`;
          icon.textContent = '↻ Actualizar';
          return;
        }
        icon.textContent = '↻ Actualizar';
        if (!d.ok) {
          $('pipeline').innerHTML = `<p class="text-brand-gold text-sm">API no configurada todavía (${esc(d.reason || '')}). Sigue docs/setup-cloudflare-bindings.md.</p>`;
          return;
        }
        orders = d.orders || [];
        lastLoaded = Date.now();
        renderPipeline();
      }

      // Working uninsured is the one partner risk with no recovery path.
      const rcExpired = (p) => !!p?.rc_expiry && p.rc_expiry < new Date().toISOString().slice(0, 10);
      // Partner marked this exact date free in their /socio calendar.
      const availOn = (p, dateIso) => !!(p?.profile?.available_dates || []).includes(dateIso);

      function slaPill(o) {
        // The <=1h quote promise made visible: minutes on new leads.
        // Solid red fill exists in exactly ONE place in the whole UI: here.
        if (o.status !== 'new') {
          if (o.status === 'awaiting_payment' && minutesOld(o.status_ts || o.created_at) > 48 * 60) {
            return `<span class="adm-sla adm-sla--warn">⏱ ${ageOf(o.status_ts || o.created_at)}</span>`;
          }
          // An unaccepted assignment is an offer hanging in the air.
          if (o.status === 'assigned' && !o.accepted_at && minutesOld(o.status_ts || o.created_at) > 4 * 60) {
            return `<span class="adm-sla adm-sla--warn">⏱ partner sin aceptar</span>`;
          }
          // quoted was a black hole: escalate through the follow-up cadence
          // (24h case-photo nudge → 3d slot offer → 7d soft close → lost).
          if (o.status === 'quoted') {
            const h = minutesOld(o.status_ts || o.created_at) / 60;
            if (h > 24 * 14) return `<span class="adm-sla adm-sla--warn">💬 14d — ¿marcar perdido?</span>`;
            if (h > 24 * 7) return `<span class="adm-sla adm-sla--warn">💬 cierre suave (7d)</span>`;
            if (h > 72) return `<span class="adm-sla adm-sla--warn">💬 seguimiento 3d</span>`;
            if (h > 24) return `<span class="adm-sla adm-sla--warn" style="background:none;border:none">💬 seguimiento 24h</span>`;
          }
          // A date in the past with the job not started is a broken promise.
          if (['booked', 'assigned'].includes(o.status) && o.scheduled_at &&
              new Date(o.scheduled_at).getTime() < Date.now() - 2 * 36e5) {
            return `<span class="adm-sla adm-sla--warn">📅 fecha vencida</span>`;
          }
          return `<span class="adm-sla adm-sla--ok">${ageOf(o.status_ts || o.created_at)}</span>`;
        }
        const m = minutesOld(o.created_at);
        if (m > 60) return `<span class="adm-sla adm-sla--late">⏱ ${ageOf(o.created_at)} sin presupuesto</span>`;
        if (m > 45) return `<span class="adm-sla adm-sla--warn">⏱ ${m}m</span>`;
        if (m > 20) return `<span class="adm-sla adm-sla--warn" style="background:none;border:none">⏱ ${m}m</span>`;
        return `<span class="adm-sla adm-sla--ok">⏱ ${m}m</span>`;
      }

      // Payment fact at a glance on the pipeline card: paid in full, partial
      // deposit, or the client's chosen method when nothing's collected yet.
      function payBadge(o) {
        const paid = Number(o.paid_eur) || 0;
        const tot = (Number(o.quote_eur) || 0) + (o.addons || []).reduce((s, a) => s + (Number(a.price_eur) || 0), 0);
        if (tot > 0 && paid >= tot - 0.01) return '<span class="adm-badge bg-green-500/15 text-green-400">✓ pagado</span>';
        if (paid > 0) return `<span class="adm-badge bg-brand-gold/15 text-brand-gold">señal ${paid}€</span>`;
        if (o.payment_pref === 'cash') return '<span class="adm-badge text-th-faint">efectivo</span>';
        return '';
      }

      function orderCard(o, showStatus) {
        const p = partners.find((x) => x.id === o.partner_id);
        const digits = digitsOf(o.phone);
        const m = o.status === 'new' ? minutesOld(o.created_at) : 0;
        const ring = m > 60 ? 'ring-1 ring-red-500/70' : m > 45 ? 'ring-1 ring-brand-gold/40' : '';
        const who = o.client_name || (o.phone ? o.phone : '—');
        const line2 = [svcName(o.service_slug), o.size ? sizeName(o.size) : '', AREAS[o.area_slug]?.name || '']
          .filter(Boolean).join(' · ');
        return `
          <div class="card relative p-4 ${ring}">
            <button data-open="${esc(o.id)}" class="text-left w-full">
              <div class="flex items-baseline justify-between gap-2 pr-24">
                <span class="font-display font-semibold text-[15px] tracking-tight text-th-heading truncate">${esc(who)}</span>
                <span class="text-[11px] tabular-nums text-th-faint shrink-0">${esc(o.code)}</span>
              </div>
              <div class="text-[13px] text-th-muted mt-0.5 truncate pr-20">${esc(line2 || '—')}</div>
              <div class="flex flex-wrap items-center gap-2 mt-2 text-xs">
                ${showStatus ? `<span class="adm-badge" style="${toneBadge(o.status)}">${STATUS_ES[o.status]}</span>` : ''}
                ${o.quote_eur ? `<span class="font-display font-bold text-sm tabular-nums tracking-tight text-brand-accent">${o.quote_eur}€</span>` : ''}
                ${payBadge(o)}
                ${p ? `<span class="adm-badge bg-brand-gold/15 text-brand-gold">${esc(p.name)}${o.status === 'assigned' ? (o.accepted_at ? ' ✔' : ' ⏳') : ''}</span>` : ''}
                ${o.status === 'booked' && !o.scheduled_at ? '<span class="text-brand-gold">📅 sin fecha</span>' : ''}
                ${o.scheduled_at ? `<span class="text-th-muted">📅 ${fmtDate(o.scheduled_at)}</span>` : ''}
                <span class="text-th-faint">${CHANNEL_ES[o.channel] || ''}</span>
                ${o.lang && o.lang !== 'es' ? `<span class="adm-badge bg-brand-accent/20 text-brand-accent">${o.lang.toUpperCase()}</span>` : ''}
                <span class="ml-auto">${slaPill(o)}</span>
              </div>
            </button>
            ${digits ? `
            <div class="absolute top-3 right-3 flex gap-1.5">
              <a href="tel:+${digits}" data-stop class="w-11 h-11 -m-1.5 flex items-center justify-center rounded-lg text-th-muted hover:text-th-heading" aria-label="Llamar">📞</a>
              <a href="https://wa.me/${digits}" target="_blank" rel="noopener" data-stop class="w-11 h-11 -m-1.5 flex items-center justify-center rounded-lg text-brand-whatsapp" aria-label="WhatsApp">💬</a>
            </div>` : ''}
          </div>`;
      }

      function renderPipeline() {
        // Action chips
        const newN = orders.filter((o) => o.status === 'new').length;
        const newLate = orders.filter((o) => o.status === 'new' && minutesOld(o.created_at) > 60).length;
        const qcN = orders.filter((o) => o.status === 'qc').length;
        const cobrarN = orders.filter((o) => o.status === 'awaiting_payment').length;
        const today = new Date().toISOString().slice(0, 10);
        const hoy = orders.filter((o) => (o.scheduled_at || '').slice(0, 10) === today &&
          !['done', 'cancelled', 'paid'].includes(o.status));
        const chip = (label, n, anchor, danger) => n === 0 ? '' :
          `<button data-chip="${anchor}" class="adm-chip${danger ? ' adm-chip--danger' : ''}"><b>${n}</b>${label}</button>`;
        const seguimientoN = orders.filter((o) => o.status === 'quoted' &&
          minutesOld(o.status_ts || o.created_at) > 24 * 60).length;
        $('chips').innerHTML =
          chip('Presupuestar', newN, 'st-new', newLate > 0) +
          chip('Seguimiento', seguimientoN, 'st-quoted', false) +
          chip('QC', qcN, 'st-qc', false) +
          chip('Cobrar', cobrarN, 'st-awaiting_payment', false) +
          (hoy.length ? `<button data-chip="band-marcha" class="adm-chip"><b>${hoy.length}</b>Hoy · ${esc(hoy.map((o) => (fmtDate(o.scheduled_at).split(',')[1] || '').trim()).filter(Boolean).slice(0, 2).join(', '))}</button>` : '');
        document.querySelectorAll('[data-chip]').forEach((el) =>
          el.addEventListener('click', () => document.getElementById(el.dataset.chip)?.scrollIntoView({ behavior: 'smooth', block: 'start' })));

        // Client-side search over the loaded set — instant, no server round-trip.
        // Chips above stay on the full set; only the rendered list is narrowed.
        const term = ($('f-search')?.value || '').trim().toLowerCase();
        const termDigits = term.replace(/\D/g, '');
        const view = term ? orders.filter((o) =>
          (o.client_name || '').toLowerCase().includes(term) ||
          (o.code || '').toLowerCase().includes(term) ||
          (termDigits.length >= 3 && (o.phone || '').replace(/\D/g, '').includes(termDigits))
        ) : orders;
        $('pipeline-count').textContent = term
          ? `${view.length} de ${orders.length} pedidos`
          : `${orders.length} pedido${orders.length === 1 ? '' : 's'}`;
        $('pipeline-updated').textContent = '';
        $('filters-dot').classList.toggle('hidden', !filtersActive());
        $('f-clear').classList.toggle('hidden', !filtersActive());

        // Empty states
        if (orders.length === 0) {
          $('pipeline').innerHTML = filtersActive()
            ? `<div class="card p-8 text-center">
                 <div class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-th-surface/10 border border-th-border/10 grid place-items-center text-2xl">🔍</div>
                 <p class="text-th-muted text-sm mb-4">Sin pedidos con estos filtros.</p>
                 <button id="empty-clear" class="btn-secondary text-sm px-4 min-h-[44px]">Quitar filtros</button>
               </div>`
            : `<div class="card p-8 text-center">
                 <div class="w-14 h-14 mx-auto mb-3 rounded-2xl grid place-items-center text-2xl"
                      style="background:rgb(var(--brand-accent)/.12);border:1px solid rgb(var(--brand-accent)/.25);box-shadow:0 0 24px rgb(var(--brand-accent)/.2)">✨</div>
                 <p class="font-display font-bold text-th-heading text-lg mb-1.5">Todavía no hay pedidos</p>
                 <p class="text-th-muted text-sm mb-4 max-w-sm mx-auto">Cuando alguien escriba por WhatsApp, créalo aquí a mano — así el 100% de los pedidos vive en el mismo sitio y las métricas son reales.</p>
                 <button id="empty-new" class="btn-primary text-sm px-5 min-h-[48px]">+ Crear el primer pedido</button>
               </div>`;
          $('empty-clear')?.addEventListener('click', clearFilters);
          $('empty-new')?.addEventListener('click', () => openModal('modal-new'));
          return;
        }

        // Search matched nothing in the loaded set.
        if (view.length === 0) {
          $('pipeline').innerHTML = `<div class="card p-8 text-center">
            <div class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-th-surface/10 border border-th-border/10 grid place-items-center text-2xl">🔍</div>
            <p class="text-th-muted text-sm mb-4">Sin resultados para «${esc(term)}».</p>
            <button id="empty-search-clear" class="btn-secondary text-sm px-4 min-h-[44px]">Limpiar búsqueda</button>
          </div>`;
          $('empty-search-clear')?.addEventListener('click', () => { $('f-search').value = ''; renderPipeline(); });
          return;
        }

        const section = (s, list, showStatus) => list.length === 0 ? '' : `
          <section id="st-${s}">
            <h3 class="font-display text-sm font-semibold tracking-tight text-th-muted mb-2 flex items-center gap-1.5">
              <span class="w-1 h-1 rounded-full shrink-0" style="background:${STATUS_TONE[s].tx}"></span>
              ${STATUS_ES[s]} <span class="text-th-faint font-normal tabular-nums">· ${list.length}</span>
              ${s === 'new' && newLate ? `<span class="text-sm font-normal" style="color:var(--adm-red-soft)">· ${newLate} fuera de plazo</span>` : ''}
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">${list.map((o) => orderCard(o, showStatus)).join('')}</div>
          </section>`;

        const bandHtml = (band) => {
          const parts = band.statuses.map((s) => {
            let list = view.filter((o) => o.status === s);
            if (s === 'new') list = [...list].sort((a, b) => a.created_at < b.created_at ? -1 : 1); // oldest first
            return section(s, list, false);
          }).filter(Boolean);
          if (!parts.length) return '';
          return `<div id="band-${band.id}">
            <h2 class="font-display text-xs font-bold uppercase tracking-[0.18em] text-th-heading mb-3 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:${band.color};box-shadow:0 0 8px ${band.color}"></span>
              ${band.title}
            </h2>
            <div class="space-y-5">${parts.join('')}</div>
          </div>`;
        };

        const closed = view.filter((o) => CLOSED.includes(o.status));
        const closedHtml = closed.length === 0 ? '' : `
          <details class="pt-1">
            <summary class="text-sm text-th-muted cursor-pointer min-h-[44px] flex items-center">Cerrados · ${closed.length}</summary>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 mt-3">
              ${closed.map((o) => orderCard(o, true)).join('')}
            </div>
          </details>`;

        $('pipeline').innerHTML = BANDS.map(bandHtml).filter(Boolean).join('') + closedHtml;
        document.querySelectorAll('[data-open]').forEach((el) =>
          el.addEventListener('click', () => openDetail(el.getAttribute('data-open'))));
        document.querySelectorAll('[data-stop]').forEach((el) =>
          el.addEventListener('click', (e) => e.stopPropagation()));
      }

      function clearFilters() {
        ['f-status', 'f-channel', 'f-partner', 'f-month', 'f-search'].forEach((id) => { const el = $(id); if (el) el.value = ''; });
        loadOrders();
      }

      // ── Quote composer ────────────────────────────────────────────────────
      const priceOf = (lang, slug, size) => {
        const p = PRICING[lang]?.packages[slug];
        if (!p) return null;
        if (size && p.size_pricing && p.size_pricing[size] != null) return p.size_pricing[size];
        return p.price_eur; // null = quote-only
      };

      function quoteState(o) {
        // Hydrate from a previously saved breakdown so re-opening a quoted
        // order shows what was actually quoted, not defaults.
        const b = o.quote_breakdown;
        if (b && Array.isArray(b.items) && b.items.length) {
          return {
            items: b.items.map((it) => ({ slug: it.slug, size: it.size || '' })),
            travel: b.travel !== null && b.travel !== undefined,
            surcharge: b.sensitive_paint != null,
            surchargeAmount: b.sensitive_paint || 60,
            override: b.custom_override != null ? String(b.custom_override) : '',
            overrideReason: b.override_reason || '',
            customMsg: null,
          };
        }
        return {
          items: [{ slug: o.service_slug || 'single-stage', size: o.size || '' }],
          travel: true, surcharge: false, surchargeAmount: 60,
          override: '', overrideReason: '', customMsg: null,
        };
      }
      let q = null;
      let current = null;

      function quoteTotal(o) {
        if (q.override !== '' && Number.isFinite(Number(q.override))) return Number(q.override);
        let total = 0;
        for (const it of q.items) {
          const v = priceOf(o.lang, it.slug, it.size);
          if (v != null) total += v;
        }
        const fee = AREAS[o.area_slug]?.fee || 0;
        if (q.travel && fee > 0) total += fee;
        if (q.surcharge) total += Number(q.surchargeAmount) || 0;
        return total;
      }

      function quoteMessage(o) {
        const L = PRICING[o.lang] ? o.lang : 'es';
        const T = PRICING[L].quote;
        const name = o.client_name ? ' ' + o.client_name.split(' ')[0] : '';
        const lines = [T.quote_greeting.replace('{name}', name), ''];
        for (const it of q.items) {
          const p = PRICING[L].packages[it.slug];
          if (!p) continue;
          const v = priceOf(L, it.slug, it.size);
          const label = p.name + (it.size && PRICING[L].sizes[it.size] ? ` (${PRICING[L].sizes[it.size]})` : '');
          if (v != null) lines.push(T.quote_line.replace('{item}', label).replace('{price}', v));
        }
        const fee = AREAS[o.area_slug]?.fee || 0;
        if (q.travel) lines.push(fee > 0
          ? T.quote_travel.replace('{area}', AREAS[o.area_slug]?.name || '').replace('{fee}', fee)
          : T.quote_travel_included);
        if (q.surcharge) lines.push(T.quote_line.replace('{item}', T.quote_sensitive_paint || 'Pintura sensible').replace('{price}', Number(q.surchargeAmount) || 0));
        lines.push('', T.quote_total.replace('{total}', quoteTotal(o)), T.quote_validity,
          T.quote_link.replace('{url}', `${SITE_URL}/${L}/pricing`));
        // The quote must hand the client a next step, not just a number.
        if (T.quote_cta) lines.push('', T.quote_cta);
        return lines.join('\n');
      }

      function composerWarnings(o) {
        const warns = [];
        if (!o.service_slug) warns.push('⚠ Pedido sin servicio — verifica el paquete elegido.');
        for (const it of q.items) {
          const p = PRICING.es.packages[it.slug];
          if (p?.size_pricing && !it.size) warns.push(`⚠ «${p.name}»: precio base — elige tamaño para el precio exacto.`);
          if (p && p.price_eur === null) warns.push(`«${p.name}»: a consultar (sin precio fijo).`);
        }
        return warns;
      }

      function composerHtml(o) {
        const itemRow = (it, i) => `
          <div class="rounded-xl border border-th-border/10 p-2.5 space-y-2">
            <select data-qi="${i}" data-k="slug" class="adm-input">
              ${Object.entries(PRICING.es.packages).map(([slug, p]) =>
                `<option value="${slug}" ${slug === it.slug ? 'selected' : ''}>${esc(p.name)}</option>`).join('')}
            </select>
            <div class="flex gap-2 items-center">
              <select data-qi="${i}" data-k="size" class="adm-input flex-1 min-w-0 ${PRICING.es.packages[it.slug]?.size_pricing && !it.size ? 'border-brand-gold/60' : ''}">
                <option value="">Tamaño…</option>
                ${Object.entries(PRICING.es.sizes).map(([id, n]) =>
                  `<option value="${id}" ${id === it.size ? 'selected' : ''}>${esc(n)}</option>`).join('')}
              </select>
              <span data-qprice="${i}" class="text-brand-accent font-semibold shrink-0 whitespace-nowrap text-right">${priceOf(o.lang, it.slug, it.size) ?? 'a consultar'}${priceOf(o.lang, it.slug, it.size) != null ? '€' : ''}</span>
              ${q.items.length > 1 ? `<button data-qdel="${i}" class="w-11 h-11 flex items-center justify-center rounded-lg text-th-faint hover:text-red-400" aria-label="Quitar línea">✕</button>` : ''}
            </div>
          </div>`;
        const fee = AREAS[o.area_slug]?.fee ?? null;
        const warns = composerWarnings(o);
        return `
          <div class="card p-4 sm:p-5 mt-4" id="composer">
            <h3 class="font-display font-bold text-th-heading mb-3">Presupuesto</h3>
            <div class="space-y-2" id="q-items">${q.items.map(itemRow).join('')}</div>
            <button id="q-add" class="btn-secondary w-full text-sm min-h-[44px] mt-2">+ Añadir línea</button>
            <div class="space-y-2 mt-3 text-sm">
              <label class="flex items-center gap-2.5 min-h-[44px] cursor-pointer">
                <input id="q-travel" type="checkbox" ${q.travel ? 'checked' : ''} class="w-5 h-5 accent-brand-accent" />
                Desplazamiento ${fee == null ? '(sin zona)' : fee > 0 ? '+' + fee + '€ (' + esc(AREAS[o.area_slug].name) + ')' : 'incluido'}
              </label>
              <label class="flex items-center gap-2.5 min-h-[44px] cursor-pointer flex-wrap">
                <input id="q-sur" type="checkbox" ${q.surcharge ? 'checked' : ''} class="w-5 h-5 accent-brand-accent" />
                Pintura sensible
                <span id="q-sur-wrap" class="${q.surcharge ? '' : 'hidden'}">
                  <input id="q-sur-amt" type="number" inputmode="numeric" value="${q.surchargeAmount}" min="60" max="100" step="10" class="adm-input w-24 inline-block" />€ <span class="text-th-faint">(60–100)</span>
                </span>
              </label>
              <div class="flex flex-wrap items-center gap-2">
                <label class="text-th-muted min-h-[44px] flex items-center gap-1.5">Precio manual:
                  <input id="q-override" type="number" inputmode="decimal" value="${esc(q.override)}" placeholder="—" class="adm-input w-28 inline-block" />€
                </label>
                <input id="q-override-reason" type="text" value="${esc(q.overrideReason)}" placeholder="motivo del precio manual" class="adm-input flex-1 min-w-40 ${q.override === '' ? 'hidden' : ''}" />
              </div>
            </div>
            ${warns.length ? `<div class="mt-3 space-y-1">${warns.map((w) => `<p class="text-xs text-brand-gold">${esc(w)}</p>`).join('')}</div>` : ''}
            <div class="mt-3">
              <textarea id="q-msg" rows="8" class="adm-input leading-relaxed">${esc(q.customMsg ?? quoteMessage(o))}</textarea>
              <button id="q-regen" class="${q.customMsg == null ? 'hidden' : ''} text-xs text-brand-accent mt-1">✎ texto editado a mano · regenerar</button>
            </div>
          </div>
          <!-- THE money bar: save + send in ONE tap -->
          <div id="q-bar" class="sticky bottom-0 z-20 -mx-4 px-4 py-3 mt-3 bg-brand-dark/95 backdrop-blur border-t border-th-border/15 shadow-[0_-12px_24px_-12px_rgba(0,0,0,0.6)]">
            <div class="flex gap-2 items-stretch">
              <button id="q-send" class="adm-money flex-1 min-h-[52px]">
                <span class="adm-money-total font-display">€<span id="q-total">${quoteTotal(o)}</span></span>
                <span class="adm-money-label">Enviar por WhatsApp →</span>
              </button>
              <button id="q-copy" class="btn-secondary min-h-[52px] px-4 text-sm" aria-label="Copiar mensaje">⧉</button>
            </div>
            <button id="q-save-only" class="w-full text-center text-xs text-th-faint mt-2 min-h-[32px]">Guardar sin enviar</button>
          </div>`;
      }

      function syncComposer(o) {
        // Targeted updates — never nuke the textarea while Mike is editing.
        const tot = $('q-total');
        if (tot) {
          const next = String(quoteTotal(o));
          if (tot.textContent !== next) {
            tot.textContent = next;
            tot.classList.remove('adm-tick');
            void tot.offsetWidth;
            tot.classList.add('adm-tick');
          }
        }
        q.items.forEach((it, i) => {
          const el = document.querySelector(`[data-qprice="${i}"]`);
          if (el) {
            const v = priceOf(o.lang, it.slug, it.size);
            el.textContent = v != null ? v + '€' : 'a consultar';
          }
        });
        $('q-sur-wrap')?.classList.toggle('hidden', !q.surcharge);
        $('q-override-reason')?.classList.toggle('hidden', q.override === '');
        if (q.customMsg == null && $('q-msg')) $('q-msg').value = quoteMessage(o);
        $('q-regen')?.classList.toggle('hidden', q.customMsg == null);
      }

      function currentQuoteBody() {
        return {
          quote_eur: quoteTotal(current),
          quote_breakdown: {
            items: q.items.map((it) => ({ ...it, price: priceOf(current.lang, it.slug, it.size) })),
            travel: q.travel ? (AREAS[current.area_slug]?.fee || 0) : null,
            sensitive_paint: q.surcharge ? Number(q.surchargeAmount) || 0 : null,
            ...(q.override !== '' ? { custom_override: Number(q.override), override_reason: q.overrideReason.trim() } : {}),
          },
        };
      }

      function bindComposer(o) {
        document.querySelectorAll('[data-qi]').forEach((el) =>
          el.addEventListener('change', () => {
            q.items[+el.dataset.qi][el.dataset.k] = el.value;
            if (el.dataset.k === 'slug') refreshDetail(); else syncComposer(o);
          }));
        document.querySelectorAll('[data-qdel]').forEach((el) =>
          el.addEventListener('click', () => { q.items.splice(+el.dataset.qdel, 1); refreshDetail(); }));
        $('q-add')?.addEventListener('click', () => {
          q.items.push({ slug: 'headlight-restoration', size: q.items[0]?.size || '' });
          refreshDetail();
        });
        $('q-travel')?.addEventListener('change', (e) => { q.travel = e.target.checked; syncComposer(o); });
        $('q-sur')?.addEventListener('change', (e) => { q.surcharge = e.target.checked; syncComposer(o); });
        $('q-sur-amt')?.addEventListener('change', (e) => { q.surchargeAmount = e.target.value; syncComposer(o); });
        $('q-override')?.addEventListener('input', (e) => { q.override = e.target.value; syncComposer(o); });
        $('q-override-reason')?.addEventListener('change', (e) => { q.overrideReason = e.target.value; });
        $('q-msg')?.addEventListener('input', () => { q.customMsg = $('q-msg').value; $('q-regen').classList.remove('hidden'); });
        $('q-regen')?.addEventListener('click', () => { q.customMsg = null; syncComposer(o); });
        $('q-copy')?.addEventListener('click', () => {
          navigator.clipboard.writeText($('q-msg').value);
          toast('Mensaje copiado');
        });

        const saveQuote = async (advance) => {
          if (q.override !== '' && !q.overrideReason.trim()) { toast('Indica el motivo del precio manual', false); return false; }
          const body = currentQuoteBody();
          if (advance && current.status === 'new') body.status = 'quoted';
          const d = await api('/api/orders/' + current.id, { method: 'PATCH', body: JSON.stringify(body) });
          if (!d.ok) { toast('Error al guardar: ' + (d.reason || ''), false); return false; }
          current = d.order;
          return true;
        };

        $('q-send')?.addEventListener('click', async () => {
          // Open the window synchronously so iOS Safari doesn't block it,
          // then point it at wa.me only after the PATCH lands.
          const digits = digitsOf(current.phone);
          const msg = $('q-msg').value;
          const w = digits ? window.open('', '_blank') : null;
          const ok = await saveQuote(true);
          if (!ok) { w?.close(); return; }
          if (w) w.location = 'https://wa.me/' + digits + '?text=' + encodeURIComponent(msg);
          else { navigator.clipboard.writeText(msg); toast('Sin teléfono — mensaje copiado'); }
          toast('Presupuesto guardado ✓');
          q = null;
          await loadOrders(true);
          openDetail(current.id);
        });
        $('q-save-only')?.addEventListener('click', async () => {
          // Save the numbers as a DRAFT — do not advance to 'quoted' (that would
          // read as "Presupuesto enviado" and start the follow-up chasing).
          if (await saveQuote(false)) {
            toast('Borrador guardado ✓');
            q = null;
            await loadOrders(true);
            openDetail(current.id);
          }
        });
      }

      // ── Payments (RL-440) ─────────────────────────────────────────────────
      // Add-ons the partner upsold on-site raise what the client pays.
      const addonsTotal = (o) => Math.round((o.addons || []).reduce((s, a) => s + (Number(a.price_eur) || 0), 0) * 100) / 100;
      const orderTotal = (o) => Math.round(((Number(o.quote_eur) || 0) + addonsTotal(o)) * 100) / 100;

      function paymentHtml(o) {
        const paid = Number(o.paid_eur) || 0;
        const total = orderTotal(o);
        const rest = Math.round((total - paid) * 100) / 100;
        const L = PRICING[o.lang] ? o.lang : 'es';
        // Deposit rule (Order Flow v2 §1.6): big bookings hold the slot with
        // a 30% senal sent together with the confirmation.
        const senalHint = o.status === 'booked' && !paid && (o.payment_pref || '') !== 'cash'
          ? (o.quote_eur >= DEPOSIT_MIN
            ? `<p class="text-xs text-brand-gold mb-2">Reserva de ${DEPOSIT_MIN}€ o más — envía «Señal 30%» junto con la confirmación. Sin pagar en 24h, el hueco no se aguanta.</p>`
            : `<p class="text-xs text-th-faint mb-2">Por debajo de ${DEPOSIT_MIN}€ no hace falta señal — basta el recordatorio T-24h.</p>`)
          : '';
        const pref = o.payment_pref || '';
        const addT = addonsTotal(o);
        const covered = total > 0 && paid >= total - 0.01;
        const addLine = addT > 0 ? ` <span class="text-th-faint text-xs">(base ${o.quote_eur}€ + extras ${addT}€)</span>` : '';
        // Prominent, unmissable payment status at the top of the card.
        const statusBanner = covered
          ? `<div class="rounded-xl bg-green-500/15 border border-green-500/30 px-3 py-2.5 mb-3"><span class="text-green-400 font-semibold text-sm">✓ Cobrado por completo</span> <span class="font-display font-bold tabular-nums text-green-400">${paid}€</span></div>`
          : paid > 0
          ? `<div class="rounded-xl bg-brand-gold/15 border border-brand-gold/30 px-3 py-2.5 mb-3"><span class="text-brand-gold font-semibold text-sm">Señal recibida</span> <span class="font-display font-bold tabular-nums text-brand-gold">${paid}€</span> <span class="text-th-muted text-sm">· falta</span> <span class="font-display font-bold tabular-nums text-th-heading">${rest}€</span>${addLine}</div>`
          : `<div class="rounded-xl bg-th-surface/[0.06] border border-th-border/10 px-3 py-2.5 mb-3"><span class="text-th-muted text-sm">Sin cobrar todavía · total</span> <span class="font-display font-bold tabular-nums text-brand-accent">${total}€</span>${addLine}</div>`;
        // How the client pays — asked once, drives the rest of the card.
        const methodRow = `
          <label class="text-xs text-th-faint block mb-1">¿Cómo paga el cliente?</label>
          <select id="d-paypref" class="adm-input mb-3">
            <option value="" ${pref === '' ? 'selected' : ''}>Preguntar al cliente…</option>
            <option value="online" ${pref === 'online' ? 'selected' : ''}>Online — tarjeta o Bizum (enlace)</option>
            <option value="cash" ${pref === 'cash' ? 'selected' : ''}>En efectivo, al terminar</option>
          </select>`;
        const onlineBlock = pref === 'cash' ? '' : `
            ${pref === '' ? '<p class="text-xs text-th-faint mb-2">Pregunta al cliente cómo prefiere pagar y márcalo arriba.</p>' : ''}
            <div class="flex flex-wrap gap-2 mb-3">
              <button data-pay="full" class="btn-secondary text-sm px-4">Enlace 100%</button>
              <button data-pay="deposit" class="btn-secondary text-sm px-4">Señal 30%</button>
              ${paid > 0 && rest > 0 ? '<button data-pay="rest" class="btn-secondary text-sm px-4">Enlace resto</button>' : ''}
            </div>
            <p id="pay-status" class="hidden text-sm mb-3"></p>
            ${o.payment_link ? `
              <div class="flex flex-wrap items-center gap-2 mb-3 text-sm">
                <a href="${esc(o.payment_link)}" target="_blank" rel="noopener" class="text-brand-accent hover:underline truncate max-w-[14rem]">${esc(o.payment_link)}</a>
                <button id="pay-copy" class="btn-secondary text-xs px-3 min-h-[40px]">Copiar</button>
                <a class="btn-whatsapp text-xs px-3 min-h-[40px] flex items-center" target="_blank" rel="noopener"
                   href="https://wa.me/${digitsOf(o.phone)}?text=${encodeURIComponent(PRICING[L].payment_link.replace('{link}', o.payment_link))}">Enviar por WhatsApp</a>
              </div>` : ''}`;
        return `
          <div class="card p-4 sm:p-5 mt-4">
            <h3 class="font-display font-bold text-th-heading mb-3">Pagos</h3>
            ${statusBanner}
            ${methodRow}
            ${senalHint}
            ${onlineBlock}
            <div class="flex flex-wrap items-center gap-2 ${pref === 'cash' ? '' : 'pt-3 border-t border-th-border/10'} text-sm">
              <span class="text-th-muted">${pref === 'cash' ? 'Registrar cobro en efectivo:' : 'Pago en mano:'}</span>
              <input id="pay-amount" type="number" inputmode="decimal" value="${rest > 0 ? rest : ''}" min="0" step="0.01" class="adm-input w-28 inline-block" />€
              <select id="pay-method" class="adm-input w-auto inline-block">
                <option value="efectivo">efectivo</option>
                <option value="bizum personal">Bizum personal</option>
                <option value="otro">otro</option>
              </select>
              <button id="pay-manual" class="btn-secondary text-sm px-4">Registrar</button>
            </div>
          </div>`;
      }

      function bindPayments() {
        const say = (msg, ok) => {
          const el = $('pay-status');
          if (!el) return;
          el.textContent = msg;
          el.className = 'text-sm mb-3 ' + (ok ? 'text-green-400' : 'text-red-400');
        };
        $('d-paypref')?.addEventListener('change', async () => {
          const d = await api('/api/orders/' + current.id, { method: 'PATCH', body: JSON.stringify({ payment_pref: $('d-paypref').value || null }) });
          if (d.ok) { toast('Método de pago guardado ✓'); openDetail(current.id, false); }
          else toast('Error al guardar el método', false);
        });
        document.querySelectorAll('[data-pay]').forEach((el) =>
          el.addEventListener('click', () => busy(el, async () => {
            const d = await api('/api/stripe/create-link', {
              method: 'POST',
              body: JSON.stringify({ order_id: current.id, kind: el.dataset.pay }),
            });
            if (d.ok) { toast('Enlace creado: ' + d.amount_eur + '€'); openDetail(current.id); }
            else say('Stripe: ' + (d.reason || '') + (d.detail ? ' — ' + d.detail : ''), false);
          }, 'Creando…')));
        $('pay-copy')?.addEventListener('click', () => {
          navigator.clipboard.writeText(current.payment_link || '');
          toast('Enlace copiado');
        });
        $('pay-manual')?.addEventListener('click', () => busy($('pay-manual'), async () => {
          const amount = Number($('pay-amount').value);
          if (!(amount > 0)) { say('Importe inválido', false); return; }
          const newPaid = Math.round(((Number(current.paid_eur) || 0) + amount) * 100) / 100;
          // Cover the full amount owed (quote + on-site add-ons), matching the
          // Pagos banner and the server-side Stripe total — not quote alone.
          const covered = newPaid >= orderTotal(current) - 0.01;
          const body = {
            paid_eur: newPaid,
            paid_at: new Date().toISOString(),
            event_note: 'pago manual (' + $('pay-method').value + '): ' + amount + '€',
          };
          if (covered && (TRANSITIONS[current.status] || []).includes('paid')) body.status = 'paid';
          const d = await api('/api/orders/' + current.id, { method: 'PATCH', body: JSON.stringify(body) });
          if (d.ok) { toast('Pago registrado ✓'); openDetail(current.id); }
          else say('Error: ' + (d.reason || ''), false);
        }));
      }

      // ── Detail ────────────────────────────────────────────────────────────
      function lockScroll(on) { document.body.style.overflow = on ? 'hidden' : ''; }

      async function openDetail(id, pushHistory = true) {
        const d = await api('/api/orders/' + id);
        if (!d.ok) { toast('Pedido no encontrado', false); return; }
        current = d.order;
        current._events = d.events || [];
        if (!q) q = quoteState(current);
        renderDetail();
        if ($('detail').classList.contains('hidden')) {
          $('detail').classList.remove('hidden');
          lockScroll(true);
          if (pushHistory) history.pushState({ admOrder: id }, '');
        }
        $('detail').scrollTop = 0;
      }
      function closeDetail(fromPop) {
        $('detail').classList.add('hidden');
        lockScroll(false);
        q = null; current = null;
        loadOrders(true);
        if (!fromPop && history.state?.admOrder) history.back();
      }
      window.addEventListener('popstate', () => {
        if (!$('detail').classList.contains('hidden')) closeDetail(true);
        else ['modal-new', 'modal-partner'].forEach((m) => $(m).classList.add('hidden'));
      });
      function refreshDetail() { if (current) renderDetail(); }

      function photoStrip(o) {
        const groups = ['intake', 'before', 'after']
          .map((k) => ({ k, keys: (o.photos || []).filter((key) => key.includes('/' + k + '/')) }))
          .filter((g) => g.keys.length);
        if (!groups.length) return '';
        if (o.status === 'qc') {
          // QC: the decision screen — bigger 2-up tiles.
          return `<div class="card p-4 mt-4 space-y-3">${groups.map((g) => `
            <div><p class="text-[11px] font-medium uppercase tracking-[0.08em] text-th-faint mb-1.5">${g.k}</p>
              <div class="grid grid-cols-2 gap-2">${g.keys.map((k) =>
                `<a href="/api/photo/${k}" target="_blank"><img src="/api/photo/${k}" loading="lazy" class="rounded-lg w-full aspect-[4/3] object-cover border border-th-border/10" /></a>`).join('')}
              </div></div>`).join('')}</div>`;
        }
        return `<div class="card p-3 mt-4">
          <div class="flex gap-2 overflow-x-auto">${groups.flatMap((g) => g.keys).map((k) =>
            `<a href="/api/photo/${k}" target="_blank" class="shrink-0"><img src="/api/photo/${k}" loading="lazy" class="rounded-lg h-20 w-24 object-cover border border-th-border/10" /></a>`).join('')}
          </div></div>`;
      }

      function historyHtml() {
        // Newest first on a timeline rail — the accent dot marks the latest event.
        const events = [...current._events].reverse();
        return `
          <div class="card p-4 sm:p-5 mt-4 mb-16">
            <h3 class="font-display font-bold text-th-heading mb-3">Historial</h3>
            <ol class="adm-timeline text-xs">
              ${events.map((e) => {
                const label = EVENT_ES[e.type] || e.type;
                let extra = '';
                if (e.type === 'status_changed' && e.data?.status) extra = `${STATUS_ES[e.data.status.from] || e.data.status.from} → <b>${STATUS_ES[e.data.status.to] || e.data.status.to}</b>`;
                else if (e.data?.amount_eur) extra = e.data.amount_eur + '€';
                else if (e.data?.note) extra = esc(e.data.note);
                else if (e.data?.partner_notes) extra = esc(e.data.partner_notes);
                else if (e.data?.kind) extra = esc(e.data.kind);
                return `<li>
                  <span class="block text-th-faint tabular-nums">${fmtDate(e.ts)}</span>
                  <span class="text-th-body font-medium">${label}</span>${extra ? ` <span class="text-th-muted">· ${extra}</span>` : ''}
                  ${e.data && !extra ? `<details class="inline"><summary class="inline cursor-pointer text-th-faint"> …</summary><span class="text-th-faint">${esc(JSON.stringify(e.data))}</span></details>` : ''}
                </li>`;
              }).join('')}
            </ol>
          </div>`;
      }

      // Repeat clients get the same hands: continuity is free retention.
      function prevPartnerHint(o) {
        const d = digitsOf(o.phone);
        if (!d) return '';
        const prev = orders
          .filter((x) => x.id !== o.id && x.partner_id && digitsOf(x.phone) === d &&
            !['cancelled'].includes(x.status))
          .sort((a, b) => (a.created_at < b.created_at ? 1 : -1))[0];
        const pp = prev ? partners.find((x) => x.id === prev.partner_id) : null;
        return pp && pp.id !== o.partner_id
          ? `<p class="text-xs text-brand-gold mb-1.5">↻ Cliente repetido — la otra vez lo atendió <b>${esc(pp.name)}</b>. Mismo partner = confianza.</p>`
          : '';
      }

      // Who marked the order's scheduled day free in their calendar.
      function availHint(o) {
        if (!o.scheduled_at) return '';
        const day = o.scheduled_at.slice(0, 10);
        const free = partners.filter((x) => x.active && availOn(x, day)).map((x) => x.name);
        return free.length
          ? `<p class="text-xs text-brand-whatsapp mb-1.5">Libres ese día: ${esc(free.join(', '))}</p>`
          : '<p class="text-xs text-th-faint mb-1.5">Ningún partner ha marcado libre ese día.</p>';
      }

      function actionsHtml(o) {
        const p = partners.find((x) => x.id === o.partner_id);
        const activeP = partners.filter((x) => x.active);
        const match = (x) =>
          (!o.service_slug || !x.skills?.length || x.skills.includes(o.service_slug)) &&
          (!o.area_slug || !x.zones?.length || x.zones.includes(o.area_slug));
        // 'assigned' is reached ONLY through the gated partner dropdown
        // (#d-assign sets partner_id + RC/address/date gate + status). A generic
        // status button would flip to 'assigned' with no partner — a broken state.
        const trans = (TRANSITIONS[o.status] || []).filter((s) => s !== 'cancelled' && s !== 'assigned');
        const primary = trans[0];
        return `
          <div class="card p-4 sm:p-5 mt-4">
            ${o.status === 'qc' ? `
            <div class="rounded-xl border border-brand-gold/30 bg-brand-gold/5 p-3 mb-4">
              <p class="text-sm font-semibold text-brand-gold mb-2">Control de calidad</p>
              <button id="qc-approve" class="btn-primary w-full min-h-[48px] text-sm mb-2">✓ Aprobar → cobrar</button>
              <div class="flex gap-2">
                <input id="qc-note" type="text" placeholder="nota de rework para el partner" class="adm-input flex-1" />
                <button id="qc-rework" class="btn-secondary text-sm px-4 text-red-400/80 hover:text-red-400">↩ Rework</button>
              </div>
            </div>` : `
            ${primary && o.status !== 'new' ? `<button data-st="${primary}" class="btn-primary w-full min-h-[48px] text-sm mb-2">${ACTION_ES[primary] || '→ ' + STATUS_ES[primary]}</button>` : ''}
            ${trans.slice(o.status === 'new' ? 0 : 1).map((s) =>
              o.status === 'new' && s === 'quoted' ? '' :
              `<button data-st="${s}" class="btn-secondary w-full min-h-[44px] text-sm mb-2">${ACTION_ES[s] || '→ ' + STATUS_ES[s]}</button>`).join('')}
            `}
            ${['assigned', 'in_progress', 'qc'].includes(o.status) && o.partner_id ? `
              <button id="d-partner-msg" class="btn-secondary w-full min-h-[44px] text-sm mb-2">📤 Mensaje para partner <span class="text-th-faint">(nuevo enlace)</span></button>` : ''}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2">
              <div>
                <label class="text-xs text-th-faint block mb-1">Partner ${p ? '(actual: ' + esc(p.name) + ')' : ''}</label>
                ${availHint(o)}
                ${prevPartnerHint(o)}
                <div class="flex gap-2">
                  <select id="d-partner" class="adm-input">
                    <option value="">—</option>
                    ${activeP.map((x) => { const day = o.scheduled_at ? o.scheduled_at.slice(0, 10) : null; return `<option value="${esc(x.id)}" ${x.id === o.partner_id ? 'selected' : ''}>${esc(x.name)}${day ? (availOn(x, day) ? ' ✓ libre ese día' : ' · sin marcar ese día') : ''}${match(x) ? '' : ' ⚠ fuera de skill/zona'}${rcExpired(x) ? ' ⛔ póliza vencida' : ''}</option>`; }).join('')}
                  </select>
                  <button id="d-assign" class="btn-secondary text-sm px-3">${o.status === 'booked' ? 'Asignar' : 'Guardar'}</button>
                </div>
              </div>
              <div>
                <label class="text-xs text-th-faint block mb-1">Agendar</label>
                <div class="flex gap-2">
                  <input id="d-sched" type="datetime-local" value="${o.scheduled_at ? o.scheduled_at.slice(0, 16) : ''}" class="adm-input" />
                  <button id="d-sched-save" class="btn-secondary text-sm px-3">Guardar</button>
                </div>
                ${o.status === 'booked' && !o.scheduled_at ? '<p class="text-xs text-brand-gold mt-1">Sin fecha el pedido no sale en la vista de hoy.</p>' : ''}
              </div>
            </div>
            <label class="text-xs text-th-faint block mt-3 mb-1">Idioma del cliente <span class="text-th-faint">(los mensajes automáticos salen en este idioma)</span></label>
            <select id="d-lang" class="adm-input">
              <option value="es" ${(o.lang || 'es') === 'es' ? 'selected' : ''}>Español</option>
              <option value="en" ${o.lang === 'en' ? 'selected' : ''}>English</option>
              <option value="ca" ${o.lang === 'ca' ? 'selected' : ''}>Català</option>
            </select>
            <label class="text-xs text-th-faint block mt-3 mb-1">Dirección (día de trabajo)</label>
            <div class="flex gap-2">
              <input id="d-addr" type="text" maxlength="300" value="${esc(o.address || '')}" placeholder="calle y número, población" class="adm-input flex-1" />
              <button id="d-addr-save" class="btn-secondary text-sm px-3">Guardar</button>
            </div>
            ${o.status === 'booked' && !o.address ? '<p class="text-xs text-brand-gold mt-1">Sin dirección no se puede asignar — pídela al confirmar la reserva.</p>' : ''}
            <label class="text-xs text-th-faint block mt-3 mb-1">Notas</label>
            <div class="flex gap-2">
              <textarea id="d-notes" rows="2" class="adm-input">${esc(o.notes || '')}</textarea>
              <button id="d-notes-save" class="btn-secondary text-sm px-3 self-start">Guardar</button>
            </div>
            ${(TRANSITIONS[o.status] || []).includes('cancelled') ? `
              <div class="mt-4 pt-3 border-t border-th-border/10 text-center">
                <button data-st="cancelled" class="text-sm text-red-400/80 hover:text-red-400 min-h-[44px]">Cancelar pedido</button>
              </div>` : ''}
            ${o.status === 'cancelled' ? `
              <div class="mt-4 pt-3 border-t border-th-border/10 text-center">
                <button id="d-delete" class="text-sm text-red-400/80 hover:text-red-400 min-h-[44px]">🗑 Eliminar definitivamente (solo test)</button>
              </div>` : ''}
          </div>`;
      }

      // ── Lifecycle messages (copy-buttons per status) ──────────────────────
      // Templates live in wa_messages.lc_* ×3 langs; placeholders are filled
      // from the order and any line left with an unfilled {placeholder} is
      // dropped whole — messages stay self-sufficient, never blanks.
      function lcMessage(o, key) {
        const L = PRICING[o.lang] ? o.lang : 'es';
        const T = PRICING[L].lifecycle[key] || PRICING.es.lifecycle[key] || '';
        const partner = partners.find((x) => x.id === o.partner_id);
        const t0 = o.scheduled_at ? new Date(o.scheduled_at) : null;
        const locale = L === 'en' ? 'en-GB' : L === 'ca' ? 'ca-ES' : 'es-ES';
        const hm = (d) => d.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' });
        const vals = {
          name: o.client_name ? ' ' + o.client_name.split(' ')[0] : '',
          service: o.service_slug ? svcName(o.service_slug) : null,
          date: t0 ? t0.toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' }) : null,
          window: t0 ? `${hm(t0)}–${hm(new Date(t0.getTime() + 36e5))}` : null,
          time: t0 ? hm(t0) : null,
          address: o.address || null,
          total: o.quote_eur != null ? o.quote_eur : null,
          deposit: o.paid_eur ? o.paid_eur : null,
          partner: partner ? partner.name.split(' ')[0] : null,
          url: `${SITE_URL}/${L}/cases`,
          review_url: localStorage.getItem('rl_review_url') || null,
        };
        return T.split('\n').map((line) => {
          let out = line;
          for (const [k, v] of Object.entries(vals)) {
            if (v !== null) out = out.split(`{${k}}`).join(v);
          }
          return out;
        }).filter((line) => !/\{[a-z0-9_]+\}/.test(line)).join('\n').trim();
      }

      const LC_BUTTONS = {
        quoted: [['lc_followup_1', 'Seguimiento +24h'], ['lc_followup_2', 'Seguimiento +3 días'], ['lc_followup_3', 'Cierre suave +7 días']],
        booked: [['lc_booking_confirmation', 'Confirmación de reserva'], ['lc_reminder_24h', 'Recordatorio T-24h'], ['lc_on_my_way', 'En camino']],
        assigned: [['lc_booking_confirmation', 'Confirmación de reserva'], ['lc_reminder_24h', 'Recordatorio T-24h'], ['lc_on_my_way_partner', 'En camino (partner)']],
        in_progress: [['lc_work_started', 'Empezamos + fotos']],
        awaiting_payment: [['lc_work_done', 'Terminado + fotos']],
        paid: [['lc_review_request', 'Pedir reseña'], ['lc_checkin_48h', 'Check-in 48h']],
        done: [['lc_review_request', 'Pedir reseña'], ['lc_checkin_48h', 'Check-in 48h']],
      };
      function messagesHtml(o) {
        const defs = LC_BUTTONS[o.status];
        if (!defs) return '';
        return `
          <div class="card p-4 sm:p-5 mt-4">
            <h3 class="font-display font-bold text-th-heading mb-1">Mensajes al cliente</h3>
            <p class="text-xs text-th-faint mb-3">Se abren en WhatsApp ya escritos — revisa y envía.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              ${defs.map(([k, label]) => `<button data-lc="${k}" class="btn-secondary text-sm min-h-[44px]">💬 ${label}</button>`).join('')}
            </div>
          </div>`;
      }

      function headerHtml(o) {
        const digits = digitsOf(o.phone);
        const attr = o.attr || {};
        const refToken = localStorage.getItem('rl_ref_token');
        return `
          <div class="card p-4 sm:p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
              <h2 class="font-display font-bold text-th-heading text-xl">${esc(o.client_name || o.phone || o.code)} <span class="adm-badge align-middle ${o.lang !== 'es' ? 'bg-brand-accent/20 text-brand-accent' : 'text-th-faint'}">${(o.lang || 'es').toUpperCase()}</span></h2>
              <span class="text-th-faint text-xs">${esc(o.code)} · ${fmtDate(o.created_at)}</span>
            </div>
            <p class="text-sm text-th-body/85">${esc([svcName(o.service_slug), o.size ? sizeName(o.size) : '', AREAS[o.area_slug]?.name || ''].filter(Boolean).join(' · ') || '—')}</p>
            <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm mt-2">
              ${digits ? `<a class="text-brand-accent min-h-[44px] flex items-center" href="tel:+${digits}">📞 Llamar</a>
              <a class="text-brand-whatsapp min-h-[44px] flex items-center" target="_blank" href="https://wa.me/${digits}">💬 WhatsApp</a>` : ''}
              ${o.quote_eur ? `<span class="min-h-[44px] flex items-center"><span class="text-th-faint mr-1">Presupuesto:</span><b class="text-brand-accent">${o.quote_eur}€</b></span>` : ''}
              ${addonsTotal(o) > 0 ? `<span class="min-h-[44px] flex items-center"><span class="text-th-faint mr-1">Extras:</span><b class="text-brand-whatsapp">+${addonsTotal(o)}€</b></span><span class="min-h-[44px] flex items-center"><span class="text-th-faint mr-1">Total:</span><b class="text-th-heading">${orderTotal(o)}€</b></span>` : ''}
              ${o.paid_eur ? `<span class="min-h-[44px] flex items-center"><span class="text-th-faint mr-1">Pagado:</span><b class="text-green-400">${o.paid_eur}€</b></span>` : ''}
              ${o.scheduled_at ? `<span class="min-h-[44px] flex items-center text-th-muted">📅 ${fmtDate(o.scheduled_at)}</span>` : ''}
              ${o.address ? `<span class="min-h-[44px] flex items-center text-th-muted">📍 ${esc(o.address)}</span>` : ''}
              ${o.rework ? `<span class="min-h-[44px] flex items-center text-th-muted">Reworks: ${o.rework}</span>` : ''}
              ${o.status === 'assigned' ? `<span class="min-h-[44px] flex items-center ${o.accepted_at ? 'text-green-400' : 'text-brand-gold'}">${o.accepted_at ? '✔ partner aceptó' : '⏳ partner sin aceptar'}</span>` : ''}
            </div>
            ${o.ref_code || attr.first ? `
            <div class="mt-2 pt-2 border-t border-th-border/10 text-xs text-th-faint">
              ${o.ref_code ? `ref <b>${esc(o.ref_code)}</b> · ` : ''}fuente: ${esc(attr.first?.utm_source || '(directo)')}
              ${attr.first?.utm_campaign ? ` · ${esc(attr.first.utm_campaign)}` : ''}
              ${o.ref_code && refToken ? ` · <a class="text-brand-accent" target="_blank" href="/api/ref?code=${esc(o.ref_code)}&token=${encodeURIComponent(refToken)}">historial</a>` : ''}
            </div>` : ''}
          </div>`;
      }

      function extraWorkBanner() {
        const extras = current._events.filter((e) => e.type === 'partner_suggested_extra');
        if (!extras.length) return '';
        return extras.map((e) => `
          <div class="rounded-xl border border-brand-gold/40 bg-brand-gold/10 p-3 mt-4">
            <p class="text-sm font-semibold text-brand-gold mb-1">🔧 El partner propone trabajo adicional</p>
            <p class="text-sm text-th-body">${esc(e.data?.text || '')}</p>
            <p class="text-xs text-th-faint mt-1">${fmtDate(e.ts)} · llama al cliente, re-presupuesta y añádelo si acepta.</p>
          </div>`).join('');
      }

      function declineBanner() {
        // A partner declined and nobody's been re-assigned since.
        if (current.partner_id) return '';
        const decs = current._events.filter((e) => e.type === 'partner_declined');
        if (!decs.length) return '';
        const last = decs[decs.length - 1];
        return `<div class="rounded-xl border border-red-400/40 bg-red-400/10 p-3 mt-4 text-sm text-red-300">✗ ${esc(last.data?.partner_name || 'El partner')} rechazó el trabajo (${fmtDate(last.ts)}). Reasígnalo a otro partner.</div>`;
      }

      function waFailBanner() {
        const fails = current._events.filter((e) => e.type === 'wa_send_failed');
        const oks = current._events.filter((e) => e.type === 'wa_sent');
        const lastFail = fails[fails.length - 1];
        const lastOk = oks[oks.length - 1];
        return lastFail && (!lastOk || lastFail.ts > lastOk.ts)
          ? `<div class="rounded-xl border border-red-400/40 bg-red-400/10 p-3 mt-4 text-sm text-red-300">
               ⚠ Envío automático de WhatsApp falló (${esc(lastFail.data?.template || '')}) — envío manual necesario.
             </div>`
          : '';
      }

      function renderDetail() {
        const o = current;
        $('d-status-chip').className = 'adm-status';
        $('d-status-chip').textContent = STATUS_ES[o.status];
        $('d-status-chip').style.color = STATUS_TONE[o.status].tx;

        const showComposer = ['new', 'quoted', 'booked'].includes(o.status);
        // Status-aware block order: what Mike needs next comes first.
        const blocks = [headerHtml(o), declineBanner(), extraWorkBanner(), waFailBanner()];
        if (o.status === 'qc') {
          blocks.push(photoStrip(o), actionsHtml(o), o.quote_eur ? paymentHtml(o) : '');
        } else if (['awaiting_payment', 'paid'].includes(o.status)) {
          blocks.push(o.quote_eur ? paymentHtml(o) : '', messagesHtml(o), actionsHtml(o), photoStrip(o));
        } else if (['booked', 'assigned', 'in_progress'].includes(o.status)) {
          // booked shows Pagos alongside the composer: the senal moment is HERE.
          blocks.push(messagesHtml(o), actionsHtml(o), showComposer ? composerHtml(o) : '', o.quote_eur && (!showComposer || o.status === 'booked') ? paymentHtml(o) : '', photoStrip(o));
        } else { // new, quoted, done, cancelled
          blocks.push(photoStrip(o), showComposer ? composerHtml(o) : '', messagesHtml(o), actionsHtml(o), o.quote_eur && !showComposer ? paymentHtml(o) : '');
        }
        blocks.push(historyHtml());
        $('detail-body').innerHTML = blocks.filter(Boolean).join('');

        document.querySelectorAll('[data-lc]').forEach((el) =>
          el.addEventListener('click', () => {
            const msg = lcMessage(current, el.getAttribute('data-lc'));
            const digits = digitsOf(current.phone);
            if (digits) window.open('https://wa.me/' + digits + '?text=' + encodeURIComponent(msg), '_blank');
            else { navigator.clipboard.writeText(msg); toast('Sin teléfono — mensaje copiado'); }
          }));
        document.querySelectorAll('[data-st]').forEach((el) =>
          el.addEventListener('click', () => busy(el, async () => {
            const to = el.getAttribute('data-st');
            if (to === 'cancelled' && !confirm('¿Cancelar el pedido ' + current.code + '?')) return;
            const d = await api('/api/orders/' + current.id, { method: 'PATCH', body: JSON.stringify({ status: to }) });
            if (!d.ok) { toast('No se puede pasar a ese estado', false); return; }
            toast(STATUS_ES[to] + ' ✓');
            await openDetail(current.id, false);
            if (to === 'booked') {
              const s = $('d-sched');
              if (s && !current.scheduled_at) { s.focus(); s.style.outline = '2px solid var(--brand-gold)'; }
            }
          })));
        $('d-delete')?.addEventListener('click', () => busy($('d-delete'), async () => {
          if (!confirm('¿Eliminar DEFINITIVAMENTE el pedido ' + current.code + ' y sus fotos? Solo para datos de prueba.')) return;
          const d = await api('/api/orders/' + current.id, { method: 'DELETE' });
          if (d.ok) { toast('Pedido eliminado'); closeDetail(); }
          else toast('Error: ' + (d.reason || ''), false);
        }));
        $('d-assign')?.addEventListener('click', () => busy($('d-assign'), async () => {
          const body = { partner_id: $('d-partner').value || null };
          const chosen = partners.find((x) => x.id === $('d-partner').value);
          if (chosen && rcExpired(chosen)) {
            toast('Póliza RC de ' + chosen.name.split(' ')[0] + ' vencida — renueva antes de asignar', false);
            return;
          }
          if ($('d-partner').value && current.status === 'booked') {
            // A mobile job without address+date is undispatchable — hard gate.
            const missing = !current.address ? 'd-addr' : !current.scheduled_at ? 'd-sched' : null;
            if (missing) {
              toast(missing === 'd-addr' ? 'Falta la dirección — el partner necesita saber dónde ir' : 'Falta la fecha — agenda antes de asignar', false);
              const f = $(missing);
              if (f) { f.focus(); f.style.outline = '2px solid var(--brand-gold)'; }
              return;
            }
            body.status = 'assigned';
          }
          const d = await api('/api/orders/' + current.id, { method: 'PATCH', body: JSON.stringify(body) });
          if (d.ok) { toast('Partner guardado ✓'); openDetail(current.id, false); }
          else toast('Error: ' + (d.reason || ''), false);
        }));
        $('d-lang')?.addEventListener('change', async () => {
          const d = await api('/api/orders/' + current.id, { method: 'PATCH', body: JSON.stringify({ lang: $('d-lang').value }) });
          if (d.ok) { toast('Idioma: ' + $('d-lang').value.toUpperCase() + ' ✓'); openDetail(current.id, false); }
          else toast('Error al cambiar el idioma', false);
        });
        $('d-addr-save')?.addEventListener('click', () => busy($('d-addr-save'), async () => {
          const d = await api('/api/orders/' + current.id, { method: 'PATCH', body: JSON.stringify({ address: $('d-addr').value.trim() || null }) });
          if (d.ok) { toast('Dirección guardada ✓'); openDetail(current.id, false); }
          else toast('Error al guardar la dirección', false);
        }));
        $('d-sched-save')?.addEventListener('click', () => busy($('d-sched-save'), async () => {
          const v = $('d-sched').value;
          const d = await api('/api/orders/' + current.id, { method: 'PATCH', body: JSON.stringify({ scheduled_at: v ? new Date(v).toISOString() : null }) });
          if (d.ok) { toast('Fecha guardada ✓'); openDetail(current.id, false); }
          else toast('Error al guardar la fecha', false);
        }));
        $('d-notes-save')?.addEventListener('click', () => busy($('d-notes-save'), async () => {
          const d = await api('/api/orders/' + current.id, { method: 'PATCH', body: JSON.stringify({ notes: $('d-notes').value }) });
          if (d.ok) toast('Notas guardadas ✓');
          else toast('Error al guardar las notas', false);
        }));
        $('qc-approve')?.addEventListener('click', () => busy($('qc-approve'), async () => {
          const d = await api('/api/orders/' + current.id, { method: 'PATCH', body: JSON.stringify({ status: 'awaiting_payment' }) });
          if (d.ok) { toast('QC aprobado ✓'); openDetail(current.id, false); }
          else toast('Error: ' + (d.reason || ''), false);
        }));
        $('qc-rework')?.addEventListener('click', () => busy($('qc-rework'), async () => {
          const note = $('qc-note').value.trim();
          const d = await api('/api/orders/' + current.id, {
            method: 'PATCH',
            body: JSON.stringify({ status: 'in_progress', ...(note ? { event_note: 'rework: ' + note } : {}) }),
          });
          if (d.ok) { toast('Rework solicitado'); openDetail(current.id, false); }
          else toast('Error: ' + (d.reason || ''), false);
        }));
        $('d-partner-msg')?.addEventListener('click', () => busy($('d-partner-msg'), async () => {
          const d = await api('/api/orders/' + current.id + '/job-token', { method: 'POST' });
          if (!d.ok) { toast('Error: ' + (d.reason || ''), false); return; }
          const pt = partners.find((x) => x.id === current.partner_id);
          const payoutPct = current.payout_pct || pt?.payout_pct || 70;
          const base = current.quote_eur ? current.quote_eur * payoutPct / 100 : 0;
          const payoutN = Math.round((base + addonsTotal(current) * ADDON_PCT / 100) * 100) / 100;
          const payout = payoutN > 0 ? payoutN : null;
          const msg = 'Hola' + (pt ? ' ' + pt.name.split(' ')[0] : '') + ', trabajo ' + current.code + ':\n' +
            '• ' + svcName(current.service_slug) + (current.size ? ' (' + sizeName(current.size) + ')' : '') + '\n' +
            (AREAS[current.area_slug]?.name ? '• Zona: ' + AREAS[current.area_slug].name + '\n' : '') +
            '• Cuándo: ' + (current.scheduled_at ? fmtDate(current.scheduled_at) : 'por confirmar') + '\n' +
            (payout ? '• Tu pago: ' + payout + '€ (' + payoutPct + '%)\n' : '') +
            '\n¿Lo tomas? Confirma con el botón «Acepto» de la ficha — si no te encaja, dímelo y lo reasigno sin problema.\n' +
            'Ficha completa, checklist y fotos aquí:\n' + location.origin + d.url;
          const digits = digitsOf(pt?.phone);
          if (digits) window.open('https://wa.me/' + digits + '?text=' + encodeURIComponent(msg), '_blank');
          else { navigator.clipboard.writeText(msg); toast('Partner sin teléfono — mensaje copiado'); }
        }, 'Generando…'));
        if (showComposer) bindComposer(o);
        if (o.quote_eur) bindPayments();
      }

      // Back button: guard an unsaved quote.
      $('d-back').addEventListener('click', () => {
        if (q && current && ['new'].includes(current.status) && quoteTotal(current) > 0 && !current.quote_eur) {
          if (!confirm('El presupuesto no está guardado. ¿Salir igualmente?')) return;
        }
        closeDetail();
      });

      // ── Modals ────────────────────────────────────────────────────────────
      function openModal(id) {
        $(id).classList.remove('hidden');
        lockScroll(true);
        history.pushState({ admModal: id }, '');
        if (id === 'modal-new') setTimeout(() => $('n-phone').focus(), 50);
      }
      document.querySelectorAll('[data-close]').forEach((el) =>
        el.addEventListener('click', () => {
          el.closest('.fixed').classList.add('hidden');
          lockScroll(false);
          if (history.state?.admModal) history.back();
        }));

      $('btn-new').addEventListener('click', () => openModal('modal-new'));
      $('btn-partner').addEventListener('click', () => openModal('modal-partner'));
      // Render a generated link with a Copy button. clipboard.writeText() after
      // an await loses the user gesture on Safari (silent failure), so copying
      // happens on the button's OWN click, with a readonly field to select
      // manually and an execCommand fallback.
      let linkResultN = 0;
      function showLinkResult(title, note, link, waText) {
        const wa = 'https://wa.me/?text=' + encodeURIComponent(waText);
        const cid = 'lr' + (linkResultN++);
        $('pt-body').insertAdjacentHTML('afterbegin', `
          <div class="card p-4 border border-brand-accent/40">
            <p class="text-sm text-th-heading font-semibold mb-1">${title}</p>
            ${note ? `<p class="text-xs text-th-faint mb-2">${note}</p>` : ''}
            <div class="flex flex-wrap gap-2 items-center mb-2">
              <input id="${cid}" readonly value="${esc(link)}" class="adm-input flex-1 min-w-0 text-xs" />
              <button id="${cid}-c" class="btn-secondary text-sm px-4 min-h-[44px]">Copiar</button>
            </div>
            <a href="${wa}" target="_blank" rel="noopener" class="btn-whatsapp text-sm px-4 inline-flex min-h-[44px]">Enviar por WhatsApp</a>
          </div>`);
        const inp = $(cid);
        inp.addEventListener('focus', () => inp.select());
        $(cid + '-c').addEventListener('click', async () => {
          inp.focus(); inp.select(); try { inp.setSelectionRange(0, 99999); } catch (e) {}
          let ok = false;
          try { await navigator.clipboard.writeText(link); ok = true; } catch (e) {}
          if (!ok) { try { ok = document.execCommand('copy'); } catch (e) {} }
          toast(ok ? 'Enlace copiado ✓' : 'Selecciónalo y cópialo a mano', ok);
        });
      }

      $('btn-invite').addEventListener('click', () => busy($('btn-invite'), async () => {
        const d = await api('/api/partners/invite', { method: 'POST' });
        if (!d.ok) { toast('Error: ' + (d.reason || ''), false); return; }
        const link = location.origin + d.url;
        showLinkResult('Enlace de registro generado', '', link, 'Hola, para colaborar con restoreLab rellena tu registro aquí: ' + link);
        loadPartners();
      }, 'Generando…'));
      $('btn-refresh').addEventListener('click', () => { loadPartners(); loadOrders(); });

      $('n-size').innerHTML = '<option value="">Tamaño…</option>' +
        Object.entries(PRICING.es.sizes).map(([id, n]) => `<option value="${id}">${esc(n)}</option>`).join('');
      $('n-area').innerHTML = '<option value="">Zona…</option>' +
        Object.entries(AREAS).map(([slug, a]) => `<option value="${slug}">${esc(a.name)}</option>`).join('');

      // Combine the country-code selector + local digits into +<dial><local>.
      function phoneVal(id) {
        const local = $(id).value.replace(/\D/g, '');
        return local ? '+' + $(id + '-cc').value + local : '';
      }
      $('n-save').addEventListener('click', () => busy($('n-save'), async () => {
        $('n-error').classList.add('hidden');
        const d = await api('/api/orders', {
          method: 'POST',
          body: JSON.stringify({
            phone: phoneVal('n-phone'),
            client_name: $('n-name').value.trim(),
            service_slug: $('n-service').value || undefined,
            size: $('n-size').value || undefined,
            area_slug: $('n-area').value || undefined,
            channel: $('n-channel').value,
            lang: $('n-lang').value,
            ref: $('n-ref').value.trim().toUpperCase() || undefined,
            notes: $('n-notes').value.trim() || undefined,
            website: '',
          }),
        });
        if (!d.ok) {
          $('n-error').textContent = d.reason === 'bad_phone' ? 'Revisa el teléfono' : 'Error: ' + (d.reason || '');
          $('n-error').classList.remove('hidden');
          return;
        }
        $('modal-new').classList.add('hidden');
        lockScroll(false);
        if (history.state?.admModal) history.back();
        ['n-phone', 'n-name', 'n-notes', 'n-service', 'n-size', 'n-area', 'n-ref'].forEach((id) => { $(id).value = ''; });
        $('n-phone-cc').value = '34';
        $('n-channel').value = 'whatsapp';
        $('n-lang').value = 'es';
        toast('Pedido ' + d.code + ' creado ✓');
        await loadOrders(true);
        openDetail(d.id);
      }, 'Creando…'));

      $('p-save').addEventListener('click', () => busy($('p-save'), async () => {
        $('p-error').classList.add('hidden');
        const csv = (v) => v.split(',').map((s) => s.trim()).filter(Boolean);
        const d = await api('/api/partners', {
          method: 'POST',
          body: JSON.stringify({
            name: $('p-name').value.trim(),
            phone: phoneVal('p-phone'),
            nif: $('p-nif').value.trim() || undefined,
            email: $('p-email').value.trim() || undefined,
            rc_expiry: $('p-rc').value || undefined,
            zones: csv($('p-zones').value),
            skills: csv($('p-skills').value),
            payout_pct: Number($('p-payout').value) || 70,
          }),
        });
        if (!d.ok) {
          $('p-error').textContent = 'Error: ' + (d.reason || '');
          $('p-error').classList.remove('hidden');
          return;
        }
        $('modal-partner').classList.add('hidden');
        lockScroll(false);
        if (history.state?.admModal) history.back();
        ['p-name', 'p-phone', 'p-nif', 'p-email', 'p-rc', 'p-zones', 'p-skills'].forEach((id) => { $(id).value = ''; });
        $('p-phone-cc').value = '34';
        toast('Partner creado ✓');
        loadPartners();
        loadPartnersTab();
      }, 'Creando…'));

      // ── Métricas (RL-460) ─────────────────────────────────────────────────
      let M = null;

      const badge = (value, limit, higherIsBad, unit) => {
        if (value == null) return '<span class="text-th-faint">—</span>';
        const bad = higherIsBad ? value > limit : value < limit;
        const color = bad ? '#F87171' : '#4ADE80';
        return `<span class="font-bold" style="color:${color}">${value}${unit}</span>
          <span class="text-th-faint text-xs">límite ${higherIsBad ? '≤' : '≥'}${limit}${unit}</span>`;
      };
      const bar = (n, max) =>
        `<span class="inline-block h-2 rounded bg-brand-accent/60 align-middle shrink-0" style="width:${max ? Math.max(4, Math.round((n / max) * 72)) : 4}px"></span>`;
      function metricCard(title, html) {
        return `<div class="card p-4"><p class="text-[11px] font-medium uppercase tracking-[0.08em] text-th-faint mb-1.5">${title}</p><div class="text-th-body text-sm">${html}</div></div>`;
      }
      function breakdownRows(obj, labelFn) {
        const entries = Object.entries(obj).sort((a, b) => b[1] - a[1]);
        const max = entries[0]?.[1] || 0;
        return entries.map(([k, v]) =>
          `<div class="flex items-center gap-2 py-0.5"><span class="flex-1 min-w-0 truncate text-th-muted">${esc(labelFn ? labelFn(k) : k)}</span>${bar(v, max)}<span class="text-th-heading font-medium shrink-0 tabular-nums">${v}</span></div>`).join('') || '<span class="text-th-faint">—</span>';
      }

      async function loadMetrics() {
        const month = $('m-month').value || new Date().toISOString().slice(0, 7);
        let d;
        try {
          d = await api('/api/metrics?month=' + month);
        } catch (e) {
          $('m-body').innerHTML = `<p class="text-red-400 text-sm">${esc(e.message)}</p>`;
          return;
        }
        if (!d.ok) {
          $('m-body').innerHTML = `<p class="text-brand-gold text-sm">API no configurada (${esc(d.reason || '')}).</p>`;
          return;
        }
        M = d;
        const T = d.thresholds;
        const f = d.funnel;
        const spendRows = Object.entries(d.cac.spend);
        if (!spendRows.length) spendRows.push(['google', '']);

        $('m-body').innerHTML = `
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            ${metricCard('Pedidos', `<b class="font-display font-bold text-2xl tabular-nums tracking-tight text-th-heading">${f.created}</b> creados<br/>${f.quoted} presupuestados · ${f.booked} reservados · ${f.done} cerrados`)}
            ${metricCard('Presupuesto → Reserva', badge(f.quote_to_booked_pct, T.quote_to_booked_pct, false, '%'))}
            ${metricCard('Tiempo hasta presupuesto', d.time_to_quote_median_h == null ? '—' : `<b class="font-display font-bold text-2xl tabular-nums tracking-tight text-th-heading">${d.time_to_quote_median_h}h</b> mediana`)}
            ${metricCard('Ingresos cobrados', `<b class="font-display font-bold text-2xl tabular-nums tracking-tight text-th-heading">${d.revenue.paid_total}€</b><br/>${d.revenue.paid_orders} pagos · ticket medio ${d.revenue.avg_ticket ?? '—'}€`)}
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            ${metricCard('Contribución estimada', `<b class="font-display font-bold text-2xl tabular-nums tracking-tight text-th-heading">${d.revenue.contribution_total}€</b> total · ${d.revenue.contribution_avg ?? '—'}€/pedido
              <p class="text-th-faint text-xs mt-1">pagado − payout partner − 1,5% Stripe − 4% reserva</p>`)}
            ${metricCard('CAC blended', `${badge(d.cac.blended, T.cac_eur, true, '€')}
              <span class="text-th-faint text-xs">· gasto ${d.cac.spend_total}€ / ${f.booked} reservas</span>`)}
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            ${metricCard('Por canal', breakdownRows(f.by_channel))}
            ${metricCard('Por servicio', breakdownRows(f.by_service, (k) => svcName(k) || k))}
          </div>

          <div class="card p-4">
            <p class="text-[11px] font-medium uppercase tracking-[0.08em] text-th-faint mb-2">Partners</p>
            ${d.partners.length === 0 ? '<p class="text-th-faint text-sm">Sin trabajos de partner este mes.</p>' : `
            <div class="adm-tw"><table class="w-full text-sm tabular-nums">
              <thead><tr class="text-left text-th-faint border-b border-th-border/10">
                <th class="py-1.5">Partner</th><th>Trabajos</th><th>Rework</th><th>Media en curso</th></tr></thead>
              <tbody>${d.partners.map((p) => `
                <tr class="border-b border-th-border/5">
                  <td class="py-1.5 text-th-heading">${esc(p.name)}</td>
                  <td>${p.jobs}</td>
                  <td>${badge(p.rework_pct, T.rework_pct, true, '%')}</td>
                  <td>${p.avg_in_progress_h == null ? '—' : p.avg_in_progress_h + 'h'}</td>
                </tr>`).join('')}
              </tbody>
            </table></div>`}
          </div>

          <div class="card p-4">
            <p class="text-[11px] font-medium uppercase tracking-[0.08em] text-th-faint mb-2">CAC por fuente · gasto del mes</p>
            <div id="m-spend-rows" class="space-y-2 mb-2">
              ${spendRows.map(([src, val]) => `
                <div class="flex flex-wrap gap-2 items-center" data-spend-row>
                  <input type="text" value="${esc(src)}" placeholder="fuente (google, meta…)" class="adm-input flex-1 min-w-[8rem]" data-spend-src />
                  <input type="number" inputmode="numeric" value="${esc(val)}" min="0" step="1" placeholder="€" class="adm-input w-24 min-w-0" data-spend-amt />€
                </div>`).join('')}
            </div>
            <div class="flex gap-2 mb-4">
              <button id="m-spend-add" class="text-sm text-brand-accent min-h-[44px]">+ fuente</button>
              <button id="m-spend-save" class="btn-secondary text-sm px-4 min-h-[44px]">Guardar gasto</button>
            </div>
            <div class="adm-tw"><table class="w-full text-sm tabular-nums">
              <thead><tr class="text-left text-th-faint border-b border-th-border/10">
                <th class="py-1.5">Fuente</th><th>Creados</th><th>Reservados</th><th>CAC</th></tr></thead>
              <tbody>${Object.keys({ ...d.cac.created_by_source, ...d.cac.by_source }).map((src) => `
                <tr class="border-b border-th-border/5">
                  <td class="py-1.5 text-th-heading">${esc(src)}</td>
                  <td>${d.cac.created_by_source[src] || 0}</td>
                  <td>${d.cac.booked_by_source[src] || 0}</td>
                  <td>${d.cac.by_source[src] != null ? badge(d.cac.by_source[src], T.cac_eur, true, '€') : '<span class="text-th-faint">—</span>'}</td>
                </tr>`).join('')}
              </tbody>
            </table></div>
          </div>`;

        $('m-spend-add').addEventListener('click', () => {
          const div = document.createElement('div');
          div.className = 'flex flex-wrap gap-2 items-center';
          div.setAttribute('data-spend-row', '');
          div.innerHTML = '<input type="text" placeholder="fuente" class="adm-input flex-1 min-w-[8rem]" data-spend-src />' +
            '<input type="number" inputmode="numeric" min="0" step="1" placeholder="€" class="adm-input w-24 min-w-0" data-spend-amt />€';
          $('m-spend-rows').appendChild(div);
        });
        $('m-spend-save').addEventListener('click', () => busy($('m-spend-save'), async () => {
          const value = {};
          document.querySelectorAll('[data-spend-row]').forEach((row) => {
            const src = row.querySelector('[data-spend-src]').value.trim();
            const amt = Number(row.querySelector('[data-spend-amt]').value);
            if (src && amt > 0) value[src] = amt;
          });
          const d2 = await api('/api/settings', {
            method: 'PUT',
            body: JSON.stringify({ key: 'ad_spend:' + (M?.month || ''), value }),
          });
          if (d2.ok) { toast('Gasto guardado ✓'); loadMetrics(); } else toast('Error: ' + (d2.reason || ''), false);
        }));
      }

      function exportCsv() {
        if (!M) return;
        const cols = ['code', 'created_at', 'status', 'channel', 'lang', 'service_slug', 'size',
          'client_name', 'phone', 'area_slug', 'quote_eur', 'paid_eur', 'paid_at',
          'partner_id', 'ref_code', 'rework', 'scheduled_at'];
        const cell = (v) => {
          const s = v == null ? '' : String(v);
          return /[",\n;]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
        };
        const csv = [cols.join(';')]
          .concat(M.orders.map((o) => cols.map((c) => cell(o[c])).join(';')))
          .join('\n');
        const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'restorelab-pedidos-' + M.month + '.csv';
        a.click();
        URL.revokeObjectURL(a.href);
      }

      // ── Partners tab (RL-430) ─────────────────────────────────────────────
      let PT = null;

      const PT_STATUS = {
        invited: ['Invitado · sin rellenar', 'text-th-faint'],
        pending: ['Pendiente de revisión', 'bg-brand-gold/20 text-brand-gold'],
        active: ['Activo', 'bg-green-500/15 text-green-400'],
        paused: ['Pausado', 'bg-th-surface/10 text-th-muted'],
      };
      const DOC_LABEL = { work: 'Trabajos', kit: 'Vídeo equipo', dni: 'DNI/NIE', reta: 'Alta autónomo', rc: 'Póliza RC' };
      function partnerStatusRow(p) {
        const st = p.status || 'active';
        const [label, cls] = PT_STATUS[st] || PT_STATUS.active;
        // Registration review — only meaningful before activation.
        let review = '';
        if (st === 'pending') {
          const pr = p.profile || {};
          const docs = p.docs || [];
          const docChip = (d) => /^image\//.test(d.ct || '')
            ? `<a href="/api/photo/${d.key}" target="_blank"><img src="/api/photo/${d.key}" class="w-14 h-14 object-cover rounded-lg border border-th-border/10" /></a>`
            : `<a href="/api/photo/${d.key}" target="_blank" class="text-brand-accent text-xs underline">${DOC_LABEL[d.kind] || d.kind} ↗</a>`;
          const facts = [
            pr.years ? 'Experiencia: ' + esc(pr.years) : '',
            pr.alta_autonomo ? 'Alta autónomo: sí' : 'Alta autónomo: no',
            pr.agreement_accepted_at ? 'Condiciones aceptadas ✓' : 'Condiciones sin aceptar',
            pr.availability ? 'Disponibilidad: ' + esc(pr.availability) : '',
            pr.products ? 'Productos: ' + esc(pr.products) : '',
            pr.portfolio_url ? `Portfolio: <a href="${esc(pr.portfolio_url)}" target="_blank" class="text-brand-accent underline">${esc(pr.portfolio_url)}</a>` : '',
          ].filter(Boolean);
          review = `
            <div class="rounded-lg bg-th-surface/[0.04] border border-th-border/10 p-2.5 mb-2 text-xs text-th-body space-y-1">
              ${facts.map((f) => `<p>${f}</p>`).join('')}
              ${docs.length ? `<div class="flex flex-wrap gap-2 items-center pt-1">${docs.map(docChip).join('')}</div>` : '<p class="text-th-faint">Sin documentos subidos.</p>'}
              <button data-activate="${esc(p.id)}" class="btn-primary text-xs px-4 py-2 mt-1">✓ Activar partner</button>
            </div>`;
        }
        return `<div class="flex items-center gap-2 mb-2"><span class="adm-badge ${cls}">${label}</span>${p.registered_at ? `<span class="text-[11px] text-th-faint">registrado ${fmtDate(p.registered_at)}</span>` : ''}</div>${review}`;
      }

      async function loadPartnersTab() {
        if ($('view-partners').classList.contains('hidden')) return;
        const month = $('pt-month').value || new Date().toISOString().slice(0, 7);
        await loadPartners();
        let d;
        try {
          d = await api('/api/metrics?month=' + month);
        } catch (e) {
          $('pt-body').innerHTML = `<p class="text-red-400 text-sm">${esc(e.message)}</p>`;
          return;
        }
        if (!d.ok) {
          $('pt-body').innerHTML = `<p class="text-brand-gold text-sm">API no configurada (${esc(d.reason || '')}).</p>`;
          return;
        }
        PT = d;
        const ledger = d.partners;
        $('pt-body').innerHTML = `
          <div class="card p-4">
            <p class="text-[11px] font-medium uppercase tracking-[0.08em] text-th-faint mb-2">Liquidación · ${esc(d.month)} <span class="normal-case">(trabajos aceptados)</span></p>
            ${ledger.length === 0 ? '<p class="text-th-faint text-sm">Sin trabajos de partner este mes.</p>' : `
            <div class="adm-tw"><table class="w-full text-sm tabular-nums">
              <thead><tr class="text-left text-th-faint border-b border-th-border/10">
                <th class="py-1.5">Partner</th><th>Trabajos</th><th>Aceptados</th><th>GMV</th><th>%</th><th>Payout</th><th>Reworks</th></tr></thead>
              <tbody>${ledger.map((p) => `
                <tr class="border-b border-th-border/5">
                  <td class="py-1.5 text-th-heading">${esc(p.name)}</td>
                  <td>${p.jobs}</td><td>${p.accepted}</td>
                  <td>${p.gmv_eur}€</td><td>${p.payout_pct}%</td>
                  <td class="font-display font-bold tabular-nums text-brand-accent">${p.payout_eur}€</td>
                  <td>${p.rework_count}</td>
                </tr>`).join('')}
              </tbody>
            </table></div>`}
          </div>
          <div class="card p-4">
            <p class="text-[11px] font-medium uppercase tracking-[0.08em] text-th-faint mb-2">Partners</p>
            ${partners.length === 0 ? '<p class="text-th-faint text-sm">Sin partners todavía. Crea el primero con «+ Partner».</p>' : `
            <div class="space-y-3">
              ${partners.map((p) => `
                <div class="rounded-xl border ${(p.status || 'active') === 'pending' ? 'border-brand-gold/40 bg-brand-gold/5' : 'border-th-border/10'} p-3" data-pt="${esc(p.id)}">
                  ${partnerStatusRow(p)}
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-1">
                    <label class="block"><span class="adm-flabel">Nombre</span>
                      <input data-f="name" value="${esc(p.name)}" class="adm-input" /></label>
                    <label class="block"><span class="adm-flabel">Teléfono</span>
                      <input data-f="phone" type="tel" inputmode="tel" value="${esc(p.phone || '')}" placeholder="+34…" class="adm-input" /></label>
                    <label class="block"><span class="adm-flabel">Payout (%)</span>
                      <input data-f="payout_pct" type="number" inputmode="numeric" value="${p.payout_pct}" min="0" max="100" class="adm-input" /></label>
                    <label class="block"><span class="adm-flabel">Email (facturas)</span>
                      <input data-f="email" type="email" value="${esc(p.email || '')}" placeholder="jordi@…" class="adm-input" /></label>
                    <label class="block sm:col-span-2"><span class="adm-flabel">Zonas (slugs, separados por coma)</span>
                      <input data-f="zones" value="${esc((p.zones || []).join(', '))}" placeholder="sant-cugat, terrassa" class="adm-input" /></label>
                    <label class="block sm:col-span-2"><span class="adm-flabel">Servicios (slugs, separados por coma)</span>
                      <input data-f="skills" value="${esc((p.skills || []).join(', '))}" placeholder="single-stage, headlight-restoration" class="adm-input" /></label>
                    <label class="block"><span class="adm-flabel">NIF / NIE</span>
                      <input data-f="nif" value="${esc(p.nif || '')}" placeholder="X1234567L" class="adm-input" /></label>
                    <label class="block"><span class="adm-flabel">Póliza RC hasta</span>
                      <input data-f="rc_expiry" type="date" value="${esc(p.rc_expiry || '')}" class="adm-input" /></label>
                  </div>
                  <div class="flex flex-wrap items-center gap-3 mt-3">
                    <label class="flex items-center gap-2 text-sm text-th-muted min-h-[44px]">
                      <input data-f="active" type="checkbox" ${p.active ? 'checked' : ''} class="w-5 h-5 accent-brand-accent" /> Activo
                    </label>
                    ${rcExpired(p) ? '<span class="adm-badge bg-red-500/15 text-red-400">póliza vencida — no asignable</span>' : ''}
                    ${!p.rc_expiry ? '<span class="text-xs text-brand-gold">sin póliza RC registrada</span>' : ''}
                    <button data-pt-link="${esc(p.id)}" class="btn-secondary text-sm px-4 min-h-[44px] ml-auto" title="Generar un enlace nuevo del panel (el anterior deja de servir)">🔗 Enlace del panel</button>
                    <button data-pt-save="${esc(p.id)}" class="btn-secondary text-sm px-4 min-h-[44px]">Guardar</button>
                  </div>
                </div>`).join('')}
            </div>`}
          </div>`;
        document.querySelectorAll('[data-pt-save]').forEach((btn) =>
          btn.addEventListener('click', () => busy(btn, async () => {
            const box = document.querySelector(`[data-pt="${btn.dataset.ptSave}"]`);
            const get = (f) => box.querySelector(`[data-f="${f}"]`);
            const csv = (v) => v.split(',').map((s) => s.trim()).filter(Boolean);
            const d2 = await api('/api/partners/' + btn.dataset.ptSave, {
              method: 'PATCH',
              body: JSON.stringify({
                name: get('name').value.trim(),
                phone: get('phone').value.trim(),
                nif: get('nif').value.trim() || null,
                email: get('email').value.trim() || null,
                rc_expiry: get('rc_expiry').value || null,
                payout_pct: Number(get('payout_pct').value),
                active: get('active').checked,
                zones: csv(get('zones').value),
                skills: csv(get('skills').value),
              }),
            });
            if (d2.ok) { toast('Partner guardado ✓'); loadPartnersTab(); }
            else toast('Error: ' + (d2.reason || ''), false);
          })));
        // Re-issue the partner's cabinet magic link (they lost it). The raw
        // token isn't stored, so this rotates it — the old link stops working.
        document.querySelectorAll('[data-pt-link]').forEach((btn) =>
          btn.addEventListener('click', () => busy(btn, async () => {
            const d2 = await api('/api/partners/invite', { method: 'POST', body: JSON.stringify({ id: btn.dataset.ptLink }) });
            if (!d2.ok) { toast('Error: ' + (d2.reason || ''), false); return; }
            const link = location.origin + d2.url;
            showLinkResult('Nuevo enlace del panel', 'El enlace anterior ya no funciona.', link, 'Aquí tienes tu panel de restoreLab: ' + link);
          }, 'Generando…')));
        document.querySelectorAll('[data-activate]').forEach((btn) =>
          btn.addEventListener('click', () => busy(btn, async () => {
            const d2 = await api('/api/partners/' + btn.dataset.activate, { method: 'PATCH', body: JSON.stringify({ status: 'active' }) });
            if (d2.ok) { toast('Partner activado ✓'); loadPartners(); loadPartnersTab(); }
            else toast('Error: ' + (d2.reason || ''), false);
          })));
      }

      function exportLedgerCsv() {
        if (!PT) return;
        const cols = ['name', 'jobs', 'accepted', 'gmv_eur', 'payout_pct', 'payout_eur', 'rework_count'];
        const csv = ['partner;trabajos;aceptados;gmv_eur;payout_pct;payout_eur;reworks']
          .concat(PT.partners.map((p) => cols.map((c) => p[c]).join(';')))
          .join('\n');
        const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'restorelab-partners-' + PT.month + '.csv';
        a.click();
        URL.revokeObjectURL(a.href);
      }

      // ── Tabs + init ───────────────────────────────────────────────────────
      function showTab(which) {
        const views = { pipeline: 'view-pipeline', metrics: 'view-metrics', partners: 'view-partners' };
        for (const [k, id] of Object.entries(views)) {
          $(id).classList.toggle('hidden', k !== which);
          $('tab-' + k).className = 'flex-1 text-center py-2.5 min-h-[44px] transition-colors duration-150 ' +
            (k === which ? 'bg-brand-accent/15 text-brand-accent' : 'text-th-muted');
        }
        $('btn-new').classList.toggle('hidden', which !== 'pipeline');
        if (which === 'metrics') {
          if (!$('m-month').value) $('m-month').value = new Date().toISOString().slice(0, 7);
          loadMetrics();
        }
        if (which === 'partners') {
          if (!$('pt-month').value) $('pt-month').value = new Date().toISOString().slice(0, 7);
          loadPartnersTab();
        }
      }
      $('tab-pipeline').addEventListener('click', () => showTab('pipeline'));
      $('tab-metrics').addEventListener('click', () => showTab('metrics'));
      $('tab-partners').addEventListener('click', () => showTab('partners'));
      $('m-load').addEventListener('click', loadMetrics);
      $('m-csv').addEventListener('click', exportCsv);
      $('pt-load').addEventListener('click', loadPartnersTab);
      $('pt-csv').addEventListener('click', exportLedgerCsv);
      $('filters-toggle').addEventListener('click', () => $('filters').classList.toggle('hidden'));
      $('f-clear').addEventListener('click', clearFilters);

      $('f-status').innerHTML = '<option value="">Estado: todos</option>' +
        STATUSES.map((s) => `<option value="${s}">${STATUS_ES[s]}</option>`).join('');
      ['f-status', 'f-channel', 'f-partner', 'f-month'].forEach((id) =>
        $(id).addEventListener('change', () => loadOrders()));
      // Search is client-side over the already-loaded set — re-render, no reload.
      $('f-search').addEventListener('input', () => { if (!$('view-pipeline').classList.contains('hidden')) renderPipeline(); });

      // Freshness: reload when Mike returns to the tab (no polling needed at
      // this volume), and show how stale the list is.
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible' && $('detail').classList.contains('hidden') &&
            !$('view-pipeline').classList.contains('hidden')) {
          loadOrders(true);
        }
      });
      setInterval(() => {
        if (lastLoaded) {
          const m = Math.floor((Date.now() - lastLoaded) / 60000);
          $('pipeline-updated').textContent = m >= 1 ? `· actualizado hace ${m}m` : '';
        }
      }, 30000);

      // Try to load straight away: behind Cloudflare Access the CF_Authorization
      // cookie authorises the API with no token, so no prompt is shown. If the
      // API answers 401/404 (no Access session and no token) the login gate
      // appears (see api()'s handler) — the x-admin-token stays as a fallback.
      boot();
    </script>
  </body>
</html>
