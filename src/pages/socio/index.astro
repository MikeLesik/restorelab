---
// Partner registration + magic-link cabinet (RL-431). ES-only by design
// (partner surface, like /p/ and /admin), noindex, reached ONLY through the
// /socio/<token> link Mike sends. public/_redirects rewrites /socio/* here;
// the client JS reads the token from the path. The token IS the authorization
// and the persistent cabinet key — no login.
import '@/styles/global.css';
import PhoneField from '@/components/PhoneField.astro';
import { areaProfiles } from '@/lib/areaProfiles';
import { COUNTRIES } from '@/lib/countries';
import es from '@/content/es.json';

// Dial codes longest-first, so the cabinet can split a stored +<dial><local>
// number back into the selector + local input when the partner re-edits.
const DIALS = [...new Set(COUNTRIES.map((c) => c.dial))].sort((a, b) => b.length - a.length);

const ZONES = Object.entries(areaProfiles).map(([slug, a]: [string, any]) => ({ slug, name: a.name }));
const SKILLS = es.pricing.categories
  .flatMap((c: any) => c.packages)
  .map((p: any) => ({ slug: p.slug, name: p.name }));

const inputCls = 'w-full rounded-xl border border-th-border/15 bg-th-surface/[0.04] px-4 py-3 text-base text-th-heading placeholder:text-th-faint focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent';
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>restoreLab — Socios</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <!-- Installable as a standalone home-screen app (PWA). The manifest is built
         at runtime so each partner's installed icon opens THEIR own token URL. -->
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="RL Socios" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script>
      (function () {
        try {
          var m = {
            id: location.pathname,
            name: 'restoreLab · Socios',
            short_name: 'RL Socios',
            start_url: location.pathname,
            scope: '/',
            display: 'standalone',
            orientation: 'portrait',
            background_color: '#0A0A0A',
            theme_color: '#0A0A0A',
            lang: 'es',
            icons: [
              { src: '/icon-192.png', sizes: '192x192', type: 'image/png', purpose: 'any' },
              { src: '/icon-512.png', sizes: '512x512', type: 'image/png', purpose: 'any' },
              { src: '/icon-512.png', sizes: '512x512', type: 'image/png', purpose: 'maskable' }
            ]
          };
          var blob = new Blob([JSON.stringify(m)], { type: 'application/manifest+json' });
          var link = document.createElement('link');
          link.rel = 'manifest';
          link.href = URL.createObjectURL(blob);
          document.head.appendChild(link);
        } catch (e) { /* no PWA — the page still works as a normal tab */ }
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.register('/rl-app-sw.js', { updateViaCache: 'none' }).catch(function () {});
        }
      })();
    </script>
  </head>
  <body class="bg-brand-dark min-h-screen text-th-body">
    <div class="max-w-lg mx-auto px-4" style="padding-top:max(2rem,calc(env(safe-area-inset-top) + .5rem));padding-bottom:max(2rem,calc(env(safe-area-inset-bottom) + 1rem))">
      <p class="font-display font-bold text-th-heading text-xl mb-6">
        restore<span class="text-brand-accent">Lab</span>
        <span class="text-th-muted font-normal text-base">· Socios</span>
      </p>

      <div id="s-loading" class="card p-6 text-center text-th-muted text-sm">
        <span class="inline-block w-5 h-5 mr-2 align-middle rounded-full border-2 border-th-border/30 border-t-brand-accent animate-spin"></span>Cargando…
      </div>

      <div id="s-error" class="hidden card p-6 text-center">
        <p class="text-th-body">Este enlace no es válido. Si crees que es un error, escríbenos.</p>
      </div>

      <!-- ── Registration received (after submit / on return while pending) ── -->
      <div id="s-done" class="hidden card p-6 sm:p-8">
        <div class="w-14 h-14 mx-auto mb-5 rounded-2xl bg-brand-whatsapp/15 flex items-center justify-center">
          <svg class="w-7 h-7 text-brand-whatsapp" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
        </div>
        <h1 class="section-title text-2xl text-center mb-2">¡Registro recibido!</h1>
        <p class="text-th-muted text-sm text-center mb-6">Gracias, ya tenemos tus datos.</p>
        <p class="text-th-heading font-semibold text-sm mb-2">Qué pasa ahora</p>
        <ol class="space-y-2.5 mb-6">
          <li class="flex gap-3 text-sm"><span class="font-display font-bold text-brand-accent shrink-0">1</span><span class="text-th-body">Revisamos tu perfil y tus trabajos. Te escribimos por WhatsApp en menos de 48 horas.</span></li>
          <li class="flex gap-3 text-sm"><span class="font-display font-bold text-brand-accent shrink-0">2</span><span class="text-th-body">Si encajas, te proponemos un trabajo de prueba pagado al mismo porcentaje que cualquier otro.</span></li>
          <li class="flex gap-3 text-sm"><span class="font-display font-bold text-brand-accent shrink-0">3</span><span class="text-th-body">Firmamos el acuerdo de colaboración y activamos tu cuenta. A partir de ahí, este mismo enlace es tu panel.</span></li>
        </ol>
        <button id="s-edit" class="btn-secondary w-full">Añadir o cambiar algo de mi registro</button>
        <p class="text-th-faint text-xs text-center mt-3">¿Te falta subir algún documento? Puedes hacerlo desde aquí cuando quieras.</p>
      </div>

      <!-- ── Registration form (invited / pending) ── -->
      <div id="s-form" class="hidden space-y-5">

        <div>
          <h1 class="section-title text-2xl mb-1">Únete como detailer</h1>
          <p class="text-th-muted text-sm">Rellena tus datos y sube tus trabajos. Lo revisamos y te activamos.</p>
        </div>

        <div class="card p-5 space-y-4">
          <p class="text-th-heading font-semibold">Tus datos</p>
          <input id="f-name" type="text" maxlength="100" placeholder="Nombre y apellidos *" class={inputCls} />
          <div>
            <label for="f-phone" class="text-xs text-th-faint block mb-1">Teléfono (WhatsApp) *</label>
            <PhoneField id="f-phone" required placeholder="600 000 000" inputClass={inputCls} selectClass={inputCls} />
          </div>
          <input id="f-email" type="email" maxlength="100" placeholder="Email (para las facturas)" class={inputCls} />
          <input id="f-nif" type="text" maxlength="20" placeholder="NIF / NIE" class={inputCls} />
          <label class="flex items-center gap-3 text-sm text-th-body cursor-pointer">
            <input id="f-alta" type="checkbox" class="w-5 h-5 rounded border-2 border-th-border/40 accent-brand-accent shrink-0" />
            Estoy dado de alta como autónomo (RETA)
          </label>
          <div>
            <label for="f-rc" class="text-xs text-th-faint block mb-1">Póliza de RC — fecha de vencimiento</label>
            <input id="f-rc" type="date" class={inputCls} />
          </div>
        </div>

        <div class="card p-5 space-y-4">
          <p class="text-th-heading font-semibold">Tu experiencia</p>
          <input id="f-years" type="text" maxlength="20" placeholder="Años haciendo detailing" class={inputCls} />
          <textarea id="f-products" rows="2" maxlength="500" placeholder="Productos y herramientas que usas (marcas de pulido, máquina, cerámicos…)" class={inputCls}></textarea>
          <textarea id="f-availability" rows="2" maxlength="500" placeholder="Notas de disponibilidad (horas, si tienes coche propio…)" class={inputCls}></textarea>
          <input id="f-portfolio" type="url" maxlength="300" placeholder="Instagram o web con tus trabajos" class={inputCls} />
        </div>

        <div class="card p-5">
          <p class="text-th-heading font-semibold mb-1">Días que puedes trabajar</p>
          <p class="text-th-faint text-xs mb-3">Marca los días en los que estás disponible. Así te ofrecemos trabajos que encajan con tu calendario.</p>
          <div id="f-calendar"></div>
        </div>

        <div class="card p-5">
          <p class="text-th-heading font-semibold mb-1">Zonas que cubres</p>
          <div class="flex flex-wrap gap-2 mt-2">
            {ZONES.map((z) => (
              <label class="block">
                <input type="checkbox" name="f-zone" value={z.slug} class="peer sr-only" />
                <span class="inline-flex items-center rounded-full border border-th-border/15 bg-th-surface/[0.04] px-3.5 py-1.5 text-sm text-th-body cursor-pointer peer-checked:border-brand-accent peer-checked:bg-brand-accent/10 peer-checked:text-brand-accent peer-focus-visible:ring-2 peer-focus-visible:ring-brand-accent">{z.name}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="card p-5">
          <p class="text-th-heading font-semibold mb-1">Servicios que dominas</p>
          <div class="flex flex-wrap gap-2 mt-2">
            {SKILLS.map((s) => (
              <label class="block">
                <input type="checkbox" name="f-skill" value={s.slug} class="peer sr-only" />
                <span class="inline-flex items-center rounded-full border border-th-border/15 bg-th-surface/[0.04] px-3.5 py-1.5 text-sm text-th-body cursor-pointer peer-checked:border-brand-accent peer-checked:bg-brand-accent/10 peer-checked:text-brand-accent peer-focus-visible:ring-2 peer-focus-visible:ring-brand-accent">{s.name}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="card p-5 space-y-4">
          <p class="text-th-heading font-semibold">Fotos, vídeo y documentos</p>
          <div data-up="work" data-accept="image/*" data-multi="1" data-label="Fotos de tus trabajos (antes/después)"></div>
          <div data-up="kit" data-accept="video/*" data-multi="" data-label="Vídeo corto de tu equipo (máquina, pads, iluminación)"></div>
          <div data-up="dni" data-accept="image/*,application/pdf" data-multi="" data-label="DNI / NIE"></div>
          <div data-up="reta" data-accept="image/*,application/pdf" data-multi="" data-label="Alta de autónomo (RETA)"></div>
          <div data-up="rc" data-accept="image/*,application/pdf" data-multi="" data-label="Póliza de RC"></div>
        </div>

        <div class="card p-5">
          <label class="flex items-start gap-3 text-sm text-th-body cursor-pointer">
            <input id="f-agree" type="checkbox" class="mt-0.5 w-5 h-5 rounded border-2 border-th-border/40 accent-brand-accent shrink-0" />
            <span>He leído y acepto las condiciones de colaboración de restoreLab (contrato marco, estándar de calidad, protección de datos). restoreLab me pasará el documento para firmar antes del primer trabajo.</span>
          </label>
        </div>

        <p id="s-msg" class="hidden text-sm text-red-400" role="alert"></p>
        <button id="s-submit" class="btn-primary w-full">Enviar mi registro</button>
      </div>

      <!-- ── Cabinet (active) ── -->
      <div id="s-cabinet" class="hidden space-y-4">
        <div class="card p-5">
          <div class="flex items-baseline justify-between gap-2">
            <h1 id="c-name" class="font-display font-bold text-th-heading text-2xl"></h1>
            <span class="adm-badge bg-green-500/15 text-green-400">Activo</span>
          </div>
          <p class="text-sm text-th-muted mt-1">Tu porcentaje: <b id="c-pct" class="text-th-heading"></b></p>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="card p-4 text-center">
            <p id="c-payout" class="font-display font-bold text-2xl text-green-400 tabular-nums"></p>
            <p class="text-[11px] text-th-faint">tu pago este mes</p>
          </div>
          <div class="card p-4 text-center">
            <p id="c-done" class="font-display font-bold text-2xl text-th-heading tabular-nums"></p>
            <p class="text-[11px] text-th-faint">trabajos cerrados este mes</p>
          </div>
        </div>

        <div class="card p-5">
          <h2 class="font-display font-bold text-th-heading mb-2">Trabajos activos</h2>
          <div id="c-jobs" class="space-y-2"></div>
          <p class="text-xs text-th-faint mt-3">Cada trabajo te llega por WhatsApp con su enlace propio para el checklist y las fotos.</p>
        </div>

        <div id="c-notify" class="hidden card p-5">
          <h2 class="font-display font-bold text-th-heading mb-1">🔔 Avisos en el móvil</h2>
          <p class="text-th-faint text-xs mb-3">Recibe un aviso cuando te asignen un trabajo, cambie la fecha/dirección o pidan un rework. Instala la app <b>ntfy</b> (gratis) y suscríbete a tu tema:</p>
          <div class="flex gap-2 items-center mb-2">
            <input id="c-notify-topic" readonly class={`flex-1 min-w-0 text-xs ${inputCls}`} />
            <button id="c-notify-copy" type="button" class="btn-secondary text-sm px-4 min-h-[44px]">Copiar</button>
          </div>
          <a id="c-notify-open" href="#" target="_blank" rel="noopener" class="btn-whatsapp w-full text-sm">Abrir en ntfy →</a>
        </div>

        <div class="card p-5">
          <h2 class="font-display font-bold text-th-heading mb-1">Días que puedes trabajar</h2>
          <p class="text-th-faint text-xs mb-3">Mantén tu calendario al día. Te ofrecemos trabajos según los días que marques. Se guarda solo al tocar cada día.</p>
          <div id="c-calendar"></div>
          <textarea id="c-availability" rows="2" placeholder="Notas de disponibilidad (horas, coche propio…)" class={`mt-3 ${inputCls}`}></textarea>
          <button id="c-avail-save" class="btn-secondary text-sm px-4 mt-2">Guardar</button>
        </div>
      </div>

      <div id="s-paused" class="hidden card p-6 text-center">
        <p class="text-th-body">Tu cuenta está en pausa ahora mismo. Escríbenos por WhatsApp para reactivarla.</p>
      </div>
    </div>

    <input id="s-file" type="file" class="hidden" />

    <script define:vars={{ SKILL_NAMES: Object.fromEntries(SKILLS.map((s) => [s.slug, s.name])), ZONE_NAMES: Object.fromEntries(ZONES.map((z) => [z.slug, z.name])), DIALS }}>
      const $ = (id) => document.getElementById(id);
      // Split a stored +<dial><local> number into the selector + local input.
      function setPhone(fullId, full) {
        const cc = $(fullId + '-cc'), inp = $(fullId);
        const digits = String(full || '').replace(/[^\d+]/g, '');
        if (digits.startsWith('+')) {
          const rest = digits.slice(1);
          const dial = DIALS.find((d) => rest.startsWith(d));
          if (dial) { cc.value = dial; inp.value = rest.slice(dial.length); return; }
        }
        inp.value = digits.replace(/^\+/, '');
      }
      function getPhone(fullId) {
        const local = $(fullId).value.replace(/\D/g, '');
        return local ? '+' + $(fullId + '-cc').value + local : '';
      }

      // ── Availability calendar ──
      let formDates = new Set(), cabDates = new Set();
      const iso = (y, m, d) => y + '-' + String(m + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
      function buildCalendar(containerId, selected) {
        const el = $(containerId);
        const now = new Date(); now.setHours(0, 0, 0, 0);
        const todayIso = iso(now.getFullYear(), now.getMonth(), now.getDate());
        const dow = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];
        let html = '';
        for (let k = 0; k < 2; k++) {
          const m = new Date(now.getFullYear(), now.getMonth() + k, 1);
          const y = m.getFullYear(), mo = m.getMonth();
          html += `<div class="mb-4"><p class="text-sm text-th-heading font-medium mb-1 capitalize">${m.toLocaleDateString('es-ES', { month: 'long', year: 'numeric' })}</p>`;
          html += '<div class="grid grid-cols-7 gap-1 text-center">' + dow.map((d) => `<div class="text-[10px] text-th-faint pb-1">${d}</div>`).join('');
          const offset = (new Date(y, mo, 1).getDay() + 6) % 7;
          for (let i = 0; i < offset; i++) html += '<div></div>';
          const days = new Date(y, mo + 1, 0).getDate();
          for (let day = 1; day <= days; day++) {
            const di = iso(y, mo, day);
            const past = di < todayIso;
            const sel = selected.has(di);
            html += `<button type="button" data-day="${di}" ${past ? 'disabled' : ''} class="aspect-square rounded-lg text-sm ${past ? 'text-th-faint/30' : sel ? 'bg-brand-whatsapp text-white font-semibold' : 'bg-th-surface/[0.06] text-th-body'}">${day}</button>`;
          }
          html += '</div></div>';
        }
        el.innerHTML = html;
        el.querySelectorAll('[data-day]:not([disabled])').forEach((b) =>
          b.addEventListener('click', () => {
            const di = b.dataset.day;
            selected.has(di) ? selected.delete(di) : selected.add(di);
            buildCalendar(containerId, selected);
            // Cabinet calendar autosaves on every tap — the previous "green but
            // never POSTed" state was silently wiped on the next re-render.
            if (containerId === 'c-calendar') scheduleAvailSave();
          }));
      }
      let availSaveTimer = null;
      function scheduleAvailSave() {
        const b = $('c-avail-save');
        if (b) b.textContent = 'Guardando…';
        clearTimeout(availSaveTimer);
        availSaveTimer = setTimeout(() => {
          fetch('/api/socio/' + token, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: $('c-name').textContent, availability: $('c-availability').value.trim(), available_dates: [...cabDates] }),
          }).then(() => { if (b) { b.textContent = 'Guardado ✓'; setTimeout(() => { b.textContent = 'Guardar'; }, 1200); } })
            .catch(() => { if (b) b.textContent = 'Guardar'; });
        }, 500);
      }
      const token = (location.pathname.match(/^\/socio\/([a-f0-9]{32})$/) || [])[1];
      let uploadKind = null, uploadMulti = false;

      async function load() {
        if (!token) { $('s-loading').classList.add('hidden'); return $('s-error').classList.remove('hidden'); }
        let d;
        try { d = await (await fetch('/api/socio/' + token)).json(); } catch (e) { d = { ok: false }; }
        $('s-loading').classList.add('hidden');
        if (!d.ok) return $('s-error').classList.remove('hidden');
        const p = d.partner;
        if (p.status === 'active') return renderCabinet(p, d.cabinet, d.notify);
        if (p.status === 'paused') return $('s-paused').classList.remove('hidden');
        populateForm(p);
        // Already submitted → confirmation + next steps (form stays available
        // behind the "add/change" button so they can still upload docs).
        if (p.status === 'pending') $('s-done').classList.remove('hidden');
        else $('s-form').classList.remove('hidden');
      }

      $('s-edit').addEventListener('click', () => {
        $('s-done').classList.add('hidden');
        $('s-form').classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // ── Registration form ──
      function populateForm(p) {
        $('f-name').value = p.name || '';
        setPhone('f-phone', p.phone || '');
        $('f-email').value = p.email || '';
        $('f-nif').value = p.nif || '';
        $('f-rc').value = p.rc_expiry || '';
        const pr = p.profile || {};
        $('f-alta').checked = !!pr.alta_autonomo;
        $('f-years').value = pr.years || '';
        $('f-products').value = pr.products || '';
        $('f-availability').value = pr.availability || '';
        $('f-portfolio').value = pr.portfolio_url || '';
        (p.zones || []).forEach((z) => { const el = document.querySelector(`input[name="f-zone"][value="${z}"]`); if (el) el.checked = true; });
        (p.skills || []).forEach((s) => { const el = document.querySelector(`input[name="f-skill"][value="${s}"]`); if (el) el.checked = true; });
        if (pr.agreement_accepted_at) $('f-agree').checked = true;
        formDates = new Set(pr.available_dates || []);
        buildCalendar('f-calendar', formDates);
        buildUploaders(p.docs || []);
      }

      function buildUploaders(docs) {
        document.querySelectorAll('[data-up]').forEach((box) => {
          const kind = box.dataset.up;
          const have = docs.filter((x) => x.kind === kind);
          box.innerHTML = `
            <p class="text-sm text-th-body mb-1">${box.dataset.label}</p>
            <div class="flex flex-wrap items-center gap-2">
              <button type="button" data-pick="${kind}" data-accept="${box.dataset.accept}" data-multi="${box.dataset.multi}" class="btn-secondary text-xs px-3 py-2">+ Subir</button>
              <span class="text-xs text-th-muted">${have.length ? have.length + ' archivo(s) ✓' : 'sin subir'}</span>
            </div>`;
        });
        document.querySelectorAll('[data-pick]').forEach((btn) =>
          btn.addEventListener('click', () => {
            uploadKind = btn.dataset.pick; uploadMulti = btn.dataset.multi === '1';
            const f = $('s-file'); f.accept = btn.dataset.accept; f.multiple = uploadMulti; f.value = ''; f.click();
          }));
      }

      $('s-file').addEventListener('change', async function () {
        const files = [...this.files];
        if (!files.length || !uploadKind) return;
        const box = document.querySelector(`[data-pick="${uploadKind}"]`)?.closest('[data-up]');
        for (const file of files) {
          let blob = file, type = file.type;
          // Compress images (canvas → JPEG ≤2MB); videos/PDFs go raw.
          if (/^image\//.test(file.type) && file.size > 2 * 1024 * 1024) {
            try {
              const bmp = await createImageBitmap(file);
              const scale = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
              const c = document.createElement('canvas');
              c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
              c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height); bmp.close();
              const out = await new Promise((r) => c.toBlob(r, 'image/jpeg', 0.8));
              if (out) { blob = out; type = 'image/jpeg'; }
            } catch (e) {}
          }
          try {
            await fetch('/api/socio/' + token + '/upload?kind=' + uploadKind, { method: 'POST', headers: { 'Content-Type': type }, body: blob });
          } catch (e) {}
        }
        // Refresh doc counts.
        const d = await (await fetch('/api/socio/' + token)).json();
        if (d.ok) buildUploaders(d.partner.docs || []);
      });

      function showMsg(m) { $('s-msg').textContent = m; $('s-msg').classList.remove('hidden'); $('s-msg').scrollIntoView({ block: 'center', behavior: 'smooth' }); }

      $('s-submit').addEventListener('click', async () => {
        $('s-msg').classList.add('hidden');
        const name = $('f-name').value.trim(), phone = getPhone('f-phone');
        if (!name || !phone) return showMsg('Pon al menos tu nombre y tu teléfono.');
        if (!$('f-agree').checked) return showMsg('Marca la casilla de condiciones para enviar.');
        const zones = [...document.querySelectorAll('input[name="f-zone"]:checked')].map((e) => e.value);
        const skills = [...document.querySelectorAll('input[name="f-skill"]:checked')].map((e) => e.value);
        const btn = $('s-submit'); btn.disabled = true; btn.textContent = 'Enviando…';
        let d;
        try {
          d = await (await fetch('/api/socio/' + token, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name, phone, email: $('f-email').value.trim(), nif: $('f-nif').value.trim(),
              rc_expiry: $('f-rc').value || null, alta_autonomo: $('f-alta').checked,
              years: $('f-years').value.trim(), products: $('f-products').value.trim(),
              availability: $('f-availability').value.trim(), portfolio_url: $('f-portfolio').value.trim(),
              available_dates: [...formDates],
              zones, skills, agreement: true,
            }),
          })).json();
        } catch (e) { d = { ok: false }; }
        btn.disabled = false; btn.textContent = 'Enviar mi registro';
        if (!d.ok) return showMsg('No se pudo enviar. Inténtalo otra vez.');
        // Close the form and show the confirmation + next steps.
        $('s-form').classList.add('hidden');
        $('s-done').classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // ── Cabinet ──
      async function reloadCabinet() {
        try {
          const d = await (await fetch('/api/socio/' + token)).json();
          if (d.ok && d.partner.status === 'active') renderCabinet(d.partner, d.cabinet, d.notify);
        } catch (e) {}
      }
      function renderCabinet(p, cab, notify) {
        $('c-name').textContent = p.name || 'Tu cuenta';
        $('c-pct').textContent = p.payout_pct + '%';
        $('c-payout').textContent = (cab?.payout_month ?? 0) + '€';
        $('c-done').textContent = cab?.jobs_done_month ?? 0;
        // Push notifications: show the partner their personal ntfy topic.
        if (notify && notify.on && notify.topic) {
          $('c-notify-topic').value = notify.topic;
          $('c-notify-open').href = (notify.base || 'https://ntfy.sh') + '/' + notify.topic;
          $('c-notify').classList.remove('hidden');
        } else {
          $('c-notify').classList.add('hidden');
        }
        $('c-availability').value = (p.profile || {}).availability || '';
        cabDates = new Set((p.profile || {}).available_dates || []);
        buildCalendar('c-calendar', cabDates);
        const jobs = cab?.active_jobs || [];
        const JOB_ST = { booked: 'Confirmado', assigned: 'Asignado a ti', in_progress: 'En curso', qc: 'En revisión' };
        $('c-jobs').innerHTML = jobs.length ? jobs.map((j) => {
          // Offered but not yet accepted → decide first. Otherwise → work it.
          const pending = ['booked', 'assigned'].includes(j.status) && !j.accepted_at;
          // Don't call an unaccepted offer "Asignado/Confirmado" while asking to accept.
          const stLabel = pending ? 'Nuevo trabajo · por aceptar' : (JOB_ST[j.status] || '');
          const meta = [stLabel, j.client_first_name, ZONE_NAMES[j.area_slug] || '', j.scheduled_at ? new Date(j.scheduled_at).toLocaleString('es-ES', { dateStyle: 'medium', timeStyle: 'short' }) : ''].filter(Boolean).join(' · ');
          const foot = pending
            ? `<div class="flex gap-2 mt-3">
                 <button type="button" data-accept="${j.code}" class="btn-whatsapp text-sm px-4 py-3 min-h-[44px] flex-1">Aceptar</button>
                 <button type="button" data-decline="${j.code}" class="btn-secondary text-sm px-4 py-3 min-h-[44px] text-red-400/90">Rechazar</button>
               </div>
               <p class="text-[11px] text-th-faint mt-1.5">Eres libre de rechazarlo. Si no te encaja, lo reasignamos sin problema.</p>`
            : `<button type="button" data-open-job="${j.code}" class="btn-primary w-full min-h-[44px] text-sm mt-3">Abrir y trabajar (checklist y fotos) →</button>`;
          return `
            <div class="rounded-xl border border-th-border/10 p-3">
              <div class="flex items-baseline justify-between gap-2">
                <span class="font-medium text-th-heading text-sm">${SKILL_NAMES[j.service_slug] || j.service_slug || 'Servicio'}</span>
                <span class="font-display font-bold text-green-400 text-sm">${j.payout_eur}€</span>
              </div>
              <p class="text-xs text-th-muted mt-0.5">${meta}</p>
              ${foot}
            </div>`;
        }).join('') : '<p class="text-sm text-th-faint">Ahora mismo no tienes trabajos activos.</p>';
        async function respond(code, action) {
          const r = await (await fetch('/api/socio/' + token + '/respond', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code, action }),
          })).json();
          return r.ok;
        }
        document.querySelectorAll('[data-accept]').forEach((btn) =>
          btn.addEventListener('click', async () => { btn.disabled = true; if (await respond(btn.dataset.accept, 'accept')) reloadCabinet(); else btn.disabled = false; }));
        document.querySelectorAll('[data-decline]').forEach((btn) =>
          btn.addEventListener('click', async () => {
            if (!confirm('¿Seguro que quieres rechazar este trabajo? Se lo pasaremos a otro partner.')) return;
            btn.disabled = true; if (await respond(btn.dataset.decline, 'decline')) reloadCabinet(); else btn.disabled = false;
          }));
        document.querySelectorAll('[data-open-job]').forEach((btn) =>
          btn.addEventListener('click', async () => {
            btn.style.opacity = '0.6';
            try {
              const d = await (await fetch('/api/socio/' + token + '/open', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: btn.dataset.openJob }),
              })).json();
              if (d.ok) { location.href = d.url; return; }
            } catch (e) {}
            btn.style.opacity = '1';
          }));
        $('s-cabinet').classList.remove('hidden');
      }

      $('c-avail-save').addEventListener('click', async () => {
        const btn = $('c-avail-save'); btn.disabled = true;
        try {
          await fetch('/api/socio/' + token, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: $('c-name').textContent, availability: $('c-availability').value.trim(), available_dates: [...cabDates] }),
          });
          btn.textContent = 'Guardado ✓';
          setTimeout(() => { btn.textContent = 'Guardar'; btn.disabled = false; }, 1500);
        } catch (e) { btn.disabled = false; }
      });

      $('c-notify-copy').addEventListener('click', () => {
        const inp = $('c-notify-topic');
        inp.focus(); inp.select(); try { inp.setSelectionRange(0, 99999); } catch (e) {}
        navigator.clipboard.writeText(inp.value).catch(() => { try { document.execCommand('copy'); } catch (e) {} });
        $('c-notify-copy').textContent = 'Copiado ✓';
        setTimeout(() => { $('c-notify-copy').textContent = 'Copiar'; }, 1500);
      });

      load();
    </script>
  </body>
</html>
