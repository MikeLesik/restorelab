---
// Partner job card (RL-430). ES-only by design, noindex (meta + X-Robots-Tag
// via _headers /p/*), reached ONLY through /p/<token> links the admin sends —
// public/_redirects rewrites /p/* to this static shell and the client JS reads
// the token from the path. No login, no app: the token IS the authorization.
import '@/styles/global.css';
import { PARTNER_CHECKLISTS, HOUSE_RULES } from '@/lib/partnerChecklists';
import { areaProfiles } from '@/lib/areaProfiles';
import { ADDON_PARTNER_PCT } from '@/lib/unitEconomics';

import es from '@/content/es.json';

const ADDONS = (es as any).addons || [];

// Package + size display names come from the same pricing data as everywhere.
const PKG_NAMES = Object.fromEntries(
  es.pricing.categories.flatMap((c: any) => c.packages).map((p: any) => [p.slug, p.name])
);
const SIZE_NAMES = Object.fromEntries(
  (es.pricing.ui.size_categories || []).map((s: any) => [s.id, s.name])
);
const AREA_NAMES = Object.fromEntries(
  Object.entries(areaProfiles).map(([slug, a]: [string, any]) => [slug, a.name])
);
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>restoreLab — Trabajo</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <!-- Stays chrome-less when opened from the installed Socios app (the job
         card itself is per-job and ephemeral, so it is not installed on its own). -->
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="RL Trabajo" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="bg-brand-dark min-h-screen text-th-body">
    <div class="max-w-lg mx-auto px-4" style="padding-top:max(2rem,calc(env(safe-area-inset-top) + .5rem));padding-bottom:max(2rem,calc(env(safe-area-inset-bottom) + 1rem))">
      <p class="font-display font-bold text-th-heading text-xl mb-6">
        restore<span class="text-brand-accent">Lab</span> <span class="text-th-muted font-normal text-base">· Ficha de trabajo</span>
      </p>

      <div id="j-loading" class="card p-6 text-center text-th-muted text-sm">
        <span class="inline-block w-5 h-5 mr-2 align-middle rounded-full border-2 border-th-border/30 border-t-brand-accent animate-spin"></span>Cargando…
      </div>

      <div id="job-error" class="hidden card p-6 text-center">
        <p class="text-th-body">Este enlace ya no es válido. Si crees que es un error, escríbenos.</p>
      </div>

      <div id="job" class="hidden space-y-4">
        <div class="card p-5">
          <div class="flex items-baseline justify-between gap-2 mb-2">
            <h1 id="j-code" class="font-display font-bold text-th-heading text-2xl"></h1>
            <span id="j-status" class="text-xs font-semibold text-brand-accent"></span>
          </div>
          <p id="j-service" class="text-th-heading font-medium"></p>
          <p id="j-when" class="text-sm text-th-muted mt-1"></p>
          <p id="j-where" class="text-sm text-th-muted mt-1"></p>
          <a id="j-maps" href="#" target="_blank" rel="noopener" class="hidden inline-block text-sm text-brand-accent hover:underline mt-1.5">Abrir en Google Maps</a>
          <p id="j-client" class="text-sm text-th-muted mt-1"></p>
          <p id="j-payout" class="hidden text-sm font-semibold text-green-400 mt-2"></p>
          <p id="j-notes" class="hidden text-sm text-th-body border-l-2 border-brand-gold pl-3 mt-3"></p>
          <div id="j-rework" class="hidden border-l-2 border-red-400 pl-3 mt-3">
            <p class="text-sm text-red-400 font-medium">⚠ Rework solicitado — corrige y repite las fotos DESPUÉS.</p>
            <p id="j-rework-note" class="hidden text-sm text-th-body mt-1"></p>
          </div>
        </div>

        <div id="j-accept-card" class="hidden card p-5 border border-brand-whatsapp/40">
          <p class="text-sm text-th-body mb-3">¿Tomas este trabajo? Eres libre de rechazarlo sin consecuencias. Si no te encaja, avísanos y lo reasignamos.</p>
          <button id="j-accept" class="btn-whatsapp w-full">Acepto este trabajo ✓</button>
        </div>

        <div class="card p-5">
          <h2 class="font-display font-bold text-th-heading mb-3">Checklist</h2>
          <ul id="j-checklist" class="space-y-2 text-sm"></ul>
        </div>

        <div class="card p-5">
          <h2 class="font-display font-bold text-th-heading mb-1">Fotos ANTES <span class="text-th-faint font-normal text-sm">(mín. 2)</span></h2>
          <div id="j-before-grid" class="grid grid-cols-3 gap-2 my-2"></div>
          <button data-upload="before" class="btn-secondary text-sm w-full py-3 min-h-[44px]">+ Subir foto ANTES</button>
        </div>

        <div class="card p-5">
          <h2 class="font-display font-bold text-th-heading mb-1">Fotos DESPUÉS <span class="text-th-faint font-normal text-sm">(mín. 2)</span></h2>
          <div id="j-after-grid" class="grid grid-cols-3 gap-2 my-2"></div>
          <button data-upload="after" class="btn-secondary text-sm w-full py-3 min-h-[44px]">+ Subir foto DESPUÉS</button>
        </div>

        <div class="card p-5">
          <h2 class="font-display font-bold text-th-heading mb-2">Notas para restoreLab</h2>
          <textarea id="j-partner-notes" rows="3" class="w-full rounded-xl border border-th-border/15 bg-th-surface/[0.04] px-4 py-3 text-base text-th-heading" placeholder="Incidencias, espesores, lo que debamos saber…"></textarea>
        </div>

        <div class="card p-5">
          <h2 class="font-display font-bold text-th-heading mb-1">Extras para ofrecer al cliente</h2>
          <p class="text-xs text-th-muted mb-3">Ofrécelos en persona. Si el cliente dice que sí, márcalos aquí: se añaden al total y tú ganas el {ADDON_PARTNER_PCT}% de cada extra (más que en el trabajo base). Precio cerrado, no negocies.</p>
          <div id="j-addons" class="space-y-2"></div>
          <p id="j-addons-earn" class="hidden text-sm text-green-400 font-semibold mt-3"></p>
        </div>

        <div class="card p-5">
          <h2 class="font-display font-bold text-th-heading mb-1">¿Hace falta algo fuera de la lista?</h2>
          <p class="text-xs text-th-muted mb-2">Si ves que el coche necesita algo más de lo previsto, descríbelo aquí. Lo revisamos, hablamos con el cliente y lo añadimos al presupuesto. No cierres precios ni trabajos extra con el cliente directamente.</p>
          <textarea id="j-extra" rows="2" class="w-full rounded-xl border border-th-border/15 bg-th-surface/[0.04] px-4 py-3 text-base text-th-heading" placeholder="p. ej. el paragolpes trasero necesita una pasada más de pulido"></textarea>
          <button id="j-extra-send" class="btn-secondary w-full mt-2 py-2.5 text-sm">Proponer trabajo adicional</button>
          <p id="j-extra-ok" class="hidden text-sm text-brand-whatsapp mt-2">Enviado. Te diremos cómo seguir.</p>
        </div>

        <div class="card p-5">
          <h2 class="font-display font-bold text-th-heading mb-1">Cobrar al cliente</h2>
          <p id="j-pay-amount" class="text-sm text-th-muted mb-3"></p>
          <button id="j-pay-gen" class="btn-primary w-full">Generar enlace de pago</button>
          <div id="j-pay-link" class="hidden mt-3">
            <p class="text-xs text-th-muted mb-2">Muéstrale el enlace al cliente o ábrelo para que pague aquí (tarjeta o Bizum):</p>
            <a id="j-pay-open" href="#" target="_blank" rel="noopener" class="btn-whatsapp w-full mb-2">Abrir para pagar →</a>
            <button id="j-pay-copy" class="btn-secondary w-full text-sm">Copiar enlace</button>
          </div>
          <p id="j-pay-done" class="hidden text-sm text-green-400 font-semibold">✓ Ya está pagado. Nada más que cobrar.</p>
        </div>

        <div class="card p-5">
          <h2 class="font-display font-bold text-th-heading mb-2">Normas</h2>
          <ul class="space-y-1.5 text-xs text-th-muted list-disc pl-4">
            {HOUSE_RULES.map((r) => <li>{r}</li>)}
          </ul>
        </div>

        <p id="j-msg" class="hidden text-sm text-red-400" role="alert"></p>
        <button id="j-done" class="btn-primary w-full">Trabajo terminado ✓</button>
        <p class="text-th-faint text-xs text-center pb-8">Al terminar, restoreLab revisa las fotos (control de calidad) y cierra el trabajo.</p>
      </div>

      <div id="j-finished" class="hidden card p-6 text-center">
        <p class="font-display font-bold text-th-heading text-xl mb-2">¡Enviado a control de calidad!</p>
        <p class="text-th-muted text-sm mb-4">Revisaremos las fotos. Si todo está bien, no tienes que hacer nada más.</p>
        <button id="j-finished-back" class="btn-secondary w-full min-h-[44px] text-sm">← Volver a mis trabajos</button>
      </div>

      <div id="j-cobro" class="hidden card p-6">
        <h2 class="font-display font-bold text-th-heading text-xl mb-1">Cobro en sitio</h2>
        <p id="j-cobro-amount" class="text-sm text-th-muted mb-4"></p>

        <div id="j-cobro-pay" class="hidden">
          <p class="text-xs text-th-muted mb-2">Muéstrale el enlace al cliente para que pague ahora (tarjeta o Bizum). No te vayas hasta ver «Cobrado ✓».</p>
          <a id="j-cobro-open" href="#" target="_blank" rel="noopener" class="btn-whatsapp w-full mb-2">Abrir enlace de pago →</a>
          <button id="j-cobro-copy" class="btn-secondary w-full text-sm mb-3">Copiar enlace</button>
        </div>

        <button id="j-cobro-gen" class="hidden btn-primary w-full mb-3">Generar enlace de pago</button>
        <p id="j-cobro-genmsg" class="hidden text-sm text-red-400 mb-3"></p>

        <div id="j-cobro-wait" class="hidden items-center gap-2 text-sm text-th-muted mb-4">
          <span class="inline-block w-4 h-4 rounded-full border-2 border-th-border/30 border-t-brand-accent animate-spin"></span>
          Esperando el pago del cliente…
        </div>

        <div id="j-cobro-ok" class="hidden text-center mb-4">
          <p class="text-green-400 font-display font-bold text-2xl mb-1">✓ Cobrado</p>
          <p class="text-th-muted text-sm">Pago confirmado. Ya puedes irte del sitio.</p>
        </div>

        <button id="j-cobro-back" class="btn-secondary w-full min-h-[44px] text-sm">← Volver a mis trabajos</button>
      </div>
    </div>

    <input id="j-file" type="file" accept="image/*" capture="environment" class="hidden" />

    <script define:vars={{ PKG_NAMES, SIZE_NAMES, AREA_NAMES, CHECKLISTS: PARTNER_CHECKLISTS, ADDONS, ADDON_PCT: ADDON_PARTNER_PCT }}>
      const $ = (id) => document.getElementById(id);
      const token = (location.pathname.match(/^\/p\/([a-f0-9]{32})$/) || [])[1];
      let uploadKind = null;
      let JOB = null;

      async function load() {
        if (!token) { $('j-loading').classList.add('hidden'); $('job-error').classList.remove('hidden'); return; }
        let d;
        try {
          d = await (await fetch('/api/job/' + token)).json();
        } catch (e) { d = { ok: false }; }
        $('j-loading').classList.add('hidden');
        if (!d.ok) { $('job-error').classList.remove('hidden'); return; }
        const j = d.job;
        JOB = j;

        // On-site payment stage: a distinct focused screen, not the work view.
        if (j.status === 'awaiting_payment' || j.status === 'paid') { renderCobro(j); return; }

        $('j-code').textContent = j.code;
        $('j-status').textContent = j.status === 'qc' ? 'En control de calidad' : j.status === 'in_progress' ? 'En curso' : j.status === 'booked' ? 'Confirmado' : 'Asignado';
        $('j-service').textContent = (PKG_NAMES[j.service_slug] || j.service_slug || 'Servicio') +
          (j.size && SIZE_NAMES[j.size] ? ' · ' + SIZE_NAMES[j.size] : '');
        $('j-when').textContent = j.scheduled_at
          ? 'Cuándo: ' + new Date(j.scheduled_at).toLocaleString('es-ES', { dateStyle: 'full', timeStyle: 'short' })
          : 'Cuándo: por confirmar';
        const where = [AREA_NAMES[j.area_slug] || j.area_slug, j.address].filter(Boolean).join(' · ');
        $('j-where').textContent = where ? 'Dónde: ' + where : '';
        if (j.address) {
          $('j-maps').href = 'https://maps.google.com/?q=' + encodeURIComponent(j.address + ', ' + (AREA_NAMES[j.area_slug] || ''));
          $('j-maps').classList.remove('hidden');
        }
        $('j-client').textContent = j.client_first_name ? 'Cliente: ' + j.client_first_name + ' (contacto solo vía restoreLab)' : '';
        if (j.payout_eur != null) {
          $('j-payout').textContent = 'Tu pago por este trabajo: ' + j.payout_eur + '€ (' + j.payout_pct + '% del presupuesto)';
          $('j-payout').classList.remove('hidden');
        }
        if (j.notes) { $('j-notes').textContent = j.notes; $('j-notes').classList.remove('hidden'); }
        if (j.rework > 0) {
          $('j-rework').classList.remove('hidden');
          if (j.rework_note) {
            $('j-rework-note').textContent = 'Qué corregir: ' + j.rework_note;
            $('j-rework-note').classList.remove('hidden');
          }
        }
        // Offer-accept: the job is an offer until the partner takes it.
        $('j-accept-card').classList.toggle('hidden', !((j.status === 'assigned' || j.status === 'booked') && !j.accepted_at));

        const list = CHECKLISTS[j.service_slug] || CHECKLISTS.default;
        $('j-checklist').innerHTML = list.map((item, i) =>
          `<li class="flex items-start gap-2.5">
            <input id="chk${i}" type="checkbox" class="mt-0.5 w-5 h-5 rounded border-2 border-th-border/40 accent-brand-accent shrink-0" />
            <label for="chk${i}" class="text-th-body cursor-pointer">${item}</label>
          </li>`).join('');

        renderPhotos('before', j.photos_before);
        renderPhotos('after', j.photos_after);
        renderAddons(j.addons || []);
        renderPay(j);
        $('job').classList.remove('hidden');
      }

      function renderPay(j) {
        // Reset the section so add-on changes never leave a stale amount,
        // link or "cobrado" state on screen.
        $('j-pay-gen').classList.remove('hidden'); $('j-pay-gen').disabled = false;
        $('j-pay-done').classList.add('hidden');
        $('j-pay-link').classList.add('hidden');
        const out = Number(j.outstanding_eur) || 0;
        if (!(Number(j.quote_eur) > 0)) { $('j-pay-amount').textContent = 'Aún no hay presupuesto para cobrar.'; $('j-pay-gen').disabled = true; return; }
        if (out <= 0) { $('j-pay-gen').classList.add('hidden'); $('j-pay-done').classList.remove('hidden'); return; }
        const paid = Number(j.paid_eur) || 0;
        $('j-pay-amount').textContent = paid > 0
          ? `Total ${j.total_eur}€ · ya pagó ${paid}€ · falta cobrar ${out}€`
          : `El cliente paga ${out}€ (incluye extras).`;
        // If a link already exists, offer it straight away.
        if (j.payment_link) showPayLink(j.payment_link);
      }

      function showPayLink(url) {
        $('j-pay-open').href = url;
        $('j-pay-link').classList.remove('hidden');
      }

      $('j-pay-gen').addEventListener('click', async () => {
        $('j-pay-gen').disabled = true;
        const old = $('j-pay-gen').textContent; $('j-pay-gen').textContent = 'Generando…';
        try {
          const d = await (await fetch('/api/job/' + token + '/pay-link', { method: 'POST' })).json();
          if (d.ok) { showPayLink(d.url); }
          else { $('j-pay-amount').textContent = 'No se pudo generar el cobro (' + (d.reason || '') + ').'; }
        } catch (e) {}
        $('j-pay-gen').disabled = false; $('j-pay-gen').textContent = old;
      });

      $('j-pay-copy').addEventListener('click', () => {
        navigator.clipboard.writeText($('j-pay-open').href);
        $('j-pay-copy').textContent = 'Copiado ✓';
        setTimeout(() => { $('j-pay-copy').textContent = 'Copiar enlace'; }, 1500);
      });

      function renderAddons(current) {
        const has = new Set(current.map((a) => a.slug));
        // Size-dependent add-ons (ceramic coatings) price by the order's vehicle
        // size, matching the main packages; the server enforces the same on add.
        const sz = JOB && JOB.size;
        const priceOf = (a) => (a.size_pricing && a.size_pricing[sz] != null) ? a.size_pricing[sz] : a.price_eur;
        $('j-addons').innerHTML = ADDONS.map((a) => {
          const on = has.has(a.slug);
          const price = priceOf(a);
          const earn = Math.round(price * ADDON_PCT) / 100;
          return `<div class="flex items-center justify-between gap-2 rounded-lg border ${on ? 'border-brand-whatsapp/50 bg-brand-whatsapp/5' : 'border-th-border/10'} px-3 py-2">
            <div class="min-w-0">
              <p class="text-sm text-th-heading truncate">${a.name}</p>
              <p class="text-[11px] text-th-faint">${price}€ · tú ganas ${earn}€</p>
            </div>
            <button type="button" data-addon="${a.slug}" data-on="${on ? '1' : ''}" class="shrink-0 text-sm px-3.5 py-2.5 min-h-[44px] rounded-lg ${on ? 'bg-brand-whatsapp text-white' : 'border border-th-border/20 text-th-body'}">${on ? '✓ Añadido' : '+ Añadir'}</button>
          </div>`;
        }).join('');
        const total = current.reduce((s, a) => s + (Number(a.price_eur) || 0), 0);
        const earn = Math.round(total * ADDON_PCT) / 100;
        const el = $('j-addons-earn');
        if (total > 0) { el.textContent = `Extras: +${total}€ para el cliente · +${earn}€ para ti`; el.classList.remove('hidden'); }
        else el.classList.add('hidden');
        document.querySelectorAll('[data-addon]').forEach((btn) =>
          btn.addEventListener('click', async () => {
            btn.disabled = true;
            const action = btn.dataset.on ? 'remove' : 'add';
            try {
              const d = await (await fetch('/api/job/' + token + '/addon', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action, slug: btn.dataset.addon }),
              })).json();
              if (d.ok) {
                renderAddons(d.addons);
                // Keep the "Cobrar al cliente" total in sync with the new
                // add-ons so it matches what Stripe will charge. Any link
                // generated for the old amount is now stale — force a regen.
                if (JOB) {
                  JOB.addons = d.addons;
                  JOB.addons_total = Number(d.addons_total) || 0;
                  JOB.total_eur = Math.round(((Number(JOB.quote_eur) || 0) + JOB.addons_total) * 100) / 100;
                  JOB.outstanding_eur = Math.round((JOB.total_eur - (Number(JOB.paid_eur) || 0)) * 100) / 100;
                  JOB.payment_link = null;
                  renderPay(JOB);
                }
                return;
              }
            } catch (e) {}
            btn.disabled = false;
          }));
      }

      function renderPhotos(kind, keys) {
        $('j-' + kind + '-grid').innerHTML = (keys || []).map((k) =>
          `<img src="/api/photo/${k}" loading="lazy" class="rounded-lg w-full h-20 object-cover border border-th-border/10" />`).join('');
      }

      document.querySelectorAll('[data-upload]').forEach((btn) =>
        btn.addEventListener('click', () => { uploadKind = btn.dataset.upload; $('j-file').click(); }));

      $('j-file').addEventListener('change', async function () {
        const file = this.files[0];
        this.value = '';
        if (!file || !uploadKind) return;
        const btn = document.querySelector(`[data-upload="${uploadKind}"]`);
        btn.disabled = true;
        btn.textContent = 'Subiendo…';
        let blob = file, type = file.type;
        // Same compression approach as the intake form: JPEG ≤2MB via canvas,
        // raw fallback for formats the browser can't decode (HEIC off-Safari).
        if (file.size > 2 * 1024 * 1024 || !/^image\/(jpeg|png|webp)$/.test(file.type)) {
          try {
            const bmp = await createImageBitmap(file);
            const scale = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
            const canvas = document.createElement('canvas');
            canvas.width = Math.round(bmp.width * scale);
            canvas.height = Math.round(bmp.height * scale);
            canvas.getContext('2d').drawImage(bmp, 0, 0, canvas.width, canvas.height);
            bmp.close();
            const out = await new Promise((res) => canvas.toBlob(res, 'image/jpeg', 0.8));
            if (out) { blob = out; type = 'image/jpeg'; }
          } catch (e) { /* raw upload below */ }
        }
        try {
          const d = await (await fetch(`/api/orders/x/photos?kind=${uploadKind}&token=${token}`, {
            method: 'POST', headers: { 'Content-Type': type }, body: blob,
          })).json();
          if (!d.ok) throw new Error(d.reason || 'upload');
        } catch (e) {
          $('j-msg').textContent = 'No se pudo subir la foto (' + e.message + '). Inténtalo otra vez.';
          $('j-msg').classList.remove('hidden');
        }
        btn.disabled = false;
        btn.textContent = uploadKind === 'before' ? '+ Subir foto ANTES' : '+ Subir foto DESPUÉS';
        load();
      });

      $('j-accept').addEventListener('click', async () => {
        $('j-accept').disabled = true;
        try {
          const d = await (await fetch('/api/job/' + token, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'accept' }),
          })).json();
          if (d.ok) { $('j-accept-card').classList.add('hidden'); }
        } catch (e) { /* stays visible for retry */ }
        $('j-accept').disabled = false;
      });

      $('j-extra-send').addEventListener('click', async () => {
        const text = $('j-extra').value.trim();
        if (!text) return;
        $('j-extra-send').disabled = true;
        try {
          const d = await (await fetch('/api/job/' + token, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'suggest_extra', text }),
          })).json();
          if (d.ok) {
            $('j-extra').value = '';
            $('j-extra-ok').classList.remove('hidden');
          }
        } catch (e) { /* retry silently */ }
        $('j-extra-send').disabled = false;
      });

      $('j-done').addEventListener('click', async () => {
        $('j-msg').classList.add('hidden');
        $('j-done').disabled = true;
        let d;
        try {
          d = await (await fetch('/api/job/' + token, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'done', notes: $('j-partner-notes').value.trim() }),
          })).json();
        } catch (e) { d = { ok: false, reason: 'red' }; }
        $('j-done').disabled = false;
        if (!d.ok) {
          $('j-msg').textContent = d.reason === 'photos_required'
            ? `Faltan fotos: mínimo 2 ANTES y 2 DESPUÉS (tienes ${d.before}/${d.after}).`
            : 'No se pudo enviar (' + (d.reason || '') + ').';
          $('j-msg').classList.remove('hidden');
          return;
        }
        // Auto-advanced to on-site payment → go collect before leaving.
        // Otherwise (cash order / Stripe inert) it went to QC as before.
        if (d.status === 'awaiting_payment') { load(); }
        else { $('job').classList.add('hidden'); $('j-finished').classList.remove('hidden'); }
      });

      // No browser chrome in the standalone PWA — give an explicit way back to
      // the cabinet (the referrer when opened via "Abrir y trabajar").
      $('j-finished-back').addEventListener('click', () => {
        if (document.referrer && /\/socio\/[a-f0-9]{32}/.test(document.referrer)) location.href = document.referrer;
        else if (history.length > 1) history.back();
        else location.href = '/socio';
      });

      // ── On-site payment (cobro) ───────────────────────────────────────────
      // After "Trabajo terminado" the order auto-advances to awaiting_payment;
      // this screen shows the client's pay link and POLLS the job until Stripe's
      // webhook flips it to "paid", then tells the partner they can leave.
      let pollTimer = null;
      function stopPoll() { if (pollTimer) { clearInterval(pollTimer); pollTimer = null; } }
      function startPoll() {
        if (pollTimer) return;
        pollTimer = setInterval(async () => {
          try {
            const d = await (await fetch('/api/job/' + token)).json();
            if (d.ok && d.job && (d.job.status === 'paid' || Number(d.job.outstanding_eur) <= 0)) {
              JOB = d.job; renderCobro(d.job);
            }
          } catch (e) { /* keep polling */ }
        }, 6000);
      }
      function goBack() {
        stopPoll();
        if (document.referrer && /\/socio\/[a-f0-9]{32}/.test(document.referrer)) location.href = document.referrer;
        else if (history.length > 1) history.back();
        else location.href = '/socio';
      }
      function renderCobro(j) {
        $('j-loading').classList.add('hidden');
        $('job').classList.add('hidden');
        $('j-finished').classList.add('hidden');
        $('job-error').classList.add('hidden');
        $('j-cobro').classList.remove('hidden');
        const show = (id, on) => $(id).classList.toggle('hidden', !on);
        const out = Number(j.outstanding_eur) || 0;
        const paid = j.status === 'paid' || out <= 0;
        $('j-cobro-amount').textContent = paid
          ? `Total ${j.total_eur}€ — cobrado.`
          : (Number(j.paid_eur) > 0
              ? `Total ${j.total_eur}€ · pagado ${j.paid_eur}€ · falta ${out}€`
              : `El cliente paga ${out}€ (incluye extras).`);
        if (paid) {
          stopPoll();
          show('j-cobro-ok', true); show('j-cobro-wait', false);
          show('j-cobro-pay', false); show('j-cobro-gen', false); show('j-cobro-genmsg', false);
          return;
        }
        show('j-cobro-ok', false);
        $('j-cobro-wait').classList.remove('hidden'); $('j-cobro-wait').classList.add('flex');
        if (j.payment_link) {
          $('j-cobro-open').href = j.payment_link;
          show('j-cobro-pay', true); show('j-cobro-gen', false);
        } else {
          show('j-cobro-pay', false); show('j-cobro-gen', true);
        }
        startPoll();
      }
      $('j-cobro-copy').addEventListener('click', () => {
        navigator.clipboard.writeText($('j-cobro-open').href);
        $('j-cobro-copy').textContent = 'Copiado ✓';
        setTimeout(() => { $('j-cobro-copy').textContent = 'Copiar enlace'; }, 1500);
      });
      $('j-cobro-gen').addEventListener('click', async () => {
        $('j-cobro-gen').disabled = true;
        const old = $('j-cobro-gen').textContent; $('j-cobro-gen').textContent = 'Generando…';
        $('j-cobro-genmsg').classList.add('hidden');
        try {
          const d = await (await fetch('/api/job/' + token + '/pay-link', { method: 'POST' })).json();
          if (d.ok && d.url && JOB) { JOB.payment_link = d.url; renderCobro(JOB); }
          else { $('j-cobro-genmsg').textContent = 'No se pudo generar el cobro (' + (d.reason || '') + ').'; $('j-cobro-genmsg').classList.remove('hidden'); }
        } catch (e) { $('j-cobro-genmsg').textContent = 'Error de red. Inténtalo otra vez.'; $('j-cobro-genmsg').classList.remove('hidden'); }
        $('j-cobro-gen').disabled = false; $('j-cobro-gen').textContent = old;
      });
      $('j-cobro-back').addEventListener('click', goBack);

      load();
    </script>
  </body>
</html>
