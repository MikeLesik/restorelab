---
export interface Props {
  t: Record<string, any>;
  lang: string;
  categoryId?: string;
  /** Render an explicit, ordered set of packages by slug, flat and with no
   *  category heading. A service is not a pricing category, so `categoryId`
   *  could only ever select the bucket a service happens to sit in — which is
   *  how the acrylic page ended up advertising windscreen polishing, and its
   *  Service schema ended up carrying windscreen Offers. */
  only?: string[];
  /** Optional section heading. Only pages without their own <h1> covering the
   *  price table pass this — it keeps the homepage outline from skipping h1→h3. */
  title?: string;
  /** Service enrichment passed by /services/* pages so a single merged
   *  Service node is emitted here instead of a second page-level block. */
  serviceType?: string;
  serviceDescription?: string;
  serviceAreaServed?: string[];
  /** Render the vehicle-size selector that switches every card carrying
   *  size_pricing to that size's exact matrix price. Pricing page only. */
  sizeSelector?: boolean;
}

import { WHATSAPP_NUMBER, SITE_URL } from '@/lib/constants';

const { t, lang, categoryId, only, title, serviceType, serviceDescription, serviceAreaServed, sizeSelector = false } = Astro.props;
const wa = WHATSAPP_NUMBER;
const ui = t.pricing.ui || {};

// The four matrix sizes (the 5th, sports, is photo-quote only).
const matrixSizes = (ui.size_categories || []).filter((c: any) => c.id !== 'sports');

// Upsell caption: the +N€ delta is COMPUTED from price_eur / size_pricing,
// never typed into copy — the JSON carries a {diff} template (see
// docs/pricing-strategy.md). With the size selector active the delta follows
// the selected size (e.g. ceramic-1y over single-stage: 150 sedan, 180 SUV).
const allPackages = t.pricing.categories.flatMap((c: any) => c.packages);
const upsellData = (pkg: any): { text: string; note: string; diffs: Record<string, number> } | null => {
  if (!pkg.upsell_base || !pkg.upsell_note) return null;
  const base = allPackages.find((p: any) => p.slug === pkg.upsell_base);
  if (!base?.price_eur || !pkg.price_eur) throw new Error(`PricingCards: upsell_base "${pkg.upsell_base}" of "${pkg.slug}" has no price_eur`);
  const diffs: Record<string, number> = {};
  if (pkg.size_pricing && base.size_pricing) {
    for (const key of Object.keys(pkg.size_pricing)) diffs[key] = pkg.size_pricing[key] - base.size_pricing[key];
  }
  return {
    text: pkg.upsell_note.replace('{diff}', String(pkg.price_eur - base.price_eur)),
    note: pkg.upsell_note,
    diffs,
  };
};

const flat = Array.isArray(only) && only.length > 0;

// `only` selects packages across every category, in the order given, and drops
// the category heading — the page's own <h1> already names the service.
const categories = flat
  ? [{
      title: null,
      packages: (only as string[])
        .map((slug) => t.pricing.categories
          .flatMap((c: any) => c.packages)
          .find((p: any) => p.slug === slug))
        .filter(Boolean),
    }]
  : categoryId
    ? t.pricing.categories.filter((c: any) => c.id === categoryId)
    : t.pricing.categories;

// The size-multiplier table belongs to the full catalogue only.
const showMultipliers = !flat && !categoryId && ui.size_categories;

function getGridClass(count: number): string {
  if (count === 1) return 'grid-cols-1 max-w-md';
  if (count <= 3) return 'grid-cols-1 md:grid-cols-3';
  // 4 packages fit one clean row on desktop — three-up would leave one orphan.
  if (count === 4) return 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4';
  return 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3';
}
---

<section class="pt-8 pb-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    {title && <h2 class="section-title text-center mb-8">{title}</h2>}

    {t.pricing.anchor_text && (
      <div class="mb-8 p-3.5 rounded-xl bg-brand-gold/5 border border-brand-gold/20 text-center">
        <p class="text-brand-gold text-sm font-medium">{t.pricing.anchor_text}</p>
      </div>
    )}

    {/* Minimum visit + tax basis. A published floor is what stops a EUR 79
        call-out from consuming a full travel block at a loss. */}
    {ui.min_visit && (
      <p class="-mt-4 mb-8 text-center text-sm text-th-muted">{ui.min_visit}</p>
    )}

    {/* Size selector — swaps every size_pricing card to the exact matrix price */}
    {sizeSelector && matrixSizes.length > 0 && (
      <fieldset class="mb-8 text-center" id="size-selector">
        <legend class="text-th-heading font-semibold text-sm mb-3 mx-auto">{ui.size_selector_label}</legend>
        <div class="inline-flex flex-wrap justify-center gap-2">
          {matrixSizes.map((cat: any) => (
            <label class="block">
              <input type="radio" name="pricing-size" value={cat.id} checked={cat.id === 'sedan'} class="peer sr-only" />
              <span class="inline-block rounded-full border border-th-border/15 bg-th-surface/[0.04] px-4 py-2 text-sm text-th-body cursor-pointer transition-colors hover:border-brand-accent/50 peer-checked:border-brand-accent peer-checked:text-brand-accent peer-checked:bg-brand-accent/10 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-accent">
                {cat.name}
              </span>
            </label>
          ))}
        </div>
        <p class="text-th-faint text-xs mt-2">{ui.sports_note}</p>
      </fieldset>
    )}

    {categories.map((category: any) => (
        <div class="mb-8">
          {category.title && (
            <h3 class="font-display font-semibold text-th-muted mb-5 uppercase tracking-widest text-sm border-b border-th-border/10 pb-3">
              {category.title}
            </h3>
          )}

          <div class:list={['grid gap-5', getGridClass(category.packages.length)]}>
            {category.packages.map((pkg: any) => (
              <div id={pkg.slug} class:list={[
                'card relative flex flex-col transition-all duration-300',
                pkg.highlight
                  ? 'border-brand-accent/50 bg-brand-accent/5 hover:border-brand-accent'
                  : 'hover:border-th-border/20'
              ]}>
                {pkg.highlight && (
                  <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                    <span class="px-4 py-1 bg-brand-accent text-white text-xs font-bold rounded-full uppercase tracking-wider animate-pulse">
                      {ui.most_popular || 'Most Popular'}
                    </span>
                  </div>
                )}

                <div class="mb-4">
                  <h4 class="font-display font-bold text-th-heading text-lg mb-1.5">{pkg.name}</h4>
                  <div
                    class="text-2xl font-display font-bold text-brand-accent mb-0.5"
                    data-size-prices={sizeSelector && pkg.size_pricing ? JSON.stringify(pkg.size_pricing) : undefined}
                  >{pkg.price}</div>
                  <div class="text-xs text-th-faint">{pkg.duration}</div>
                </div>

                {pkg.composition && (
                  <p class="text-xs text-th-body/70 border-l-2 border-brand-accent/40 pl-2.5 mb-3">{pkg.composition}</p>
                )}
                {upsellData(pkg) && (
                  <p
                    class="text-xs text-brand-gold mb-3"
                    data-upsell={sizeSelector && Object.keys(upsellData(pkg)!.diffs).length > 0
                      ? JSON.stringify({ note: upsellData(pkg)!.note, diffs: upsellData(pkg)!.diffs })
                      : undefined}
                  >{upsellData(pkg)!.text}</p>
                )}

                <p class="text-sm text-th-muted mb-4 leading-snug">{pkg.description}</p>

                <ul class="space-y-1.5 mb-5 flex-1">
                  {pkg.includes.map((item: string) => (
                    <li class="flex items-start gap-2 text-sm text-th-body/80">
                      <svg class="w-4 h-4 text-brand-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>

                <div class="mt-auto">
                  <div class="text-xs text-th-faint/70 mb-2.5">
                    <span class="font-medium text-th-muted">{ui.best_for || 'Best for:'}</span> {pkg.best_for}
                  </div>
                  <div class="flex gap-2">
                    <a
                      href={`https://wa.me/${wa}?text=${encodeURIComponent(
                        // `only` builds a synthetic group with no title, and the
                        // categorised template interpolates it — which shipped
                        // 21 links reading 'el plan "X" (null)'. Flat mode gets
                        // a template that never mentions a category.
                        category.title
                          ? t.wa_messages.pricing_plan.replace('{plan}', pkg.name).replace('{category}', category.title)
                          : t.wa_messages.pricing_plan_flat.replace('{plan}', pkg.name)
                      )}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={[
                        'flex-1 text-center py-3 rounded-lg font-semibold text-sm transition-colors block',
                        pkg.highlight
                          ? 'bg-brand-accent hover:bg-blue-500 text-white'
                          : 'btn-plan-alt bg-th-surface/5 hover:bg-th-surface/10 text-th-heading border border-th-border/10'
                      ]}
                    >
                      {ui.get_quote || 'Get Quote'}
                    </a>
                  </div>
                  <p class="text-center text-th-faint text-[10px] mt-2 tracking-wide">{t.trust.micro_pricing}</p>
                </div>
              </div>
            ))}
          </div>

          {/* Ceramic 5Y is deliberately out of the matrix (approved 2026-09-02) —
              shown as a no-price mention next to the car packages only. */}
          {ui.ceramic_5y_note && category.packages.some((p: any) => p.slug === 'ceramic-2y') && (
            <p class="mt-4 text-center text-sm text-th-faint">{ui.ceramic_5y_note}</p>
          )}
        </div>
    ))}

    {sizeSelector && (
      <script is:inline>
        (function () {
          var priceEls = document.querySelectorAll('[data-size-prices]');
          var upsellEls = document.querySelectorAll('[data-upsell]');
          if (!priceEls.length) return;
          document.querySelectorAll('input[name="pricing-size"]').forEach(function (r) {
            r.addEventListener('change', function () {
              priceEls.forEach(function (el) {
                var prices = JSON.parse(el.getAttribute('data-size-prices'));
                if (prices[r.value] != null) el.textContent = prices[r.value] + '€';
              });
              upsellEls.forEach(function (el) {
                var u = JSON.parse(el.getAttribute('data-upsell'));
                if (u.diffs[r.value] != null) el.textContent = u.note.replace('{diff}', u.diffs[r.value]);
              });
            });
          });
        })();
      </script>
    )}

    <!-- Vehicle Size Multipliers -->
    {showMultipliers && (
      <div class="mt-6 mb-10 p-6 rounded-2xl border border-th-border/10 bg-th-surface/5">
        <h3 class="font-display font-semibold text-th-heading text-lg mb-2">{ui.size_title}</h3>
        <p class="text-sm text-th-muted mb-5">{ui.size_subtitle}</p>

        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-th-border/10">
                <th class="text-left py-2 pr-4 text-th-muted font-medium">Category</th>
                <th class="text-left py-2 pr-4 text-th-faint font-normal hidden sm:table-cell">Examples</th>
                <th class="text-right py-2 text-th-heading font-medium">Modifier</th>
              </tr>
            </thead>
            <tbody>
              {ui.size_categories.map((cat: any) => (
                <tr class="border-b border-th-border/5">
                  <td class="py-2.5 pr-4 text-th-body font-medium">{cat.name}</td>
                  <td class="py-2.5 pr-4 text-th-faint hidden sm:table-cell">{cat.examples}</td>
                  <td class:list={[
                    'py-2.5 text-right font-semibold',
                    cat.modifier === 'Baseline' || cat.modifier === 'Base' ? 'text-th-muted' : 'text-brand-accent'
                  ]}>{cat.modifier}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {ui.sensitive_paint && (
          <div class="mt-4 pt-4 border-t border-th-border/10 flex items-center justify-between text-sm">
            <div>
              <span class="text-th-body font-medium">{ui.sensitive_paint}</span>
              <span class="text-th-faint ml-2 text-xs">{ui.sensitive_paint_note}</span>
            </div>
            <span class="text-brand-accent font-semibold">{ui.sensitive_paint_surcharge}</span>
          </div>
        )}
      </div>
    )}

    <!-- Offer Schema (SEO) -->
    {categories.map((category: any) => {
      const offers = category.packages
        .filter((pkg: any) => pkg.price && !pkg.price.toLowerCase().includes('custom') && !pkg.price.toLowerCase().includes('personalizado'))
        .map((pkg: any) => {
          const priceMatch = pkg.price.replace(/\s/g, '').match(/(\d+)/);
          return priceMatch ? {
            "@type": "Offer",
            "name": pkg.name,
            "price": priceMatch[1],
            "priceCurrency": "EUR",
            "url": `${SITE_URL}/${lang}/pricing#${pkg.slug}`,
            "availability": "https://schema.org/InStock"
          } : null;
        })
        .filter(Boolean);
      // A quote-only service still deserves its Service node — it just has no
      // Offer. Emitting nothing was how the acrylic page ended up relying on a
      // neighbouring category's prices to describe itself.
      return (serviceType || offers.length > 0) ? (
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "Service",
          "name": serviceType || category.title,
          ...(serviceType ? { "serviceType": serviceType } : {}),
          ...(serviceDescription ? { "description": serviceDescription } : {}),
          ...(serviceAreaServed ? { "areaServed": serviceAreaServed } : {}),
          "provider": { "@type": "AutomotiveBusiness", "name": "restoreLab", "url": SITE_URL },
          ...(offers.length > 0 ? { "offers": offers } : {})
        })} />
      ) : null;
    })}

    <!-- Custom quote CTA -->
    <div class="text-center mt-6 p-6 border border-dashed border-th-border/15 rounded-2xl">
      <p class="text-th-muted mb-4">{t.pricing.cta_custom}</p>
      <a
        href={`https://wa.me/${wa}?text=${encodeURIComponent(categoryId && categories[0] ? t.wa_messages.pricing_custom.replace('{category}', categories[0].title) : t.wa_messages.pricing_custom_general)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-whatsapp"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <use href="#icon-whatsapp" />
        </svg>
        {t.pricing.cta_whatsapp}
      </a>
    </div>
  </div>
</section>
