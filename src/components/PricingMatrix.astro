---
// Full printable price matrix (RL-402): every package × the four matrix sizes,
// read ONLY from the structured pricing fields (price_eur / size_pricing) —
// check-pricing.mjs guarantees these match the approved matrix.
export interface Props {
  t: Record<string, any>;
}

const { t } = Astro.props;
const ui = t.pricing.ui || {};
const matrixSizes = (ui.size_categories || []).filter((c: any) => c.id !== 'sports');
const categories = t.pricing.categories || [];
---

<section id="pricing-matrix" class="py-10">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="card p-6 sm:p-8">
      <div class="flex items-start justify-between gap-4 mb-1">
        <h2 class="section-title text-2xl mb-0">{ui.matrix_title}</h2>
        <button
          id="matrix-print"
          data-event="cta_clicked"
          data-cta="pricing_matrix_print"
          class="print:hidden shrink-0 text-sm text-brand-accent hover:underline rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent"
        >
          {ui.matrix_print}
        </button>
      </div>
      <p class="text-th-muted text-sm mb-5">{ui.min_visit}</p>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-th-border/10">
              <th class="text-left py-2.5 pr-4 text-th-muted font-medium">{ui.matrix_package}</th>
              {matrixSizes.map((s: any) => (
                <th class="text-right py-2.5 pl-3 text-th-heading font-medium whitespace-nowrap">{s.name}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {categories.map((cat: any) => cat.packages.map((pkg: any) => (
              <tr class="border-b border-th-border/5">
                <td class="py-2.5 pr-4 text-th-body font-medium">{pkg.name}</td>
                {pkg.size_pricing ? (
                  matrixSizes.map((s: any) => (
                    <td class="py-2.5 pl-3 text-right text-brand-accent font-semibold whitespace-nowrap">
                      {pkg.size_pricing[s.id]}€
                    </td>
                  ))
                ) : (
                  <td colspan={matrixSizes.length} class="py-2.5 pl-3 text-right text-th-muted whitespace-nowrap">
                    {pkg.price_eur === null
                      ? ui.matrix_quote_only
                      : `${pkg.price}${pkg.price_unit === 'pair' ? '' : ` · ${ui.matrix_single}`}`}
                  </td>
                )}
              </tr>
            )))}
          </tbody>
        </table>
      </div>

      <p class="text-th-faint text-xs mt-4">{ui.sports_note}</p>
      {ui.ceramic_5y_note && <p class="text-th-faint text-xs mt-1">{ui.ceramic_5y_note}</p>}
    </div>
  </div>
</section>

<script>
  document.getElementById('matrix-print')?.addEventListener('click', () => window.print());
</script>

{/* Print isolation — same pattern as the B2B tarifa: only the matrix reaches
    paper, black on white. */}
<style is:global>
  @media print {
    body * {
      visibility: hidden;
    }
    #pricing-matrix,
    #pricing-matrix * {
      visibility: visible;
    }
    #pricing-matrix {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      padding: 0;
    }
    #pricing-matrix .card {
      border: none;
      box-shadow: none;
      background: #fff;
    }
    #pricing-matrix h2,
    #pricing-matrix p,
    #pricing-matrix th,
    #pricing-matrix td {
      color: #000 !important;
    }
  }
</style>
