# Redirect root to Spanish version (default market)
/  /es  302

# Partner job cards (RL-430): /p/<token> rewrites (200) to the static shell,
# which reads the token from the path client-side.
/p/*  /p  200

# Partner registration + cabinet (RL-431): /socio/<token> rewrites (200) to
# the static shell, which reads the token from the path client-side.
/socio/*  /socio  200

# Portugal-era URLs (business relocated Lisbon/Cascais -> Sant Cugat/Barcelona).
# Specific rules must precede the /pt/* wildcard — first match wins.
/pt/services/yacht-gelcoat  /es/services/acrylic-restoration  301
/en/services/yacht-gelcoat  /en/services/acrylic-restoration  301
/es/services/yacht-gelcoat  /es/services/acrylic-restoration  301
/ca/services/yacht-gelcoat  /ca/services/acrylic-restoration  301
/pt  /es  301
/pt/*  /es/:splat  301
